    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">CarBuilder</string>
        <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - CAR BUILDER & TARGET FRAME GENERATOR (MODULE SCRIPT)
    GÃ©nÃ¨re procÃ©duralement les 5 vÃ©hicules avec soubassement noir dÃ©taillÃ©,
    et gÃ©nÃ¨re le TargetFrame : un seul polygone fermÃ© continu en fines barres Neon vertes (0.14)
    dÃ©limitant exclusivement le contour extÃ©rieur (vide Ã  l'intÃ©rieur, aucun clone fantÃ´me, aucune ligne interne).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CarBuilder = {}

export type ContourPoint = { number } -- { X, Y, Z } en coords locales du vÃ©hicule

export type VehicleConfig = {
    Id: string,
    Index: number,
    Name: string,
    SpeedMultiplier: number,
    RewardCash: number,
    FrontZ: number,
    OuterContour: { ContourPoint }?,
    Builder: () -> Model,
}

local function createPart(name: string, size: Vector3, cf: CFrame, mat: Enum.Material, col: Color3, parent: Instance): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = cf
    p.Material = mat
    p.Color = col
    p.Anchored = false
    p.CanCollide = false
    p.Parent = parent
    return p
end

local function weldParts(part0: BasePart, part1: BasePart)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = part0
    weld.Part1 = part1
    weld.Parent = part1
end

-- Ajoute un soubassement mÃ©canique noir dÃ©taillÃ© (visible quand le nez est cabrÃ©)
local function addDetailedUndercarriage(root: BasePart, car: Model, width: number, length: number)
    local UNDER_BLACK = Color3.fromRGB(15, 16, 18)
    local METAL_GRAY = Color3.fromRGB(175, 180, 188)
    local EXHAUST_HEAT = Color3.fromRGB(120, 150, 190)

    -- Plaque de protection infÃ©rieure (Skid Plate)
    local skidPlate = createPart("SkidPlate", Vector3.new(width - 0.8, 0.25, length - 1.5), root.CFrame * CFrame.new(0, -0.9, 0), Enum.Material.DiamondPlate, UNDER_BLACK, car)
    weldParts(root, skidPlate)

    -- Carter de transmission & boÃ®te centrale
    local transmission = createPart("GearboxPan", Vector3.new(2.0, 0.4, 3.0), root.CFrame * CFrame.new(0, -0.95, -0.4), Enum.Material.Metal, METAL_GRAY, car)
    weldParts(root, transmission)

    -- Double ligne d'Ã©chappement inox
    local exhaustL = createPart("ExhaustPipe_L", Vector3.new(0.35, 0.35, length - 3.2), root.CFrame * CFrame.new(-1.2, -0.92, 0.8), Enum.Material.Metal, EXHAUST_HEAT, car)
    weldParts(root, exhaustL)
    local exhaustR = createPart("ExhaustPipe_R", Vector3.new(0.35, 0.35, length - 3.2), root.CFrame * CFrame.new(1.2, -0.92, 0.8), Enum.Material.Metal, EXHAUST_HEAT, car)
    weldParts(root, exhaustR)

    -- Embouts d'Ã©chappement chromÃ©s Ã  l'arriÃ¨re
    local tipL = Instance.new("Part")
    tipL.Name = "ExhaustTip_L"
    tipL.Shape = Enum.PartType.Cylinder
    tipL.Size = Vector3.new(0.8, 0.5, 0.5)
    tipL.CFrame = root.CFrame * CFrame.new(-1.3, -0.7, length / 2 + 0.3) * CFrame.Angles(0, math.rad(90), 0)
    tipL.Material = Enum.Material.Metal
    tipL.Color = METAL_GRAY
    tipL.Anchored = false
    tipL.CanCollide = false
    tipL.Parent = car
    weldParts(root, tipL)

    local tipR = Instance.new("Part")
    tipR.Name = "ExhaustTip_R"
    tipR.Shape = Enum.PartType.Cylinder
    tipR.Size = Vector3.new(0.8, 0.5, 0.5)
    tipR.CFrame = root.CFrame * CFrame.new(1.3, -0.7, length / 2 + 0.3) * CFrame.Angles(0, math.rad(90), 0)
    tipR.Material = Enum.Material.Metal
    tipR.Color = METAL_GRAY
    tipR.Anchored = false
    tipR.CanCollide = false
    tipR.Parent = car
    weldParts(root, tipR)

    -- Essieux de suspension avant et arriÃ¨re
    local axleFront = createPart("Suspension_F", Vector3.new(width - 0.4, 0.3, 0.8), root.CFrame * CFrame.new(0, -0.8, -length * 0.3), Enum.Material.Metal, UNDER_BLACK, car)
    weldParts(root, axleFront)
    local axleRear = createPart("Suspension_R", Vector3.new(width - 0.4, 0.3, 0.8), root.CFrame * CFrame.new(0, -0.8, length * 0.3), Enum.Material.Metal, UNDER_BLACK, car)
    weldParts(root, axleRear)
end

-- =============================================================================
-- #1 LOTUS RALLY (Rouge vif, vitesse x1.0, 50$)
-- =============================================================================
function CarBuilder.CreateLotusRally(): Model
    local car = Instance.new("Model")
    car.Name = "LotusRally"

    local root = Instance.new("Part")
    root.Name = "RootPart"
    root.Size = Vector3.new(1, 1, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = true
    root.Parent = car
    car.PrimaryPart = root

    local RED = Color3.fromRGB(230, 25, 35)
    local DARK_RED = Color3.fromRGB(180, 16, 22)
    local CHARCOAL = Color3.fromRGB(30, 32, 36)
    local BLACK_GLOSS = Color3.fromRGB(15, 18, 22)
    local RIM_GRAY = Color3.fromRGB(195, 200, 208)

    -- Carrosserie
    local base = createPart("Base", Vector3.new(6.4, 1.2, 11.6), root.CFrame * CFrame.new(0, -0.2, 0), Enum.Material.SmoothPlastic, RED, car)
    weldParts(root, base)
    local splitter = createPart("Splitter", Vector3.new(6.4, 0.35, 1.4), root.CFrame * CFrame.new(0, -0.7, -5.9), Enum.Material.SmoothPlastic, CHARCOAL, car)
    weldParts(root, splitter)
    local hood = createPart("Hood", Vector3.new(6.2, 0.65, 3.8), root.CFrame * CFrame.new(0, 0.45, -3.7) * CFrame.Angles(math.rad(-6), 0, 0), Enum.Material.SmoothPlastic, RED, car)
    weldParts(root, hood)
    local rearDeck = createPart("RearDeck", Vector3.new(6.2, 0.85, 3.2), root.CFrame * CFrame.new(0, 0.55, 3.8), Enum.Material.SmoothPlastic, RED, car)
    weldParts(root, rearDeck)

    -- Toit et vitres
    local roof = createPart("Roof", Vector3.new(4.8, 0.35, 4.6), root.CFrame * CFrame.new(0, 1.85, 0.4), Enum.Material.SmoothPlastic, DARK_RED, car)
    weldParts(root, roof)
    local windshield = createPart("Windshield", Vector3.new(4.7, 1.6, 0.25), root.CFrame * CFrame.new(0, 1.2, -1.8) * CFrame.Angles(math.rad(-32), 0, 0), Enum.Material.Glass, BLACK_GLOSS, car)
    windshield.Reflectance = 0.35
    weldParts(root, windshield)
    local rearWin = createPart("RearWin", Vector3.new(4.7, 1.5, 0.25), root.CFrame * CFrame.new(0, 1.25, 2.7) * CFrame.Angles(math.rad(28), 0, 0), Enum.Material.Glass, BLACK_GLOSS, car)
    weldParts(root, rearWin)

    -- Aileron et scoop
    local wing = createPart("RearWing", Vector3.new(6.4, 0.3, 1.8), root.CFrame * CFrame.new(0, 2.1, 5.7), Enum.Material.SmoothPlastic, CHARCOAL, car)
    weldParts(root, wing)
    local scoop = createPart("RoofScoop", Vector3.new(1.6, 0.5, 1.8), root.CFrame * CFrame.new(0, 2.15, -0.6) * CFrame.Angles(math.rad(-10), 0, 0), Enum.Material.SmoothPlastic, CHARCOAL, car)
    weldParts(root, scoop)

    -- 4 Roues droites debout (axe X, sans rotation Z) â€” flanc externe Ã  X=Â±3.05, sous carrosserie Â±3.20
    local wheelOffsets = {
        Vector3.new(-2.55, -0.95, -3.8), Vector3.new(2.55, -0.95, -3.8), -- Avant
        Vector3.new(-2.55, -0.95,  3.8), Vector3.new(2.55, -0.95,  3.8), -- ArriÃ¨re
    }
    for _, offset in ipairs(wheelOffsets) do
        local tire = Instance.new("Part")
        tire.Shape = Enum.PartType.Cylinder
        tire.Size = Vector3.new(1.0, 2.1, 2.1)
        tire.CFrame = root.CFrame * CFrame.new(offset)
        tire.Material = Enum.Material.SmoothPlastic
        tire.Color = Color3.fromRGB(20, 20, 22)
        tire.Anchored = false
        tire.CanCollide = false
        tire.Parent = car
        weldParts(root, tire)

        local rim = Instance.new("Part")
        rim.Shape = Enum.PartType.Cylinder
        rim.Size = Vector3.new(1.05, 1.3, 1.3)
        rim.CFrame = tire.CFrame
        rim.Material = Enum.Material.Metal
        rim.Color = RIM_GRAY
        rim.Anchored = false
        rim.CanCollide = false
        rim.Parent = car
        weldParts(root, rim)
    end

    -- Phares Neon
    local headL = createPart("HeadL", Vector3.new(1.3, 0.5, 0.2), root.CFrame * CFrame.new(-2.3, 0.05, -5.85), Enum.Material.Neon, Color3.fromRGB(255, 252, 225), car)
    weldParts(root, headL)
    local headR = createPart("HeadR", Vector3.new(1.3, 0.5, 0.2), root.CFrame * CFrame.new(2.3, 0.05, -5.85), Enum.Material.Neon, Color3.fromRGB(255, 252, 225), car)
    weldParts(root, headR)

    -- RÃ©troviseurs
    local mirL = createPart("MirrorL", Vector3.new(0.7, 0.35, 0.8), root.CFrame * CFrame.new(-2.7, 0.95, -1.6), Enum.Material.SmoothPlastic, CHARCOAL, car)
    weldParts(root, mirL)
    local mirR = createPart("MirrorR", Vector3.new(0.7, 0.35, 0.8), root.CFrame * CFrame.new(2.7, 0.95, -1.6), Enum.Material.SmoothPlastic, CHARCOAL, car)
    weldParts(root, mirR)

    addDetailedUndercarriage(root, car, 6.4, 11.6)
    return car
end

-- =============================================================================
-- #2 CYBER TRUCK (Pick-up futuriste acier brossÃ©, vitesse x1.35, 120$)
-- =============================================================================
function CarBuilder.CreateCyberTruck(): Model
    local car = Instance.new("Model")
    car.Name = "CyberTruck"

    local root = Instance.new("Part")
    root.Name = "RootPart"
    root.Size = Vector3.new(1, 1, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = true
    root.Parent = car
    car.PrimaryPart = root

    local STEEL = Color3.fromRGB(220, 225, 232)
    local DARK_STEEL = Color3.fromRGB(135, 140, 150)
    local CYBER_CYAN = Color3.fromRGB(0, 240, 255)
    local BLACK_ARMOR = Color3.fromRGB(22, 24, 28)

    -- ChÃ¢ssis principal profilÃ© (Largeur 6.4, Hauteur 1.2, Longueur 11.6)
    local lower = createPart("LowerArmor", Vector3.new(6.4, 1.2, 11.6), root.CFrame * CFrame.new(0, -0.2, 0), Enum.Material.Metal, STEEL, car)
    weldParts(root, lower)

    -- Toit triangulaire pyramidale emblÃ©matique
    local roofFront = createPart("RoofFrontSlope", Vector3.new(5.8, 0.45, 5.8), root.CFrame * CFrame.new(0, 1.25, -2.4) * CFrame.Angles(math.rad(-21), 0, 0), Enum.Material.Metal, STEEL, car)
    weldParts(root, roofFront)

    local roofBack = createPart("RoofBackSlope", Vector3.new(5.8, 0.45, 6.0), root.CFrame * CFrame.new(0, 1.25, 2.9) * CFrame.Angles(math.rad(19), 0, 0), Enum.Material.Metal, STEEL, car)
    weldParts(root, roofBack)

    -- CrÃªte supÃ©rieure du toit
    local roofPeak = createPart("RoofPeakBar", Vector3.new(2.8, 0.35, 1.2), root.CFrame * CFrame.new(0, 2.05, 0.2), Enum.Material.Metal, STEEL, car)
    weldParts(root, roofPeak)

    -- Pare-brise angulaire blindÃ© teintÃ©
    local glass = createPart("ArmorWindshield", Vector3.new(5.4, 1.6, 0.25), root.CFrame * CFrame.new(0, 1.2, -2.3) * CFrame.Angles(math.rad(-25), 0, 0), Enum.Material.Glass, BLACK_ARMOR, car)
    glass.Reflectance = 0.4
    weldParts(root, glass)

    -- Lightbar avant continue nÃ©on cyan (Pleine largeur 6.2 studs)
    local lightbar = createPart("FrontLightbar", Vector3.new(6.2, 0.28, 0.2), root.CFrame * CFrame.new(0, 0.45, -5.85), Enum.Material.Neon, CYBER_CYAN, car)
    weldParts(root, lightbar)

    -- Lightbar arriÃ¨re rouge
    local rearLight = createPart("RearLightbar", Vector3.new(6.2, 0.28, 0.2), root.CFrame * CFrame.new(0, 0.55, 5.85), Enum.Material.Neon, Color3.fromRGB(255, 30, 30), car)
    weldParts(root, rearLight)

    -- RÃ©troviseurs angulaires compacts
    local mirL = createPart("CyberMirrorL", Vector3.new(0.65, 0.35, 0.7), root.CFrame * CFrame.new(-3.3, 0.95, -1.8), Enum.Material.Metal, DARK_STEEL, car)
    weldParts(root, mirL)
    local mirR = createPart("CyberMirrorR", Vector3.new(0.65, 0.35, 0.7), root.CFrame * CFrame.new(3.3, 0.95, -1.8), Enum.Material.Metal, DARK_STEEL, car)
    weldParts(root, mirR)

    -- 4 Roues droites debout (axe X, sans rotation Z) â€” flanc externe Ã  X=Â±3.05, sous carrosserie Â±3.20
    local wheelOffsets = {
        Vector3.new(-2.55, -0.95, -3.8), Vector3.new(2.55, -0.95, -3.8),
        Vector3.new(-2.55, -0.95,  3.8), Vector3.new(2.55, -0.95,  3.8),
    }
    for _, offset in ipairs(wheelOffsets) do
        local tire = Instance.new("Part")
        tire.Shape = Enum.PartType.Cylinder
        tire.Size = Vector3.new(1.0, 2.1, 2.1)
        tire.CFrame = root.CFrame * CFrame.new(offset)
        tire.Material = Enum.Material.SmoothPlastic
        tire.Color = BLACK_ARMOR
        tire.Anchored = false
        tire.CanCollide = false
        tire.Parent = car
        weldParts(root, tire)

        local cap = Instance.new("Part")
        cap.Shape = Enum.PartType.Cylinder
        cap.Size = Vector3.new(1.05, 1.3, 1.3)
        cap.CFrame = tire.CFrame
        cap.Material = Enum.Material.Metal
        cap.Color = DARK_STEEL
        cap.Anchored = false
        cap.CanCollide = false
        cap.Parent = car
        weldParts(root, cap)
    end

    addDetailedUndercarriage(root, car, 6.4, 11.6)
    return car
end

-- =============================================================================
-- #3 DRIFT SUPRA (Orange nÃ©on, kit carrosserie large, vitesse x1.7, 300$)
-- =============================================================================
function CarBuilder.CreateDriftSupra(): Model
    local car = Instance.new("Model")
    car.Name = "DriftSupra"

    local root = Instance.new("Part")
    root.Name = "RootPart"
    root.Size = Vector3.new(1, 1, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = true
    root.Parent = car
    car.PrimaryPart = root

    local ORANGE = Color3.fromRGB(255, 95, 0)
    local DARK_ORANGE = Color3.fromRGB(200, 70, 0)
    local CARBON = Color3.fromRGB(25, 27, 30)
    local BRONZE_WHEEL = Color3.fromRGB(175, 130, 75)

    -- ChÃ¢ssis large surbaissÃ©
    local base = createPart("WideBase", Vector3.new(6.4, 1.1, 11.6), root.CFrame * CFrame.new(0, -0.25, 0), Enum.Material.SmoothPlastic, ORANGE, car)
    weldParts(root, base)
    local splitter = createPart("CarbonSplitter", Vector3.new(6.6, 0.25, 1.6), root.CFrame * CFrame.new(0, -0.75, -5.9), Enum.Material.DiamondPlate, CARBON, car)
    weldParts(root, splitter)

    -- Canards aÃ©rodynamiques latÃ©raux avant
    local canardL = createPart("CanardL", Vector3.new(0.6, 0.25, 1.2), root.CFrame * CFrame.new(-3.7, -0.55, -5.7) * CFrame.Angles(0, math.rad(-15), math.rad(10)), Enum.Material.SmoothPlastic, CARBON, car)
    weldParts(root, canardL)
    local canardR = createPart("CanardR", Vector3.new(0.6, 0.25, 1.2), root.CFrame * CFrame.new(3.7, -0.55, -5.7) * CFrame.Angles(0, math.rad(15), math.rad(-10)), Enum.Material.SmoothPlastic, CARBON, car)
    weldParts(root, canardR)

    -- Capot galbÃ© carbone avec sorties d'air
    local hood = createPart("CarbonHood", Vector3.new(6.2, 0.6, 4.0), root.CFrame * CFrame.new(0, 0.4, -3.7) * CFrame.Angles(math.rad(-7), 0, 0), Enum.Material.DiamondPlate, CARBON, car)
    weldParts(root, hood)

    -- Toit galbÃ© profilÃ©
    local roof = createPart("RoofDoubleBubble", Vector3.new(4.6, 0.35, 4.4), root.CFrame * CFrame.new(0, 1.65, 0.3), Enum.Material.SmoothPlastic, DARK_ORANGE, car)
    weldParts(root, roof)
    local windshield = createPart("Windshield", Vector3.new(4.5, 1.5, 0.25), root.CFrame * CFrame.new(0, 1.15, -1.8) * CFrame.Angles(math.rad(-34), 0, 0), Enum.Material.Glass, Color3.fromRGB(15, 18, 22), car)
    windshield.Reflectance = 0.4
    weldParts(root, windshield)

    -- Aileron GT dÃ©mesurÃ©
    local wingBlade = createPart("GTWingBlade", Vector3.new(7.2, 0.25, 1.8), root.CFrame * CFrame.new(0, 2.45, 5.5), Enum.Material.SmoothPlastic, CARBON, car)
    weldParts(root, wingBlade)
    local uprightL = createPart("UprightL", Vector3.new(0.25, 1.2, 0.8), root.CFrame * CFrame.new(-2.2, 1.85, 5.5), Enum.Material.Metal, CARBON, car)
    weldParts(root, uprightL)
    local uprightR = createPart("UprightR", Vector3.new(0.25, 1.2, 0.8), root.CFrame * CFrame.new(2.2, 1.85, 5.5), Enum.Material.Metal, CARBON, car)
    weldParts(root, uprightR)

    -- Roues larges bronze droites debout (sans rotation Z)
    local wheelOffsets = {
        Vector3.new(-2.55, -0.95, -3.8), Vector3.new(2.55, -0.95, -3.8),
        Vector3.new(-2.55, -0.95,  3.8), Vector3.new(2.55, -0.95,  3.8),
    }
    for _, offset in ipairs(wheelOffsets) do
        local tire = Instance.new("Part")
        tire.Shape = Enum.PartType.Cylinder
        tire.Size = Vector3.new(1.0, 2.1, 2.1)
        tire.CFrame = root.CFrame * CFrame.new(offset)
        tire.Material = Enum.Material.SmoothPlastic
        tire.Color = Color3.fromRGB(20, 20, 22)
        tire.Anchored = false
        tire.CanCollide = false
        tire.Parent = car
        weldParts(root, tire)

        local rim = Instance.new("Part")
        rim.Shape = Enum.PartType.Cylinder
        rim.Size = Vector3.new(1.05, 1.3, 1.3)
        rim.CFrame = tire.CFrame
        rim.Material = Enum.Material.Metal
        rim.Color = BRONZE_WHEEL
        rim.Anchored = false
        rim.CanCollide = false
        rim.Parent = car
        weldParts(root, rim)
    end

    -- RÃ©troviseurs aÃ©ro carbone
    local mirL = createPart("MirL", Vector3.new(0.65, 0.35, 0.7), root.CFrame * CFrame.new(-2.9, 0.95, -1.6), Enum.Material.SmoothPlastic, CARBON, car)
    weldParts(root, mirL)
    local mirR = createPart("MirR", Vector3.new(0.65, 0.35, 0.7), root.CFrame * CFrame.new(2.9, 0.95, -1.6), Enum.Material.SmoothPlastic, CARBON, car)
    weldParts(root, mirR)

    addDetailedUndercarriage(root, car, 6.4, 11.6)
    return car
end

-- =============================================================================
-- #4 POLICE INTERCEPTOR (Noir/blanc, bullbar, gyrophares, vitesse x2.1, 750$)
-- =============================================================================
function CarBuilder.CreatePoliceInterceptor(): Model
    local car = Instance.new("Model")
    car.Name = "PoliceInterceptor"

    local root = Instance.new("Part")
    root.Name = "RootPart"
    root.Size = Vector3.new(1, 1, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = true
    root.Parent = car
    car.PrimaryPart = root

    local BLACK = Color3.fromRGB(18, 20, 24)
    local WHITE = Color3.fromRGB(245, 248, 252)
    local STEEL = Color3.fromRGB(160, 165, 175)

    -- Carrosserie bicolore
    local base = createPart("Chassis", Vector3.new(6.4, 1.3, 11.8), root.CFrame * CFrame.new(0, -0.2, 0), Enum.Material.SmoothPlastic, BLACK, car)
    weldParts(root, base)
    local doors = createPart("WhiteDoors", Vector3.new(6.45, 1.1, 5.0), root.CFrame * CFrame.new(0, 0.05, 0.2), Enum.Material.SmoothPlastic, WHITE, car)
    weldParts(root, doors)

    -- Pare-buffle avant (PushBar)
    local bullbar = createPart("BullbarMain", Vector3.new(4.8, 1.4, 0.6), root.CFrame * CFrame.new(0, -0.1, -6.1), Enum.Material.Metal, STEEL, car)
    weldParts(root, bullbar)

    -- Toit et vitres
    local roof = createPart("Roof", Vector3.new(4.6, 0.35, 4.6), root.CFrame * CFrame.new(0, 1.85, 0.4), Enum.Material.SmoothPlastic, WHITE, car)
    weldParts(root, roof)
    local windshield = createPart("Windshield", Vector3.new(4.5, 1.6, 0.25), root.CFrame * CFrame.new(0, 1.2, -1.8) * CFrame.Angles(math.rad(-30), 0, 0), Enum.Material.Glass, Color3.fromRGB(15, 18, 22), car)
    weldParts(root, windshield)

    -- Gyrophares sur le toit (Rouge / Bleu)
    local sirenRed = createPart("Siren_Red", Vector3.new(1.8, 0.35, 0.8), root.CFrame * CFrame.new(-1.0, 2.2, 0.4), Enum.Material.Neon, Color3.fromRGB(255, 30, 30), car)
    weldParts(root, sirenRed)
    local sirenBlue = createPart("Siren_Blue", Vector3.new(1.8, 0.35, 0.8), root.CFrame * CFrame.new(1.0, 2.2, 0.4), Enum.Material.Neon, Color3.fromRGB(30, 100, 255), car)
    weldParts(root, sirenBlue)

    -- RÃ©troviseurs
    local mirL = createPart("MirL", Vector3.new(0.65, 0.35, 0.7), root.CFrame * CFrame.new(-2.8, 0.95, -1.6), Enum.Material.SmoothPlastic, BLACK, car)
    weldParts(root, mirL)
    local mirR = createPart("MirR", Vector3.new(0.65, 0.35, 0.7), root.CFrame * CFrame.new(2.8, 0.95, -1.6), Enum.Material.SmoothPlastic, BLACK, car)
    weldParts(root, mirR)

    -- 4 Roues police droites debout (sans rotation Z)
    local wheelOffsets = {
        Vector3.new(-2.55, -0.95, -3.8), Vector3.new(2.55, -0.95, -3.8),
        Vector3.new(-2.55, -0.95,  3.8), Vector3.new(2.55, -0.95,  3.8),
    }
    for _, offset in ipairs(wheelOffsets) do
        local tire = Instance.new("Part")
        tire.Shape = Enum.PartType.Cylinder
        tire.Size = Vector3.new(1.0, 2.1, 2.1)
        tire.CFrame = root.CFrame * CFrame.new(offset)
        tire.Material = Enum.Material.SmoothPlastic
        tire.Color = Color3.fromRGB(20, 20, 22)
        tire.Anchored = false
        tire.CanCollide = false
        tire.Parent = car
        weldParts(root, tire)

        local cap = Instance.new("Part")
        cap.Shape = Enum.PartType.Cylinder
        cap.Size = Vector3.new(1.05, 1.3, 1.3)
        cap.CFrame = tire.CFrame
        cap.Material = Enum.Material.Metal
        cap.Color = STEEL
        cap.Anchored = false
        cap.CanCollide = false
        cap.Parent = car
        weldParts(root, cap)
    end

    addDetailedUndercarriage(root, car, 6.4, 11.8)
    return car
end

-- =============================================================================
-- #5 HYPERION JETCAR (Hypercar dorÃ©e/carbone, rÃ©acteurs cyan, vitesse x2.7, 2000$)
-- =============================================================================
function CarBuilder.CreateHyperionJetCar(): Model
    local car = Instance.new("Model")
    car.Name = "HyperionJetCar"

    local root = Instance.new("Part")
    root.Name = "RootPart"
    root.Size = Vector3.new(1, 1, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = true
    root.Parent = car
    car.PrimaryPart = root

    local GOLD = Color3.fromRGB(245, 195, 45)
    local DARK_CARBON = Color3.fromRGB(18, 20, 24)
    local JET_CYAN = Color3.fromRGB(0, 245, 255)

    -- Fuselage en flÃ¨che
    local body = createPart("Fuselage", Vector3.new(6.4, 1.0, 12.4), root.CFrame * CFrame.new(0, -0.25, 0), Enum.Material.Metal, GOLD, car)
    weldParts(root, body)
    local nose = createPart("AeroNose", Vector3.new(4.2, 0.45, 2.4), root.CFrame * CFrame.new(0, -0.45, -6.4), Enum.Material.DiamondPlate, DARK_CARBON, car)
    weldParts(root, nose)

    -- VerriÃ¨re cockpit type avion de chasse
    local canopy = createPart("Canopy", Vector3.new(3.2, 1.4, 4.4), root.CFrame * CFrame.new(0, 0.85, -0.4) * CFrame.Angles(math.rad(-15), 0, 0), Enum.Material.Glass, Color3.fromRGB(10, 15, 20), car)
    canopy.Reflectance = 0.5
    weldParts(root, canopy)

    -- DÃ©rive dorsale centrale
    local fin = createPart("DorsalFin", Vector3.new(0.3, 1.3, 3.4), root.CFrame * CFrame.new(0, 1.95, 2.2), Enum.Material.SmoothPlastic, DARK_CARBON, car)
    weldParts(root, fin)

    -- TuyÃ¨res de rÃ©acteur arriÃ¨re avec plasma cyan
    for _, xOff in ipairs({ -1.8, 1.8 }) do
        local jetHousing = Instance.new("Part")
        jetHousing.Name = "JetHousing"
        jetHousing.Shape = Enum.PartType.Cylinder
        jetHousing.Size = Vector3.new(1.8, 1.5, 1.5)
        jetHousing.CFrame = root.CFrame * CFrame.new(xOff, 0.35, 6.0) * CFrame.Angles(0, math.rad(90), 0)
        jetHousing.Material = Enum.Material.Metal
        jetHousing.Color = DARK_CARBON
        jetHousing.Anchored = false
        jetHousing.CanCollide = false
        jetHousing.Parent = car
        weldParts(root, jetHousing)

        local plasma = Instance.new("Part")
        plasma.Name = "JetFlame"
        plasma.Shape = Enum.PartType.Cylinder
        plasma.Size = Vector3.new(0.4, 1.1, 1.1)
        plasma.CFrame = root.CFrame * CFrame.new(xOff, 0.35, 6.9) * CFrame.Angles(0, math.rad(90), 0)
        plasma.Material = Enum.Material.Neon
        plasma.Color = JET_CYAN
        plasma.Anchored = false
        plasma.CanCollide = false
        plasma.Parent = car
        weldParts(root, plasma)
    end

    -- 4 Roues aÃ©ro droites debout (sans rotation Z)
    local wheelOffsets = {
        Vector3.new(-2.55, -0.95, -3.8), Vector3.new(2.55, -0.95, -3.8),
        Vector3.new(-2.55, -0.95,  3.8), Vector3.new(2.55, -0.95,  3.8),
    }
    for _, offset in ipairs(wheelOffsets) do
        local tire = Instance.new("Part")
        tire.Shape = Enum.PartType.Cylinder
        tire.Size = Vector3.new(1.0, 2.1, 2.1)
        tire.CFrame = root.CFrame * CFrame.new(offset)
        tire.Material = Enum.Material.SmoothPlastic
        tire.Color = DARK_CARBON
        tire.Anchored = false
        tire.CanCollide = false
        tire.Parent = car
        weldParts(root, tire)
    end

    addDetailedUndercarriage(root, car, 6.4, 12.4)
    return car
end

-- =============================================================================
-- #6 FLASH MCQUEEN ⚡ (MODÈLE IMPORTÉ AUTO-CALIBRÉ OU NASCAR CURVÉ DÉTAILLÉ)
-- =============================================================================
function CarBuilder.CreateFlashMcQueen(): Model
    -- 1. Recherche d'un modèle template importé (via src/shared/FlashMcQueen.rbxm ou ReplicatedStorage)
    local template: Instance? = nil
    local importedFolder = ReplicatedStorage:FindFirstChild("ImportedVehicles")
    if importedFolder then
        template = importedFolder:FindFirstChild("FlashMcQueen")
    end
    if not template then
        template = ReplicatedStorage:FindFirstChild("FlashMcQueen")
    end

    if template and template:IsA("Model") then
        local car = template:Clone()
        car.Name = "FlashMcQueen"

        -- Nettoyage de tout script, siège ou son parasite provenant de la Toolbox
        for _, desc in ipairs(car:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("VehicleSeat") or desc:IsA("Seat") or desc:IsA("Sound") then
                desc:Destroy()
            end
        end

        -- Calcule sa boîte englobante actuelle
        local bbCF, bbSize = car:GetBoundingBox()

        -- Si le modèle est orienté sur l'axe X au lieu de Z (longueur sur X), rotation automatique de 90°
        if bbSize.X > bbSize.Z then
            car:PivotTo(bbCF * CFrame.Angles(0, math.rad(90), 0))
            bbCF, bbSize = car:GetBoundingBox()
        end

        -- Redimensionnement automatique pour que sa largeur (X) fasse exactement 6.2 studs
        if bbSize.X > 0.01 then
            local scaleRatio = 6.2 / bbSize.X
            car:ScaleTo(scaleRatio)
            bbCF, bbSize = car:GetBoundingBox()
        end

        -- Création d'une Part invisible "RootPart" centrée géométriquement avec le bas des roues à Y = -2.0
        local rootY = bbCF.Position.Y - (bbSize.Y / 2) + 2.0
        local rootCF = CFrame.new(bbCF.Position.X, rootY, bbCF.Position.Z)

        local root = Instance.new("Part")
        root.Name = "RootPart"
        root.Size = Vector3.new(1, 1, 1)
        root.CFrame = rootCF
        root.Transparency = 1
        root.CanCollide = false
        root.Anchored = true
        root.Parent = car

        -- Soude toutes les BaseParts au RootPart, CanCollide = false, CanQuery = true, Anchored = false
        for _, desc in ipairs(car:GetDescendants()) do
            if desc:IsA("BasePart") and desc ~= root then
                desc.Anchored = false
                desc.CanCollide = false
                desc.CanQuery = true
                weldParts(root, desc)
            end
        end

        car.PrimaryPart = root
        addDetailedUndercarriage(root, car, 6.2, math.max(bbSize.Z, 11.5))
        return car
    end

    -- 2. NASCAR stock-car procédural courbé & aérodynamique (si aucun .rbxm présent)
    local car = Instance.new("Model")
    car.Name = "FlashMcQueen"

    local root = Instance.new("Part")
    root.Name = "RootPart"
    root.Size = Vector3.new(1, 1, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = true
    root.Parent = car
    car.PrimaryPart = root

    local MCQUEEN_RED  = Color3.fromRGB(230, 20, 25)
    local DARK_RED     = Color3.fromRGB(165, 12, 18)
    local CARBON_BLACK = Color3.fromRGB(20, 22, 25)
    local GOLD         = Color3.fromRGB(255, 215, 0)
    local ORANGE       = Color3.fromRGB(255, 115, 0)
    local WHITE_GLASS  = Color3.fromRGB(230, 240, 250)
    local EYE_BLUE     = Color3.fromRGB(55, 130, 220)
    local PUPIL_BLACK  = Color3.fromRGB(8, 8, 12)
    local RIM_GOLD     = Color3.fromRGB(210, 175, 55)
    local HEADLIGHT    = Color3.fromRGB(255, 252, 225)

    -- Fonction d'aide pour ajouter une forme courbée avec SpecialMesh
    local function createCurvedPart(name: string, size: Vector3, cf: CFrame, meshType: Enum.MeshType, col: Color3): Part
        local p = createPart(name, size, cf, Enum.Material.SmoothPlastic, col, car)
        local sm = Instance.new("SpecialMesh")
        sm.MeshType = meshType
        sm.Parent = p
        weldParts(root, p)
        return p
    end

    -- ===== CARROSSERIE NASCAR ARRONDIE & BOMBÉE =====
    -- Châssis principal bas de caisse
    local base = createPart("Base", Vector3.new(6.4, 1.2, 12.0),
        root.CFrame * CFrame.new(0, -0.2, 0), Enum.Material.SmoothPlastic, MCQUEEN_RED, car)
    weldParts(root, base)

    -- Splitter avant carbone profilé
    local splitter = createPart("Splitter", Vector3.new(6.6, 0.3, 1.6),
        root.CFrame * CFrame.new(0, -0.72, -6.2), Enum.Material.SmoothPlastic, CARBON_BLACK, car)
    weldParts(root, splitter)

    -- Nez avant arrondi plongeant (SpecialMesh Sphere)
    createCurvedPart("FrontNoseRound", Vector3.new(6.2, 0.95, 2.6),
        root.CFrame * CFrame.new(0, -0.05, -5.5), Enum.MeshType.Sphere, MCQUEEN_RED)

    -- Capot avant plongeant incliné
    local hood = createPart("Hood", Vector3.new(6.0, 0.55, 4.2),
        root.CFrame * CFrame.new(0, 0.42, -3.5) * CFrame.Angles(math.rad(-8), 0, 0),
        Enum.Material.SmoothPlastic, MCQUEEN_RED, car)
    weldParts(root, hood)

    -- Bombe aérodynamique centrale du capot (SpecialMesh Sphere)
    createCurvedPart("HoodBulgeRound", Vector3.new(5.6, 0.70, 4.0),
        root.CFrame * CFrame.new(0, 0.48, -3.5) * CFrame.Angles(math.rad(-8), 0, 0),
        Enum.MeshType.Sphere, MCQUEEN_RED)

    -- 4 Ailes galbées bombées au-dessus des roues (SpecialMesh Sphere)
    createCurvedPart("FenderFL_Round", Vector3.new(1.35, 0.95, 3.4),
        root.CFrame * CFrame.new(-2.85, 0.22, -3.8), Enum.MeshType.Sphere, MCQUEEN_RED)
    createCurvedPart("FenderFR_Round", Vector3.new(1.35, 0.95, 3.4),
        root.CFrame * CFrame.new(2.85, 0.22, -3.8), Enum.MeshType.Sphere, MCQUEEN_RED)
    createCurvedPart("FenderRL_Round", Vector3.new(1.35, 1.05, 3.6),
        root.CFrame * CFrame.new(-2.85, 0.28, 3.8), Enum.MeshType.Sphere, MCQUEEN_RED)
    createCurvedPart("FenderRR_Round", Vector3.new(1.35, 1.05, 3.6),
        root.CFrame * CFrame.new(2.85, 0.28, 3.8), Enum.MeshType.Sphere, MCQUEEN_RED)

    -- Flancs cintrés arrondis (SpecialMesh Sphere pour courber les portières)
    createCurvedPart("SideWaistL", Vector3.new(0.65, 1.15, 7.8),
        root.CFrame * CFrame.new(-3.12, -0.15, 0.1), Enum.MeshType.Sphere, MCQUEEN_RED)
    createCurvedPart("SideWaistR", Vector3.new(0.65, 1.15, 7.8),
        root.CFrame * CFrame.new(3.12, -0.15, 0.1), Enum.MeshType.Sphere, MCQUEEN_RED)

    -- Pont arrière / coffre arrondi
    local rearDeck = createPart("RearDeck", Vector3.new(6.2, 0.85, 3.4),
        root.CFrame * CFrame.new(0, 0.50, 4.0), Enum.Material.SmoothPlastic, MCQUEEN_RED, car)
    weldParts(root, rearDeck)

    createCurvedPart("RearBumperRound", Vector3.new(6.2, 0.95, 2.0),
        root.CFrame * CFrame.new(0, 0.18, 5.7), Enum.MeshType.Sphere, MCQUEEN_RED)

    -- ===== TOIT EN DÔME BOMBÉ & VITRES NASCAR =====
    -- Dôme de toit profilé fluide (SpecialMesh Sphere)
    createCurvedPart("RoofDome", Vector3.new(4.8, 1.35, 4.6),
        root.CFrame * CFrame.new(0, 1.68, 0.35), Enum.MeshType.Sphere, MCQUEEN_RED)

    -- Toit plat de renfort
    local roof = createPart("Roof", Vector3.new(4.4, 0.35, 4.0),
        root.CFrame * CFrame.new(0, 1.88, 0.3), Enum.Material.SmoothPlastic, MCQUEEN_RED, car)
    weldParts(root, roof)

    -- Pare-brise incliné (fond blanc/clair pour les yeux)
    local windshield = createPart("Windshield", Vector3.new(4.5, 1.65, 0.2),
        root.CFrame * CFrame.new(0, 1.20, -1.9) * CFrame.Angles(math.rad(-33), 0, 0),
        Enum.Material.Glass, WHITE_GLASS, car)
    windshield.Reflectance = 0.15
    windshield.Transparency = 0.15
    weldParts(root, windshield)

    -- ===== YEUX EMBLÉMATIQUES SUR LE PARE-BRISE =====
    -- Iris gauche (bleu)
    local eyeL = createPart("EyeIrisL", Vector3.new(1.0, 0.85, 0.08),
        root.CFrame * CFrame.new(-0.85, 1.30, -2.08) * CFrame.Angles(math.rad(-33), 0, 0),
        Enum.Material.SmoothPlastic, EYE_BLUE, car)
    weldParts(root, eyeL)
    -- Pupille gauche (noire)
    local pupilL = createPart("EyePupilL", Vector3.new(0.45, 0.45, 0.09),
        root.CFrame * CFrame.new(-0.85, 1.30, -2.12) * CFrame.Angles(math.rad(-33), 0, 0),
        Enum.Material.SmoothPlastic, PUPIL_BLACK, car)
    weldParts(root, pupilL)
    -- Iris droit (bleu)
    local eyeR = createPart("EyeIrisR", Vector3.new(1.0, 0.85, 0.08),
        root.CFrame * CFrame.new(0.85, 1.30, -2.08) * CFrame.Angles(math.rad(-33), 0, 0),
        Enum.Material.SmoothPlastic, EYE_BLUE, car)
    weldParts(root, eyeR)
    -- Pupille droite (noire)
    local pupilR = createPart("EyePupilR", Vector3.new(0.45, 0.45, 0.09),
        root.CFrame * CFrame.new(0.85, 1.30, -2.12) * CFrame.Angles(math.rad(-33), 0, 0),
        Enum.Material.SmoothPlastic, PUPIL_BLACK, car)
    weldParts(root, pupilR)

    -- Lunette arrière
    local rearWin = createPart("RearWindow", Vector3.new(4.5, 1.4, 0.2),
        root.CFrame * CFrame.new(0, 1.25, 2.6) * CFrame.Angles(math.rad(30), 0, 0),
        Enum.Material.Glass, CARBON_BLACK, car)
    rearWin.Reflectance = 0.30
    weldParts(root, rearWin)

    -- ===== ÉCLAIRS LATÉRAUX "KA-CHOW" (NÉON OR + ORANGE) =====
    -- Flanc GAUCHE
    local boltL1 = createPart("BoltL1", Vector3.new(0.12, 0.55, 2.8),
        root.CFrame * CFrame.new(-3.25, 0.15, -2.0) * CFrame.Angles(0, 0, math.rad(12)),
        Enum.Material.Neon, GOLD, car)
    weldParts(root, boltL1)
    local boltL2 = createPart("BoltL2", Vector3.new(0.12, 0.50, 1.8),
        root.CFrame * CFrame.new(-3.25, 0.40, 0.4) * CFrame.Angles(0, 0, math.rad(-15)),
        Enum.Material.Neon, ORANGE, car)
    weldParts(root, boltL2)
    local boltL3 = createPart("BoltL3", Vector3.new(0.12, 0.55, 2.6),
        root.CFrame * CFrame.new(-3.25, 0.10, 2.6) * CFrame.Angles(0, 0, math.rad(10)),
        Enum.Material.Neon, GOLD, car)
    weldParts(root, boltL3)

    -- Flanc DROIT (symétrique)
    local boltR1 = createPart("BoltR1", Vector3.new(0.12, 0.55, 2.8),
        root.CFrame * CFrame.new(3.25, 0.15, -2.0) * CFrame.Angles(0, 0, math.rad(-12)),
        Enum.Material.Neon, GOLD, car)
    weldParts(root, boltR1)
    local boltR2 = createPart("BoltR2", Vector3.new(0.12, 0.50, 1.8),
        root.CFrame * CFrame.new(3.25, 0.40, 0.4) * CFrame.Angles(0, 0, math.rad(15)),
        Enum.Material.Neon, ORANGE, car)
    weldParts(root, boltR2)
    local boltR3 = createPart("BoltR3", Vector3.new(0.12, 0.55, 2.6),
        root.CFrame * CFrame.new(3.25, 0.10, 2.6) * CFrame.Angles(0, 0, math.rad(-10)),
        Enum.Material.Neon, GOLD, car)
    weldParts(root, boltR3)

    -- ===== GRAND AILERON ARRIÈRE PISTON CUP =====
    local wingStrutL = createPart("WingStrutL", Vector3.new(0.3, 1.5, 0.6),
        root.CFrame * CFrame.new(-1.8, 1.75, 5.5) * CFrame.Angles(math.rad(8), 0, 0),
        Enum.Material.SmoothPlastic, CARBON_BLACK, car)
    weldParts(root, wingStrutL)
    local wingStrutR = createPart("WingStrutR", Vector3.new(0.3, 1.5, 0.6),
        root.CFrame * CFrame.new(1.8, 1.75, 5.5) * CFrame.Angles(math.rad(8), 0, 0),
        Enum.Material.SmoothPlastic, CARBON_BLACK, car)
    weldParts(root, wingStrutR)

    local wing = createPart("RearWingSpoiler", Vector3.new(6.6, 0.25, 1.9),
        root.CFrame * CFrame.new(0, 2.55, 5.7) * CFrame.Angles(math.rad(-5), 0, 0),
        Enum.Material.SmoothPlastic, MCQUEEN_RED, car)
    weldParts(root, wing)

    local endplateL = createPart("EndplateL", Vector3.new(0.15, 0.8, 1.6),
        root.CFrame * CFrame.new(-3.35, 2.35, 5.7), Enum.Material.SmoothPlastic, DARK_RED, car)
    weldParts(root, endplateL)
    local endplateR = createPart("EndplateR", Vector3.new(0.15, 0.8, 1.6),
        root.CFrame * CFrame.new(3.35, 2.35, 5.7), Enum.Material.SmoothPlastic, DARK_RED, car)
    weldParts(root, endplateR)

    -- ===== PHARES AVANT NÉON =====
    local headL = createPart("HeadlightL", Vector3.new(1.4, 0.45, 0.2),
        root.CFrame * CFrame.new(-2.2, 0.05, -6.05), Enum.Material.Neon, HEADLIGHT, car)
    weldParts(root, headL)
    local headR = createPart("HeadlightR", Vector3.new(1.4, 0.45, 0.2),
        root.CFrame * CFrame.new(2.2, 0.05, -6.05), Enum.Material.Neon, HEADLIGHT, car)
    weldParts(root, headR)

    -- Feux arrière rouges
    local tailL = createPart("TaillightL", Vector3.new(1.2, 0.4, 0.15),
        root.CFrame * CFrame.new(-2.3, 0.35, 6.05), Enum.Material.Neon, Color3.fromRGB(255, 20, 20), car)
    weldParts(root, tailL)
    local tailR = createPart("TaillightR", Vector3.new(1.2, 0.4, 0.15),
        root.CFrame * CFrame.new(2.3, 0.35, 6.05), Enum.Material.Neon, Color3.fromRGB(255, 20, 20), car)
    weldParts(root, tailR)

    -- ===== NUMÉRO "95" =====
    local numL = createPart("Number95_L", Vector3.new(0.1, 1.1, 1.6),
        root.CFrame * CFrame.new(-3.25, 0.65, 0.0), Enum.Material.Neon, GOLD, car)
    weldParts(root, numL)
    local numR = createPart("Number95_R", Vector3.new(0.1, 1.1, 1.6),
        root.CFrame * CFrame.new(3.25, 0.65, 0.0), Enum.Material.Neon, GOLD, car)
    weldParts(root, numR)

    -- ===== 4 ROUES AVEC JANTES DORÉES =====
    local wheelOffsets = {
        Vector3.new(-2.55, -0.95, -3.8), Vector3.new(2.55, -0.95, -3.8),
        Vector3.new(-2.55, -0.95,  3.8), Vector3.new(2.55, -0.95,  3.8),
    }
    for _, offset in ipairs(wheelOffsets) do
        local tire = Instance.new("Part")
        tire.Shape = Enum.PartType.Cylinder
        tire.Size = Vector3.new(1.0, 2.1, 2.1)
        tire.CFrame = root.CFrame * CFrame.new(offset)
        tire.Material = Enum.Material.SmoothPlastic
        tire.Color = Color3.fromRGB(20, 20, 22)
        tire.Anchored = false
        tire.CanCollide = false
        tire.Parent = car
        weldParts(root, tire)

        local rim = Instance.new("Part")
        rim.Shape = Enum.PartType.Cylinder
        rim.Size = Vector3.new(1.05, 1.3, 1.3)
        rim.CFrame = tire.CFrame
        rim.Material = Enum.Material.Metal
        rim.Color = RIM_GOLD
        rim.Anchored = false
        rim.CanCollide = false
        rim.Parent = car
        weldParts(root, rim)
    end

    -- Rétroviseurs
    local mirL = createPart("MirrorL", Vector3.new(0.7, 0.35, 0.8),
        root.CFrame * CFrame.new(-2.7, 0.95, -1.5), Enum.Material.SmoothPlastic, DARK_RED, car)
    weldParts(root, mirL)
    local mirR = createPart("MirrorR", Vector3.new(0.7, 0.35, 0.8),
        root.CFrame * CFrame.new(2.7, 0.95, -1.5), Enum.Material.SmoothPlastic, DARK_RED, car)
    weldParts(root, mirR)

    addDetailedUndercarriage(root, car, 6.4, 12.0)
    return car
end


-- =============================================================================
-- REGISTRE DES 5 VÃ‰HICULES (OuterContour supprimÃ© â€” scan Raycast automatique)
-- =============================================================================
CarBuilder.Vehicles = {
    {
        Id = "lotus_rally",
        Index = 1,
        Name = "#1 Lotus Rally",
        SpeedMultiplier = 1.0,
        RewardCash = 50,
        FrontZ = -6.0,
        Builder = CarBuilder.CreateLotusRally,
    },
    {
        Id = "cyber_truck",
        Index = 2,
        Name = "#2 Cyber Truck",
        SpeedMultiplier = 1.35,
        RewardCash = 120,
        FrontZ = -6.0,
        Builder = CarBuilder.CreateCyberTruck,
    },
    {
        Id = "drift_supra",
        Index = 3,
        Name = "#3 Drift Supra",
        SpeedMultiplier = 1.7,
        RewardCash = 300,
        FrontZ = -6.0,
        Builder = CarBuilder.CreateDriftSupra,
    },
    {
        Id = "police_interceptor",
        Index = 4,
        Name = "#4 Police Interceptor",
        SpeedMultiplier = 2.1,
        RewardCash = 750,
        FrontZ = -6.4,
        Builder = CarBuilder.CreatePoliceInterceptor,
    },
    {
        Id = "hyperion_jetcar",
        Index = 5,
        Name = "#5 Hyperion JetCar",
        SpeedMultiplier = 2.7,
        RewardCash = 2000,
        FrontZ = -6.8,
        Builder = CarBuilder.CreateHyperionJetCar,
    },
    {
        Id = "flash_mcqueen",
        Index = 6,
        Name = "#6 Flash McQueen ⚡",
        SpeedMultiplier = 3.2,
        RewardCash = 5000,
        FrontZ = -6.0,
        Builder = CarBuilder.CreateFlashMcQueen,
    },
}

-- RÃ©cupÃ¨re la config d'un vÃ©hicule par ID ou Index
function CarBuilder.GetVehicleConfig(idOrIndex: any): VehicleConfig
    if type(idOrIndex) == "number" then
        return CarBuilder.Vehicles[math.clamp(idOrIndex, 1, #CarBuilder.Vehicles)]
    end
    for _, cfg in ipairs(CarBuilder.Vehicles) do
        if cfg.Id == idOrIndex then
            return cfg
        end
    end
    return CarBuilder.Vehicles[1]
end

-- =============================================================================
-- CRÃ‰ATION DU TARGETFRAME PAR SCANNER RAYCAST AUTOMATIQUE
-- â–º Instancie temporairement la vraie voiture 3D sur targetCF
-- â–º Tire une grille de rayons depuis eyePos Ã  travers le plan contourCF
-- â–º Collecte le profil haut + bas, simplifie (Douglas-Peucker), trace la boucle Neon verte
-- â–º RÃ©sultat : contour mathÃ©matiquement impossible Ã  dÃ©Phaser â€” calquÃ© au laser sur la carrosserie rÃ©elle
-- =============================================================================
function CarBuilder.CreateTargetFrame(idOrIndex: any, centerPos: Vector3): Model
    local cfg = CarBuilder.GetVehicleConfig(idOrIndex)

    -- Nettoyage de tout ancien TargetFrame existant
    local oldFrame = workspace:FindFirstChild("TargetFrame")
    if oldFrame then oldFrame:Destroy() end

    local frameModel = Instance.new("Model")
    frameModel.Name = "TargetFrame"
    frameModel.Parent = workspace

    -- RepÃ¨re gÃ©omÃ©trique identique Ã  CameraController et GameLoop
    local slopeVector = Vector3.new(0, 120, 400)
    local uDir = slopeVector.Unit
    local rightVec = Vector3.new(1, 0, 0)
    local normalVec = uDir:Cross(rightVec)
    local downhillDir = -uDir

    -- CFrame cible du vÃ©hicule (de face face Ã  la camÃ©ra)
    local targetCF = CFrame.lookAt(centerPos, centerPos + downhillDir, normalVec)

    -- Position de l'Å“il de la camÃ©ra (identique Ã  CameraController.client.luau)
    local roadBasePos = centerPos - (uDir * 20)
    local eyePos = roadBasePos - (normalVec * 0.4)

    -- Plan du contour : devant le nez de la voiture
    local contourCF = targetCF * CFrame.new(0, 0, cfg.FrontZ - 0.15)

    local NEON_GREEN = Color3.fromRGB(0, 255, 60)
    local BAR_THICKNESS = 0.12

    -- RepÃ¨re invisible CenterPoint
    local centerPoint = Instance.new("Part")
    centerPoint.Name = "CenterPoint"
    centerPoint.Size = Vector3.new(1, 1, 1)
    centerPoint.CFrame = targetCF
    centerPoint.Transparency = 1
    centerPoint.Anchored = true
    centerPoint.CanCollide = false
    centerPoint.Parent = frameModel
    frameModel.PrimaryPart = centerPoint

    local pointLight = Instance.new("PointLight")
    pointLight.Name = "FrameLight"
    pointLight.Color = NEON_GREEN
    pointLight.Brightness = 3.0
    pointLight.Range = 26
    pointLight.Parent = centerPoint

    -- =========================================================
    -- Ã‰TAPE 1 : Instanciation temporaire du vrai modÃ¨le 3D
    -- =========================================================
    local tempCar = cfg.Builder()
    for _, part in ipairs(tempCar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = true
            part.CanQuery = true
        end
    end
    tempCar.Parent = workspace
    tempCar:PivotTo(targetCF)

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Include
    rayParams.FilterDescendantsInstances = { tempCar }

    -- =========================================================
    -- Ã‰TAPE 2 : Scan Raycast colonne par colonne
    -- =========================================================
    local topProfile: { Vector2 } = {}
    local botProfile: { Vector2 } = {}

    local xMin, xMax, xStep = -3.60, 3.60, 0.08
    local yMin, yMax, yStep = -2.30, 2.80, 0.06

    local x = xMin
    while x <= xMax + 0.001 do
        local firstHitY: number? = nil
        local lastHitY: number? = nil

        local y = yMin
        while y <= yMax + 0.001 do
            local planePt = contourCF:PointToWorldSpace(Vector3.new(x, y, 0))
            local dir = (planePt - eyePos).Unit * 60
            local hit = workspace:Raycast(eyePos, dir, rayParams)
            if hit then
                if not firstHitY then firstHitY = y end
                lastHitY = y
            end
            y += yStep
        end

        if firstHitY and lastHitY then
            table.insert(topProfile, Vector2.new(x, lastHitY :: number))
            table.insert(botProfile, Vector2.new(x, firstHitY :: number))
        end
        x += xStep
    end

    -- DÃ©truit immÃ©diatement le modÃ¨le temporaire
    tempCar:Destroy()

    -- =========================================================
    -- Ã‰TAPE 3 : Simplification Ramer-Douglas-Peucker
    -- =========================================================
    local function simplifyPolyline(pts: { Vector2 }, epsilon: number): { Vector2 }
        if #pts <= 2 then return pts end
        local maxDist = 0
        local index = 1
        local p1, p2 = pts[1], pts[#pts]
        local lineVec = p2 - p1
        local lineLen = lineVec.Magnitude
        for i = 2, #pts - 1 do
            local d = 0
            if lineLen < 1e-5 then
                d = (pts[i] - p1).Magnitude
            else
                local t = math.clamp((pts[i] - p1):Dot(lineVec) / (lineLen * lineLen), 0, 1)
                local proj = p1 + lineVec * t
                d = (pts[i] - proj).Magnitude
            end
            if d > maxDist then index = i; maxDist = d end
        end
        if maxDist > epsilon then
            local leftPts: { Vector2 } = {}
            for i = 1, index do table.insert(leftPts, pts[i]) end
            local rightPts: { Vector2 } = {}
            for i = index, #pts do table.insert(rightPts, pts[i]) end
            local res1 = simplifyPolyline(leftPts, epsilon)
            local res2 = simplifyPolyline(rightPts, epsilon)
            local merged: { Vector2 } = {}
            for i = 1, #res1 - 1 do table.insert(merged, res1[i]) end
            for i = 1, #res2 do table.insert(merged, res2[i]) end
            return merged
        else
            return { p1, p2 }
        end
    end

    local cleanTop = simplifyPolyline(topProfile, 0.05)
    local reversedBot: { Vector2 } = {}
    for i = #botProfile, 1, -1 do table.insert(reversedBot, botProfile[i]) end
    local cleanBot = simplifyPolyline(reversedBot, 0.05)

    -- Polygone fermÃ© complet (haut gaucheâ†’droite, bas droiteâ†’gauche)
    local fullPolygon: { Vector2 } = {}
    for _, pt in ipairs(cleanTop) do table.insert(fullPolygon, pt) end
    for _, pt in ipairs(cleanBot) do table.insert(fullPolygon, pt) end

    -- =========================================================
    -- Ã‰TAPE 4 : TracÃ© de la boucle Neon verte
    -- =========================================================
    local count = #fullPolygon
    if count < 3 then
        -- Fallback : carrÃ© de sÃ©curitÃ© si le scan ne touche rien
        warn("[CarBuilder] Raycast scan vide pour " .. cfg.Name .. " â€” cadre fallback")
        local fallback = { Vector2.new(-3, -1.5), Vector2.new(3, -1.5), Vector2.new(3, 2.5), Vector2.new(-3, 2.5) }
        for i, pt in ipairs(fallback) do
            local nextPt = fallback[(i % #fallback) + 1]
            local wA = contourCF:PointToWorldSpace(Vector3.new(pt.X, pt.Y, 0))
            local wB = contourCF:PointToWorldSpace(Vector3.new(nextPt.X, nextPt.Y, 0))
            local seg = Instance.new("Part")
            seg.Name = "Fallback_" .. i
            seg.Size = Vector3.new(BAR_THICKNESS, BAR_THICKNESS, (wB - wA).Magnitude)
            seg.CFrame = CFrame.lookAt((wA + wB) / 2, wB)
            seg.Material = Enum.Material.Neon
            seg.Color = NEON_GREEN
            seg.Anchored = true
            seg.CanCollide = false
            seg.CastShadow = false
            seg.Parent = frameModel
        end
    else
        for i = 1, count do
            local ptA = fullPolygon[i]
            local ptB = fullPolygon[(i % count) + 1]
            local wA = contourCF:PointToWorldSpace(Vector3.new(ptA.X, ptA.Y, 0))
            local wB = contourCF:PointToWorldSpace(Vector3.new(ptB.X, ptB.Y, 0))
            local segVec = wB - wA
            local segLen = segVec.Magnitude
            if segLen > 0.02 then
                local bar = Instance.new("Part")
                bar.Name = string.format("Outline_%02d", i)
                bar.Size = Vector3.new(BAR_THICKNESS, BAR_THICKNESS, segLen)
                bar.CFrame = CFrame.lookAt((wA + wB) / 2, (wA + wB) / 2 + segVec.Unit)
                bar.Material = Enum.Material.Neon
                bar.Color = NEON_GREEN
                bar.Anchored = true
                bar.CanCollide = false
                bar.CastShadow = false
                bar.Parent = frameModel
            end
        end
    end

    print(string.format("[CarBuilder] TargetFrame RAYCAST scannÃ© pour %s (%d segments)", cfg.Name, count))
    return frameModel
end

return CarBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">SystemCheck</string>
        <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - SYSTEM CHECK (SHARED MODULE)
    Diagnostic système complet exécuté au démarrage du serveur :
    - Statut du serveur et environnement d'exécution (Studio / Live)
    - Montant de Cash de démarrage configuré
    - Liste des véhicules enregistrés et disponibilité du dossier ReplicatedStorage.Vehicles
    - Statut des services maîtres (DataManager, GarageService, CraneService)
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SystemCheck = {}

function SystemCheck.RunDiagnostic()
    print("==================================================================")
    print("       ⚡ [SYSTEM CHECK] STOP AT THE FRAME - DIAGNOSTIC SERVEUR ⚡")
    print("==================================================================")

    -- 1. Statut d'exécution
    local envType = if RunService:IsStudio() then "Roblox Studio (Local/Test)" else "Serveur Dédié Roblox (Live)"
    print(string.format("[STATUS] Serveur : ONLINE | Environnement : %s", envType))
    print(string.format("[STATUS] Timestamp : %d", os.time()))

    -- 2. Vérification des véhicules chargés via CarBuilder
    local carBuilderModule = ReplicatedStorage:FindFirstChild("CarBuilder") :: ModuleScript?
    if carBuilderModule then
        local success, CarBuilder = pcall(function()
            return require(carBuilderModule) :: any
        end)

        if success and CarBuilder and CarBuilder.Vehicles then
            local vehicleCount = #CarBuilder.Vehicles
            print(string.format("[VEHICULES] %d véhicules enregistrés dans CarBuilder :", vehicleCount))
            for i, v in ipairs(CarBuilder.Vehicles) do
                print(string.format("   #%d [%s] - %s | Vitesse: x%.2f | Prime: $%d", i, tostring(v.Id), tostring(v.Name), tonumber(v.SpeedMultiplier) or 1.0, tonumber(v.RewardCash) or 0))
            end
        else
            warn("[VEHICULES] Impossible de lire CarBuilder.Vehicles")
        end
    else
        warn("[VEHICULES] Module CarBuilder introuvable dans ReplicatedStorage")
    end

    -- 3. Vérification du dossier ReplicatedStorage.Vehicles (ou ImportedVehicles)
    local vehiclesFolder = ReplicatedStorage:FindFirstChild("Vehicles") :: Folder?
    if not vehiclesFolder then
        vehiclesFolder = Instance.new("Folder")
        vehiclesFolder.Name = "Vehicles"
        vehiclesFolder.Parent = ReplicatedStorage
        print("[STORAGE] Dossier ReplicatedStorage.Vehicles initialisé avec succès.")
    else
        local count = #vehiclesFolder:GetChildren()
        print(string.format("[STORAGE] Dossier ReplicatedStorage.Vehicles détecté (%d modèles 3D).", count))
    end

    -- 4. Vérification de l'économie de démarrage
    local startingCash = 100 -- Valeur de référence par défaut
    print(string.format("[ECONOMIE] Cash de démarrage joueur : $%d", startingCash))

    -- 5. Vérification des Remotes
    local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
    if remotesFolder then
        local remoteNames = {}
        for _, child in ipairs(remotesFolder:GetChildren()) do
            table.insert(remoteNames, child.Name)
        end
        print(string.format("[REMOTES] Événements réseau actifs (%d) : %s", #remoteNames, table.concat(remoteNames, ", ")))
    end

    print("==================================================================")
    print("       ✅ TOUS LES SOUS-SYSTÈMES SONT OPÉRATIONNELS (100% OK)")
    print("==================================================================")
end

return SystemCheck
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">GameServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - GAME SERVER (SERVER SCRIPT)
    Gère l'économie, les leaderstats (Cash $, Streak 🔥, Titre),
    les récompenses de saut et l'initialisation des Services (DataManager, Garage, Grue).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CarBuilder = require(ReplicatedStorage:WaitForChild("CarBuilder") :: ModuleScript)
local SystemCheck = require(ReplicatedStorage:WaitForChild("SystemCheck") :: ModuleScript)

-- Services Serveur
local DataManager = require(script.Parent.Services.DataManager)
local GarageService = require(script.Parent.Services.GarageService)
local CraneService = require(script.Parent.Services.CraneService)

-- 1. Configuration des dossiers réseau
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "Remotes"
    remotesFolder.Parent = ReplicatedStorage
end

local submitEvent = remotesFolder:FindFirstChild("SubmitStopResult") :: RemoteEvent?
if not submitEvent then
    submitEvent = Instance.new("RemoteEvent")
    submitEvent.Name = "SubmitStopResult"
    submitEvent.Parent = remotesFolder
end

-- 2. Configuration des leaderstats et données du joueur
local function calculateTitle(streak: number, framePerfects: number): string
    if framePerfects >= 10 then
        return "240Hz Stopper God"
    elseif framePerfects >= 3 then
        return "Frame 1 Demon"
    elseif streak >= 10 or framePerfects >= 1 then
        return "Œil Bionique"
    elseif streak >= 3 then
        return "Chasseur de Frames"
    else
        return "Réflexes de Tortue"
    end
end

local function setupPlayer(player: Player)
    local data = DataManager.LoadData(player)

    local leaderstats = Instance.new("Folder")
    leaderstats.Name = "leaderstats"
    leaderstats.Parent = player

    local cashVal = Instance.new("IntValue")
    cashVal.Name = "Cash"
    cashVal.Value = data.Cash
    cashVal.Parent = leaderstats

    local streakVal = Instance.new("IntValue")
    streakVal.Name = "Streak"
    streakVal.Value = data.Streak
    streakVal.Parent = leaderstats

    local titleVal = Instance.new("StringValue")
    titleVal.Name = "Title"
    titleVal.Value = data.Title
    titleVal.Parent = leaderstats

    local fpVal = Instance.new("IntValue")
    fpVal.Name = "TotalFramePerfects"
    fpVal.Value = data.TotalFramePerfects
    fpVal.Parent = player
end

Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(function()
        setupPlayer(p)
    end)
end

-- 3. Traitement des résultats de saut soumis par le client
submitEvent.OnServerEvent:Connect(function(player: Player, vehicleId: any, grade: any, distance: any, accuracy: any)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return end

    local cashVal = leaderstats:FindFirstChild("Cash") :: IntValue?
    local streakVal = leaderstats:FindFirstChild("Streak") :: IntValue?
    local titleVal = leaderstats:FindFirstChild("Title") :: StringValue?
    local fpVal = player:FindFirstChild("TotalFramePerfects") :: IntValue?

    if not cashVal or not streakVal or not titleVal or not fpVal then return end

    local vId = tostring(vehicleId or "lotus_rally")
    local vConfig = CarBuilder.GetVehicleConfig(vId)
    local gradeStr = tostring(grade or "RATÉ!")
    local baseReward = vConfig.RewardCash

    if gradeStr == "FRAME PERFECT!" then
        streakVal.Value += 1
        fpVal.Value += 1
        local reward = math.floor(baseReward + (streakVal.Value * 15))
        DataManager.AddCash(player, reward)

    elseif gradeStr == "PERFECT!" then
        streakVal.Value += 1
        local reward = math.floor(baseReward * 0.75 + (streakVal.Value * 8))
        DataManager.AddCash(player, reward)

    elseif gradeStr == "GOOD!" then
        streakVal.Value += 1
        local reward = math.floor(baseReward * 0.40)
        DataManager.AddCash(player, reward)

    else
        -- RATÉ : Réinitialisation du streak
        streakVal.Value = 0
    end

    -- Mise à jour automatique du titre honorifique
    local newTitle = calculateTitle(streakVal.Value, fpVal.Value)
    titleVal.Value = newTitle
end)

print("[GameServer] Services initialises : DataManager, GarageService, CraneService.")

-- Execution du diagnostic systeme complet
task.spawn(function()
    task.wait(0.5)
    SystemCheck.RunDiagnostic()
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">CraneService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - CRANE SERVICE (SERVICE MODULE)
    Gère le Mode Pêche (Grue & Aimant sous-marin) :
    - Déploiement physique du câble et de l'aimant dans les profondeurs aquatiques.
    - Détection d'accrochage par Raycast sous-marin.
    - Tirage de loot procédural par palier de profondeur et puissance magnétique.
    - Remontée du véhicule et ajout automatique à l'inventaire du joueur.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local DataManager = require(script.Parent.DataManager)

local CraneService = {}

-- Paliers de profondeur aquatique et table de loot
export type LootEntry = {
    VehicleId: string,
    Name: string,
    Rarity: string,
    MinDepth: number,
    Weight: number,
}

local LOOT_TABLE: { LootEntry } = {
    { VehicleId = "lotus_rally",        Name = "Lotus Rally",        Rarity = "Commune",    MinDepth = 0,   Weight = 50 },
    { VehicleId = "cyber_truck",        Name = "Cyber Truck",        Rarity = "Peu Commune",MinDepth = 25,  Weight = 30 },
    { VehicleId = "drift_supra",        Name = "Drift Supra",        Rarity = "Rare",       MinDepth = 50,  Weight = 15 },
    { VehicleId = "police_interceptor", Name = "Police Interceptor", Rarity = "Épique",     MinDepth = 80,  Weight = 8  },
    { VehicleId = "hyperion_jetcar",    Name = "Hyperion JetCar",    Rarity = "Légendaire", MinDepth = 110, Weight = 4  },
    { VehicleId = "flash_mcqueen",      Name = "Flash McQueen ⚡",    Rarity = "Mythique",   MinDepth = 140, Weight = 1  },
}

-- Événements réseau pour la Grue
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "Remotes"
    remotesFolder.Parent = ReplicatedStorage
end

local deployCraneEvent = remotesFolder:FindFirstChild("DeployCrane") :: RemoteEvent?
if not deployCraneEvent then
    deployCraneEvent = Instance.new("RemoteEvent")
    deployCraneEvent.Name = "DeployCrane"
    deployCraneEvent.Parent = remotesFolder
end

local craneHookedEvent = remotesFolder:FindFirstChild("CraneHooked") :: RemoteEvent?
if not craneHookedEvent then
    craneHookedEvent = Instance.new("RemoteEvent")
    craneHookedEvent.Name = "CraneHooked"
    craneHookedEvent.Parent = remotesFolder
end

-- Tirage aléatoire pondéré selon la profondeur atteinte
function CraneService.RollLoot(depth: number, magnetPower: number): LootEntry
    local availablePool: { LootEntry } = {}
    local totalWeight = 0

    for _, entry in ipairs(LOOT_TABLE) do
        -- L'aimant puissant permet de repêcher des véhicules de paliers plus profonds plus facilement
        local effectiveMin = math.max(0, entry.MinDepth - (magnetPower - 1) * 15)
        if depth >= effectiveMin then
            table.insert(availablePool, entry)
            totalWeight += entry.Weight
        end
    end

    if #availablePool == 0 or totalWeight <= 0 then
        return LOOT_TABLE[1]
    end

    local roll = math.random() * totalWeight
    local current = 0
    for _, entry in ipairs(availablePool) do
        current += entry.Weight
        if roll <= current then
            return entry
        end
    end

    return availablePool[#availablePool]
end

-- Traitement du déploiement de la grue par le client
deployCraneEvent.OnServerEvent:Connect(function(player: Player, targetDepth: any)
    local data = DataManager.GetData(player)
    if not data then return end

    local requestedDepth = math.clamp(tonumber(targetDepth) or 20, 10, 250)
    -- Plafond de profondeur selon le niveau du câble
    local maxCableDepth = 30 + (data.Crane.CableLengthLevel * 25)
    local actualDepth = math.min(requestedDepth, maxCableDepth)

    -- Tirage de la trouvaille sous-marine
    local loot = CraneService.RollLoot(actualDepth, data.Crane.MagneticPowerLevel)

    -- Ajout du véhicule à l'inventaire du joueur
    local isNew = DataManager.AddVehicleToInventory(player, loot.VehicleId)

    -- Notification au client avec animation de remontée
    if craneHookedEvent then
        craneHookedEvent:FireClient(player, loot.VehicleId, loot.Name, loot.Rarity, actualDepth, isNew)
    end
end)

return CraneService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - DATA MANAGER (SERVICE MODULE)
    Gère la persistance DataStore des joueurs :
    - Économie (Cash $, Streak 🔥, Titre)
    - Inventaire de véhicules pêchés et débloqués
    - Showroom (Véhicules exposés générant du cash passif)
    - Améliorations de la Grue (Longueur de câble, Puissance aimant, Vitesse treuil)
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local DataManager = {}

export type PlayerData = {
    Cash: number,
    Streak: number,
    TotalFramePerfects: number,
    Title: string,
    Inventory: { string }, -- Liste des IDs de véhicules possédés
    Showroom: { [number]: string }, -- SlotIndex -> VehicleId
    Crane: {
        CableLengthLevel: number,
        MagneticPowerLevel: number,
        WinchSpeedLevel: number,
    },
}

local DATA_VERSION = "SATF_V1_PlayerData"
local playerDataStore: DataStore? = nil

local success, ds = pcall(function()
    return DataStoreService:GetDataStore(DATA_VERSION)
end)
if success and ds then
    playerDataStore = ds
else
    warn("[DataManager] DataStore non disponible en mode hors-ligne Studio. Utilisation de la mémoire cache.")
end

local sessionCache: { [Player]: PlayerData } = {}

local DEFAULT_DATA: PlayerData = {
    Cash = 1000,
    Streak = 0,
    TotalFramePerfects = 0,
    Title = "Réflexes de Tortue",
    Inventory = { "lotus_rally", "cyber_truck", "drift_supra", "police_interceptor", "hyperion_jetcar", "flash_mcqueen" },
    Showroom = {
        [1] = "lotus_rally",
        [2] = "cyber_truck",
        [3] = "drift_supra",
        [4] = "police_interceptor",
        [5] = "hyperion_jetcar",
        [6] = "flash_mcqueen",
    },
    Crane = {
        CableLengthLevel = 1,
        MagneticPowerLevel = 1,
        WinchSpeedLevel = 1,
    },
}

local function cloneDefaultData(): PlayerData
    local copy: PlayerData = {
        Cash = DEFAULT_DATA.Cash,
        Streak = DEFAULT_DATA.Streak,
        TotalFramePerfects = DEFAULT_DATA.TotalFramePerfects,
        Title = DEFAULT_DATA.Title,
        Inventory = {},
        Showroom = {},
        Crane = {
            CableLengthLevel = DEFAULT_DATA.Crane.CableLengthLevel,
            MagneticPowerLevel = DEFAULT_DATA.Crane.MagneticPowerLevel,
            WinchSpeedLevel = DEFAULT_DATA.Crane.WinchSpeedLevel,
        },
    }
    for _, id in ipairs(DEFAULT_DATA.Inventory) do
        table.insert(copy.Inventory, id)
    end
    for slot, id in pairs(DEFAULT_DATA.Showroom) do
        copy.Showroom[slot] = id
    end
    return copy
end

function DataManager.LoadData(player: Player): PlayerData
    if sessionCache[player] then
        return sessionCache[player]
    end

    local loadedData: PlayerData = cloneDefaultData()
    if playerDataStore then
        local key = "Player_" .. tostring(player.UserId)
        local ok, result = pcall(function()
            return playerDataStore:GetAsync(key)
        end)
        if ok and type(result) == "table" then
            if type(result.Cash) == "number" then loadedData.Cash = result.Cash end
            if type(result.Streak) == "number" then loadedData.Streak = result.Streak end
            if type(result.TotalFramePerfects) == "number" then loadedData.TotalFramePerfects = result.TotalFramePerfects end
            if type(result.Title) == "string" then loadedData.Title = result.Title end
            if type(result.Inventory) == "table" then loadedData.Inventory = result.Inventory end
            if type(result.Showroom) == "table" then loadedData.Showroom = result.Showroom end
            if type(result.Crane) == "table" then
                loadedData.Crane.CableLengthLevel = result.Crane.CableLengthLevel or 1
                loadedData.Crane.MagneticPowerLevel = result.Crane.MagneticPowerLevel or 1
                loadedData.Crane.WinchSpeedLevel = result.Crane.WinchSpeedLevel or 1
            end
        end
    end

    -- Garantit que les 6 véhicules sont toujours disponibles pour le joueur dès le départ
    local allVehicles = { "lotus_rally", "cyber_truck", "drift_supra", "police_interceptor", "hyperion_jetcar", "flash_mcqueen" }
    for _, vId in ipairs(allVehicles) do
        if not table.find(loadedData.Inventory, vId) then
            table.insert(loadedData.Inventory, vId)
        end
    end
    for i, vId in ipairs(allVehicles) do
        loadedData.Showroom[i] = vId
    end

    sessionCache[player] = loadedData
    return loadedData
end

function DataManager.SaveData(player: Player)
    local data = sessionCache[player]
    if not data or not playerDataStore then return end

    local key = "Player_" .. tostring(player.UserId)
    pcall(function()
        playerDataStore:SetAsync(key, data)
    end)
end

function DataManager.GetData(player: Player): PlayerData?
    return sessionCache[player]
end

function DataManager.AddCash(player: Player, amount: number)
    local data = sessionCache[player]
    if not data then return end
    data.Cash = math.max(0, data.Cash + amount)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local cashVal = leaderstats:FindFirstChild("Cash") :: IntValue?
        if cashVal then cashVal.Value = data.Cash end
    end
end

function DataManager.AddVehicleToInventory(player: Player, vehicleId: string): boolean
    local data = sessionCache[player]
    if not data then return false end
    for _, id in ipairs(data.Inventory) do
        if id == vehicleId then
            -- Doublon : compensation en cash
            DataManager.AddCash(player, 500)
            return false
        end
    end
    table.insert(data.Inventory, vehicleId)
    return true
end

function DataManager.UnloadPlayer(player: Player)
    DataManager.SaveData(player)
    sessionCache[player] = nil
end

Players.PlayerRemoving:Connect(function(player)
    DataManager.UnloadPlayer(player)
end)

game:BindToClose(function()
    for _, player in ipairs(Players:GetPlayers()) do
        DataManager.SaveData(player)
    end
end)

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">GarageService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - GARAGE SERVICE (SERVICE MODULE)
    Gère le Showroom du Garage et la génération de cash passif :
    - Chaque véhicule exposé dans le hangar rapporte du Cash en continu ($ / sec).
    - Plus le véhicule est rare et prestigieux, plus le rendement passif est élevé.
    - Synchronise les gains avec DataManager et les leaderstats du joueur.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local DataManager = require(script.Parent.DataManager)
local CarBuilder = require(ReplicatedStorage:WaitForChild("CarBuilder") :: ModuleScript)

local GarageService = {}

-- Rendement passif ($ / seconde) selon la rareté du véhicule
local PASSIVE_RATES: { [string]: number } = {
    lotus_rally        = 2,   -- Tier 1
    cyber_truck        = 5,   -- Tier 2
    drift_supra        = 12,  -- Tier 3
    police_interceptor = 25,  -- Tier 4
    hyperion_jetcar    = 60,  -- Tier 5
    flash_mcqueen      = 150, -- Tier 6 (Légendaire / Piston Cup)
}

-- Événements réseau pour le Garage
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "Remotes"
    remotesFolder.Parent = ReplicatedStorage
end

local garageUpdateEvent = remotesFolder:FindFirstChild("GaragePassiveTick") :: RemoteEvent?
if not garageUpdateEvent then
    garageUpdateEvent = Instance.new("RemoteEvent")
    garageUpdateEvent.Name = "GaragePassiveTick"
    garageUpdateEvent.Parent = remotesFolder
end

function GarageService.GetPassiveRateForVehicle(vehicleId: string): number
    return PASSIVE_RATES[vehicleId] or 2
end

function GarageService.CalculateTotalIncomePerSecond(player: Player): number
    local data = DataManager.GetData(player)
    if not data then return 0 end

    local totalRate = 0
    for _, vId in pairs(data.Showroom) do
        totalRate += GarageService.GetPassiveRateForVehicle(vId)
    end
    return totalRate
end

-- Boucle de génération de revenu passif (Toutes les 2 secondes)
local TICK_INTERVAL = 2.0
task.spawn(function()
    while true do
        task.wait(TICK_INTERVAL)
        for _, player in ipairs(Players:GetPlayers()) do
            local incomeRate = GarageService.CalculateTotalIncomePerSecond(player)
            if incomeRate > 0 then
                local gained = math.floor(incomeRate * TICK_INTERVAL)
                DataManager.AddCash(player, gained)
                if garageUpdateEvent then
                    garageUpdateEvent:FireClient(player, gained, incomeRate)
                end
            end
        end
    end
end)

return GarageService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="10">
      <Properties>
        <string name="Name">WorldBuilder</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - WORLD BUILDER (SERVER SCRIPT)
    Génère procéduralement la rue en pente raide style San Francisco,
    les immeubles pastel, le cadre cible vert néon "TargetFrame",
    et le Hub Portuaire Simulator compact et chaleureux (Quai 80x70, Grue 3D, 6 Podiums Showroom, Spots sous-marins).
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 1. Suppression de la Baseplate par défaut
for _, child in ipairs(Workspace:GetChildren()) do
    if child.Name == "Baseplate" and child:IsA("BasePart") then
        child:Destroy()
    end
end

local streetFolder = Instance.new("Folder")
streetFolder.Name = "SanFranciscoStreet"
streetFolder.Parent = Workspace

-- Paramètres géométriques de la pente raide (San Francisco)
-- Pente le long de l'axe Z (montée de Z = -40 à Z = 360, dénivelé Y = 0 à Y = 120)
local ROAD_START_Z = -40
local ROAD_END_Z = 360
local ROAD_START_Y = 0
local ROAD_END_Y = 120
local ROAD_WIDTH = 34
local SIDEWALK_WIDTH = 8

local slopeVector = Vector3.new(0, ROAD_END_Y - ROAD_START_Y, ROAD_END_Z - ROAD_START_Z)
local slopeLength = slopeVector.Magnitude
local uDir = slopeVector.Unit -- Vecteur unitaire qui monte la pente
local rightVec = Vector3.new(1, 0, 0) -- Vecteur transversal horizontal
local normalVec = uDir:Cross(rightVec) -- Vecteur normal perpendiculaire à la route vers le ciel

local midX = 0
local midY = (ROAD_START_Y + ROAD_END_Y) / 2
local midZ = (ROAD_START_Z + ROAD_END_Z) / 2
local roadCenterPos = Vector3.new(midX, midY, midZ)
local roadCFrame = CFrame.fromMatrix(roadCenterPos, rightVec, normalVec)

local function createPart(name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, canCollide: boolean, parent: Instance): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = cf
    part.Material = material
    part.Color = color
    part.Anchored = true
    part.CanCollide = canCollide
    part.Parent = parent
    return part
end

-- 2. Chaussée en asphalte gris foncé
local roadPart = createPart(
    "AsphaltRoad",
    Vector3.new(ROAD_WIDTH, 2, slopeLength + 20),
    roadCFrame,
    Enum.Material.Asphalt,
    Color3.fromRGB(36, 38, 42),
    true,
    streetFolder
)

-- 3. Double ligne jaune centrale
local lineLength = slopeLength + 20
local line1Pos = roadCenterPos + (rightVec * -0.6) + (normalVec * 1.05)
local line2Pos = roadCenterPos + (rightVec * 0.6) + (normalVec * 1.05)

createPart("YellowLine_Left", Vector3.new(0.4, 0.05, lineLength), CFrame.fromMatrix(line1Pos, rightVec, normalVec), Enum.Material.SmoothPlastic, Color3.fromRGB(255, 204, 0), false, streetFolder)
createPart("YellowLine_Right", Vector3.new(0.4, 0.05, lineLength), CFrame.fromMatrix(line2Pos, rightVec, normalVec), Enum.Material.SmoothPlastic, Color3.fromRGB(255, 204, 0), false, streetFolder)

-- 4. Trottoirs gauche et droite avec bordure surélevée
local leftSidewalkX = -(ROAD_WIDTH / 2 + SIDEWALK_WIDTH / 2)
local rightSidewalkX = (ROAD_WIDTH / 2 + SIDEWALK_WIDTH / 2)

local leftSidewalkPos = roadCenterPos + (rightVec * leftSidewalkX) + (normalVec * 0.5)
local rightSidewalkPos = roadCenterPos + (rightVec * rightSidewalkX) + (normalVec * 0.5)

createPart("Sidewalk_Left", Vector3.new(SIDEWALK_WIDTH, 2.5, lineLength), CFrame.fromMatrix(leftSidewalkPos, rightVec, normalVec), Enum.Material.Concrete, Color3.fromRGB(185, 188, 192), true, streetFolder)
createPart("Sidewalk_Right", Vector3.new(SIDEWALK_WIDTH, 2.5, lineLength), CFrame.fromMatrix(rightSidewalkPos, rightVec, normalVec), Enum.Material.Concrete, Color3.fromRGB(185, 188, 192), true, streetFolder)

-- Bordures de trottoir (Curbs)
local leftCurbPos = roadCenterPos + (rightVec * -(ROAD_WIDTH / 2 + 0.3)) + (normalVec * 0.6)
local rightCurbPos = roadCenterPos + (rightVec * (ROAD_WIDTH / 2 + 0.3)) + (normalVec * 0.6)
createPart("Curb_Left", Vector3.new(0.6, 2.7, lineLength), CFrame.fromMatrix(leftCurbPos, rightVec, normalVec), Enum.Material.Concrete, Color3.fromRGB(135, 138, 142), true, streetFolder)
createPart("Curb_Right", Vector3.new(0.6, 2.7, lineLength), CFrame.fromMatrix(rightCurbPos, rightVec, normalVec), Enum.Material.Concrete, Color3.fromRGB(135, 138, 142), true, streetFolder)

-- 5. Immeubles pastel style San Francisco avec fenêtres des deux côtés
local pastelColors = {
    Color3.fromRGB(168, 218, 185),
    Color3.fromRGB(245, 230, 205),
    Color3.fromRGB(165, 200, 235),
    Color3.fromRGB(245, 202, 188),
    Color3.fromRGB(215, 202, 235),
}

local buildingFolder = Instance.new("Folder")
buildingFolder.Name = "PastelBuildings"
buildingFolder.Parent = streetFolder

local function buildTownhouse(xOffset: number, zPos: number, colorIndex: number, isLeftSide: boolean)
    local t = (zPos - ROAD_START_Z) / (ROAD_END_Z - ROAD_START_Z)
    local groundY = ROAD_START_Y + t * (ROAD_END_Y - ROAD_START_Y)

    local bWidth = 20
    local bDepth = 22
    local bHeight = 36 + ((zPos * 7) % 8)
    local buildingColor = pastelColors[((colorIndex - 1) % #pastelColors) + 1]

    local bCenterPos = Vector3.new(xOffset, groundY + (bHeight / 2) - 4, zPos)
    local bModel = Instance.new("Model")
    bModel.Name = "Townhouse_" .. math.floor(zPos)
    bModel.Parent = buildingFolder

    createPart("MainBody", Vector3.new(bWidth, bHeight, bDepth), CFrame.new(bCenterPos), Enum.Material.SmoothPlastic, buildingColor, true, bModel)
    createPart("Cornice", Vector3.new(bWidth + 1.2, 1.8, bDepth + 1.2), CFrame.new(bCenterPos + Vector3.new(0, bHeight / 2 + 0.9, 0)), Enum.Material.SmoothPlastic, Color3.fromRGB(250, 250, 252), true, bModel)

    local facadeX = if isLeftSide then (bCenterPos.X + bWidth / 2 + 0.1) else (bCenterPos.X - bWidth / 2 - 0.1)

    local doorY = groundY + 3.5
    local doorZ = zPos - 5
    createPart("Door", Vector3.new(0.3, 7, 3.5), CFrame.new(facadeX, doorY, doorZ), Enum.Material.WoodPlanks, Color3.fromRGB(75, 50, 40), false, bModel)

    for floor = 1, 3 do
        local windowY = groundY + 5 + (floor * 8)
        for _, zOffset in ipairs({ -3, 4 }) do
            local winZ = zPos + zOffset
            createPart("WindowFrame", Vector3.new(0.35, 4.6, 3.2), CFrame.new(facadeX, windowY, winZ), Enum.Material.SmoothPlastic, Color3.fromRGB(255, 255, 255), false, bModel)
            createPart("WindowGlass", Vector3.new(0.4, 4.0, 2.6), CFrame.new(facadeX, windowY, winZ), Enum.Material.Neon, Color3.fromRGB(225, 242, 255), false, bModel)
        end
    end
end

local stepZ = 24
local colorIdx = 1
for z = ROAD_START_Z + 10, ROAD_END_Z - 10, stepZ do
    buildTownhouse(-35, z, colorIdx, true)
    buildTownhouse(35, z, colorIdx + 2, false)
    colorIdx += 1
end

-- =============================================================================
-- 6. LE CADRE VERT CIBLE "TargetFrame" INITIALISÉ VIA CARBUILDER
-- =============================================================================
local CarBuilder = require(ReplicatedStorage:WaitForChild("CarBuilder") :: ModuleScript)

local midT = 0.5
local midSurfaceY = ROAD_START_Y + midT * (ROAD_END_Y - ROAD_START_Y) + 1.0
local midSurfacePos = Vector3.new(0, midSurfaceY, midZ)

local FRAME_FLOAT_HEIGHT = 4.0
local frameCenterPos = midSurfacePos + (normalVec * (FRAME_FLOAT_HEIGHT + 1.8))
local frameBaseCF = CFrame.fromMatrix(frameCenterPos, rightVec, normalVec)

CarBuilder.CreateTargetFrame("lotus_rally", frameCenterPos)

print("[WorldBuilder] Rue San Francisco en pente et TargetFrame initialisés avec succès.")

-- =============================================================================
-- 7. LE HUB SIMULATOR TROPICAL & JETÉE MARITIME (STYLE TOP SIMULATOR ROBLOX)
-- =============================================================================
local Lighting = game:GetService("Lighting")

-- Configuration de l'Éclairage & Ambiance Tropicale
Lighting.Brightness = 2.8
Lighting.ClockTime = 14.5
Lighting.GeographicLatitude = 25
Lighting.GlobalShadows = true
Lighting.Ambient = Color3.fromRGB(115, 135, 160)
Lighting.OutdoorAmbient = Color3.fromRGB(145, 170, 195)
Lighting.ColorShift_Top = Color3.fromRGB(255, 248, 235)

local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Density = 0.28
atmosphere.Offset = 0.25
atmosphere.Color = Color3.fromRGB(195, 225, 255)
atmosphere.Decay = Color3.fromRGB(245, 195, 140)
atmosphere.Glare = 0.35
atmosphere.Haze = 0.4
atmosphere.Parent = Lighting

local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
bloom.Intensity = 0.65
bloom.Size = 22
bloom.Threshold = 1.6
bloom.Parent = Lighting

local colorCorrection = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
colorCorrection.Brightness = 0.03
colorCorrection.Contrast = 0.12
colorCorrection.Saturation = 0.28
colorCorrection.TintColor = Color3.fromRGB(255, 252, 245)
colorCorrection.Parent = Lighting

local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
sunRays.Intensity = 0.16
sunRays.Spread = 0.8
sunRays.Parent = Lighting

local docksFolder = Instance.new("Folder")
docksFolder.Name = "SanFranciscoDocks"
docksFolder.Parent = Workspace

-- =============================================================================
-- A. VASTE OCÉAN TROPICAL & HORIZON CÔTIER
-- =============================================================================
local vastOcean = createPart(
    "VastOceanSurface",
    Vector3.new(2048, 2, 2048),
    CFrame.new(0, -0.6, -180),
    Enum.Material.Glass,
    Color3.fromRGB(18, 155, 215),
    false,
    docksFolder
)
vastOcean.Transparency = 0.38
vastOcean.Reflectance = 0.45

local vastSeaBed = createPart(
    "VastSeaBed",
    Vector3.new(2048, 8, 2048),
    CFrame.new(0, -42, -180),
    Enum.Material.Sand,
    Color3.fromRGB(30, 44, 54),
    true,
    docksFolder
)

-- Rivages tropicaux sur les côtés
createPart("Coastline_Left", Vector3.new(200, 18, 400), CFrame.new(-135, -6, -80), Enum.Material.Sand, Color3.fromRGB(240, 222, 172), true, docksFolder)
createPart("Coastline_Right", Vector3.new(200, 18, 400), CFrame.new(135, -6, -80), Enum.Material.Sand, Color3.fromRGB(240, 222, 172), true, docksFolder)

-- Épave sous-marine au fond de l'eau avec bulles
local wreckRally = CarBuilder.CreateLotusRally()
wreckRally.Name = "SunkenWreck_Lotus"
wreckRally.Parent = docksFolder
wreckRally:PivotTo(CFrame.new(0, -36, -135) * CFrame.Angles(math.rad(15), math.rad(45), math.rad(-10)))
for _, p in ipairs(wreckRally:GetDescendants()) do
    if p:IsA("BasePart") then
        p.Material = Enum.Material.CorrodedMetal
        p.Color = Color3.fromRGB(90, 60, 45)
        p.Anchored = true
        p.CanCollide = false
    end
end

local bubbleEmitter = Instance.new("ParticleEmitter")
bubbleEmitter.Name = "UnderwaterBubbles"
bubbleEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
bubbleEmitter.Color = ColorSequence.new(Color3.fromRGB(180, 240, 255))
bubbleEmitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1.4) })
bubbleEmitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.7) })
bubbleEmitter.Rate = 14
bubbleEmitter.Speed = NumberRange.new(4, 9)
bubbleEmitter.SpreadAngle = Vector2.new(15, 15)
local bubbleAnchor = Instance.new("Part")
bubbleAnchor.Name = "BubbleAnchor"
bubbleAnchor.Size = Vector3.new(1, 1, 1)
bubbleAnchor.CFrame = CFrame.new(0, -34, -135)
bubbleAnchor.Transparency = 1
bubbleAnchor.Anchored = true
bubbleAnchor.CanCollide = false
bubbleAnchor.Parent = docksFolder
bubbleEmitter.Parent = bubbleAnchor

-- =============================================================================
-- B. LA GRANDE JETÉE CENTRALE (PIER RUNWAY AVEC LIGNES CYAN NÉON)
-- =============================================================================
local mainPier = createPart(
    "MainPierPlaza",
    Vector3.new(34, 3, 98),
    CFrame.new(0, -0.5, -83),
    Enum.Material.WoodPlanks,
    Color3.fromRGB(28, 40, 52),
    true,
    docksFolder
)

-- Bordures de finition en bois chaud
createPart("PierBorder_L", Vector3.new(1.2, 1.4, 98), CFrame.new(-17, 1.2, -83), Enum.Material.WoodPlanks, Color3.fromRGB(115, 80, 48), true, docksFolder)
createPart("PierBorder_R", Vector3.new(1.2, 1.4, 98), CFrame.new(17, 1.2, -83), Enum.Material.WoodPlanks, Color3.fromRGB(115, 80, 48), true, docksFolder)
createPart("PierBorder_End", Vector3.new(35.2, 1.4, 1.4), CFrame.new(0, 1.2, -132), Enum.Material.WoodPlanks, Color3.fromRGB(115, 80, 48), true, docksFolder)

-- 5 Lignes Cyan Néon "Runway" au centre du quai (Exactement comme dans l'image 5)
local stripeOffsets = { -8, -4, 0, 4, 8 }
for i, xOff in ipairs(stripeOffsets) do
    local stripe = createPart(
        "RunwayStripe_" .. i,
        Vector3.new(0.4, 0.05, 94),
        CFrame.new(xOff, 1.03, -83),
        Enum.Material.Neon,
        Color3.fromRGB(0, 245, 255),
        false,
        docksFolder
    )
    stripe.Transparency = 0.15
end

-- Barrières et Guirlandes lumineuses festives le long de la jetée
local festoonColors = {
    Color3.fromRGB(255, 215, 80),
    Color3.fromRGB(0, 240, 255),
    Color3.fromRGB(255, 75, 120),
    Color3.fromRGB(60, 255, 140),
}

for _, sideX in ipairs({ -17.2, 17.2 }) do
    for z = -38, -128, 12 do
        local post = createPart("PierPost", Vector3.new(0.8, 6.5, 0.8), CFrame.new(sideX, 3.5, z), Enum.Material.WoodPlanks, Color3.fromRGB(110, 75, 45), true, docksFolder)
        local orb = createPart("FestoonOrb", Vector3.new(1.1, 1.1, 1.1), CFrame.new(sideX, 6.8, z), Enum.Material.Neon, festoonColors[((math.abs(math.floor(z)) // 12) % #festoonColors) + 1], false, docksFolder)
        local pLight = Instance.new("PointLight")
        pLight.Color = orb.Color
        pLight.Brightness = 1.8
        pLight.Range = 16
        pLight.Parent = orb
    end
end

-- Spawn du joueur au début de la jetée, orienté vers la mer et le Showroom
local spawnLocation = Instance.new("SpawnLocation")
spawnLocation.Name = "DockSpawnPoint"
spawnLocation.Size = Vector3.new(8, 0.5, 8)
spawnLocation.CFrame = CFrame.new(0, 1.25, -45)
spawnLocation.Material = Enum.Material.WoodPlanks
spawnLocation.Color = Color3.fromRGB(35, 50, 65)
spawnLocation.Anchored = true
spawnLocation.CanCollide = true
spawnLocation.Neutral = true
spawnLocation.Parent = docksFolder

-- =============================================================================
-- C. LES 6 PODIUMS DU SHOWROOM (2 RANGÉES ÉLÉGANTES ET SYMÉTRIQUES)
-- =============================================================================
local showroomFolder = Instance.new("Folder")
showroomFolder.Name = "ShowroomPodiums"
showroomFolder.Parent = docksFolder

local SHOWROOM_CONFIGS = {
    -- Rangée Gauche (X = -10.5)
    { Slot = 1, Pos = Vector3.new(-10.5, 1.0, -58),  VehId = "lotus_rally",        Rate = "$2/s",   Color = Color3.fromRGB(40, 230, 90),   Rarity = "COMMUNE",    Name = "Lotus Rally" },
    { Slot = 2, Pos = Vector3.new(-10.5, 1.0, -80),  VehId = "drift_supra",        Rate = "$12/s",  Color = Color3.fromRGB(30, 120, 255),  Rarity = "RARE",       Name = "Drift Supra" },
    { Slot = 3, Pos = Vector3.new(-10.5, 1.0, -102), VehId = "hyperion_jetcar",    Rate = "$60/s",  Color = Color3.fromRGB(255, 130, 20),  Rarity = "LÉGENDAIRE", Name = "Hyperion JetCar" },
    
    -- Rangée Droite (X = 10.5)
    { Slot = 4, Pos = Vector3.new(10.5, 1.0, -58),   VehId = "cyber_truck",        Rate = "$5/s",   Color = Color3.fromRGB(0, 220, 255),   Rarity = "PEU COMMUNE",Name = "Cyber Truck" },
    { Slot = 5, Pos = Vector3.new(10.5, 1.0, -80),   VehId = "police_interceptor", Rate = "$25/s",  Color = Color3.fromRGB(175, 45, 255),  Rarity = "ÉPIQUE",     Name = "Police Interceptor" },
    { Slot = 6, Pos = Vector3.new(10.5, 1.0, -102),  VehId = "flash_mcqueen",      Rate = "$150/s", Color = Color3.fromRGB(255, 215, 0),   Rarity = "MYTHIQUE",   Name = "⭐ Flash McQueen ⚡" },
}

for _, pcfg in ipairs(SHOWROOM_CONFIGS) do
    local pModel = Instance.new("Model")
    pModel.Name = "Podium_" .. pcfg.VehId
    pModel.Parent = showroomFolder

    -- Base circulaire du podium (Blanc lisse)
    local stand = Instance.new("Part")
    stand.Name = "PodiumStand"
    stand.Shape = Enum.PartType.Cylinder
    stand.Size = Vector3.new(0.7, 7.5, 7.5)
    stand.CFrame = CFrame.new(pcfg.Pos) * CFrame.Angles(0, 0, math.rad(90))
    stand.Material = Enum.Material.SmoothPlastic
    stand.Color = Color3.fromRGB(245, 248, 255)
    stand.Anchored = true
    stand.CanCollide = true
    stand.Parent = pModel

    -- Anneau Néon coloré selon la rareté
    local glowRing = Instance.new("Part")
    glowRing.Name = "GlowRing"
    glowRing.Shape = Enum.PartType.Cylinder
    glowRing.Size = Vector3.new(0.35, 7.9, 7.9)
    glowRing.CFrame = CFrame.new(pcfg.Pos + Vector3.new(0, 0.35, 0)) * CFrame.Angles(0, 0, math.rad(90))
    glowRing.Material = Enum.Material.Neon
    glowRing.Color = pcfg.Color
    glowRing.Anchored = true
    glowRing.CanCollide = false
    glowRing.Parent = pModel

    local pLight = Instance.new("PointLight")
    pLight.Color = pcfg.Color
    pLight.Brightness = 2.0
    pLight.Range = 14
    pLight.Parent = glowRing

    -- Véhicule 3D exposé sur le podium
    local carModel: Model? = nil
    pcall(function()
        local vcfg = CarBuilder.GetVehicleConfig(pcfg.VehId)
        carModel = vcfg.Builder()
        if carModel then
            carModel.Name = "ExhibitionCar_" .. pcfg.VehId
            carModel.Parent = pModel
            local angleY = (pcfg.Pos.X < 0) and 15 or -15
            carModel:PivotTo(CFrame.new(pcfg.Pos + Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, math.rad(180 + angleY), 0))
            for _, bp in ipairs(carModel:GetDescendants()) do
                if bp:IsA("BasePart") then
                    bp.Anchored = true
                    bp.CanCollide = false
                end
            end
        end
    end)

    -- Tag compact flottant (AlwaysOnTop = false pour éviter l'encombrement)
    local statBb = Instance.new("BillboardGui")
    statBb.Name = "VehicleTag"
    statBb.Size = UDim2.new(0, 170, 0, 38)
    statBb.StudsOffset = Vector3.new(0, 4.4, 0)
    statBb.AlwaysOnTop = false
    statBb.MaxDistance = 35
    statBb.Parent = stand

    local tagFrame = Instance.new("Frame")
    tagFrame.Size = UDim2.new(1, 0, 1, 0)
    tagFrame.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    tagFrame.BorderSizePixel = 0
    tagFrame.Parent = statBb

    local tagCorner = Instance.new("UICorner")
    tagCorner.CornerRadius = UDim.new(0, 8)
    tagCorner.Parent = tagFrame

    local tagStroke = Instance.new("UIStroke")
    tagStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    tagStroke.Color = pcfg.Color
    tagStroke.Thickness = 2
    tagStroke.Parent = tagFrame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -8, 0, 18)
    nameLabel.Position = UDim2.new(0, 4, 0, 2)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.FredokaOne
    nameLabel.TextSize = 13
    nameLabel.TextColor3 = pcfg.Color
    nameLabel.Text = pcfg.Name
    nameLabel.Parent = tagFrame

    local rateLabel = Instance.new("TextLabel")
    rateLabel.Size = UDim2.new(1, -8, 0, 16)
    rateLabel.Position = UDim2.new(0, 4, 0, 18)
    rateLabel.BackgroundTransparency = 1
    rateLabel.Font = Enum.Font.GothamBold
    rateLabel.TextSize = 11
    rateLabel.TextColor3 = Color3.fromRGB(240, 245, 255)
    rateLabel.Text = pcfg.Rarity .. " • +" .. pcfg.Rate
    rateLabel.Parent = tagFrame

    -- Bouton / Pad circulaire au sol devant le podium (Collect Pad)
    local collectX = (pcfg.Pos.X < 0) and (pcfg.Pos.X + 4.8) or (pcfg.Pos.X - 4.8)
    local collectPad = Instance.new("Part")
    collectPad.Name = "CollectPad_" .. pcfg.VehId
    collectPad.Shape = Enum.PartType.Cylinder
    collectPad.Size = Vector3.new(0.25, 4.2, 4.2)
    collectPad.CFrame = CFrame.new(collectX, 1.05, pcfg.Pos.Z) * CFrame.Angles(0, 0, math.rad(90))
    collectPad.Material = Enum.Material.Neon
    collectPad.Color = pcfg.Color
    collectPad.Transparency = 0.2
    collectPad.Anchored = true
    collectPad.CanCollide = false
    collectPad.Parent = pModel

    local padBb = Instance.new("BillboardGui")
    padBb.Name = "PadTag"
    padBb.Size = UDim2.new(0, 120, 0, 24)
    padBb.StudsOffset = Vector3.new(0, 1.6, 0)
    padBb.AlwaysOnTop = false
    padBb.MaxDistance = 22
    padBb.Parent = collectPad

    local padLbl = Instance.new("TextLabel")
    padLbl.Size = UDim2.new(1, 0, 1, 0)
    padLbl.BackgroundTransparency = 1
    padLbl.Font = Enum.Font.GothamBlack
    padLbl.TextSize = 11
    padLbl.TextColor3 = pcfg.Color
    padLbl.TextStrokeColor3 = Color3.fromRGB(10, 12, 16)
    padLbl.TextStrokeTransparency = 0.2
    padLbl.Text = "💰 +" .. pcfg.Rate
    padLbl.Parent = padBb
end

-- =============================================================================
-- D. LA STATION DE PÊCHE MARITIME AU BOUT DU QUAI (VUE PANORAMIQUE SUR L'OCÉAN)
-- =============================================================================
local craneModel = Instance.new("Model")
craneModel.Name = "IndustrialFishingCrane"
craneModel.Parent = docksFolder

-- Portique maritime moderne cadrant l'océan sur les côtés (laisse le centre 100% ouvert)
local GANTRY_NAVY = Color3.fromRGB(24, 32, 44)
local GANTRY_WHITE = Color3.fromRGB(240, 245, 252)
local GANTRY_CYAN = Color3.fromRGB(0, 245, 255)

-- Piliers stylisés gauche et droite
createPart("GantryPillar_L", Vector3.new(2.4, 16, 2.4), CFrame.new(-14, 8, -130), Enum.Material.Metal, GANTRY_NAVY, true, craneModel)
createPart("GantryPillar_R", Vector3.new(2.4, 16, 2.4), CFrame.new(14, 8, -130), Enum.Material.Metal, GANTRY_NAVY, true, craneModel)
createPart("GantryBeam_L", Vector3.new(2.8, 2.4, 14), CFrame.new(-14, 15, -135), Enum.Material.Metal, GANTRY_WHITE, true, craneModel)
createPart("GantryBeam_R", Vector3.new(2.8, 2.4, 14), CFrame.new(14, 15, -135), Enum.Material.Metal, GANTRY_WHITE, true, craneModel)

-- Bandes lumineuses néon cyan sur les portiques
createPart("GantryNeon_L", Vector3.new(0.3, 14, 0.3), CFrame.new(-12.7, 8, -130), Enum.Material.Neon, GANTRY_CYAN, false, craneModel)
createPart("GantryNeon_R", Vector3.new(0.3, 14, 0.3), CFrame.new(12.7, 8, -130), Enum.Material.Neon, GANTRY_CYAN, false, craneModel)

-- Pupitre de commande / Timonerie maritime au centre
local craneConsole = createPart("CraneControlConsole", Vector3.new(3.6, 3.2, 2.2), CFrame.new(0, 2.6, -128), Enum.Material.Metal, GANTRY_NAVY, true, craneModel)
local consoleScreen = createPart("ConsoleScreen", Vector3.new(2.8, 1.4, 0.2), craneConsole.CFrame * CFrame.new(0, 0.6, 1.1), Enum.Material.Neon, GANTRY_CYAN, false, craneModel)

local cranePrompt = Instance.new("ProximityPrompt")
cranePrompt.Name = "CraneControlPrompt"
cranePrompt.ActionText = "Pêcher des Voitures 3D"
cranePrompt.ObjectText = "Mode Pêche Maritime 🎣"
cranePrompt.KeyboardKeyCode = Enum.KeyCode.E
cranePrompt.MaxActivationDistance = 14
cranePrompt.HoldDuration = 0
cranePrompt.Parent = craneConsole

-- Câble et Électro-Aimant suspendus au-dessus de l'eau
local winchCable = createPart("WinchCable", Vector3.new(0.35, 18, 0.35), CFrame.new(0, 14, -135), Enum.Material.Metal, Color3.fromRGB(40, 44, 52), false, craneModel)

local craneMagnet = Instance.new("Part")
craneMagnet.Name = "CraneMagnet"
craneMagnet.Shape = Enum.PartType.Cylinder
craneMagnet.Size = Vector3.new(2.5, 7.5, 7.5)
craneMagnet.CFrame = CFrame.new(0, 5.5, -135) * CFrame.Angles(0, 0, math.rad(90))
craneMagnet.Material = Enum.Material.Metal
craneMagnet.Color = GANTRY_NAVY
craneMagnet.Anchored = true
craneMagnet.CanCollide = true
craneMagnet.Parent = craneModel

local magnetRing = createPart("MagnetNeonRing", Vector3.new(6.8, 0.4, 6.8), craneMagnet.CFrame * CFrame.new(-1.1, 0, 0) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Neon, GANTRY_CYAN, false, craneModel)

local magnetLight = Instance.new("PointLight")
magnetLight.Name = "MagnetLight"
magnetLight.Color = GANTRY_CYAN
magnetLight.Brightness = 3.5
magnetLight.Range = 25
magnetLight.Parent = craneMagnet

-- =============================================================================
-- E. LES 6 SPOTS SOUS-MARINS VISIBLES AVEC COLONNES DE LUMIÈRE DANS L'OCÉAN
-- =============================================================================
local underwaterSpotsFolder = Instance.new("Folder")
underwaterSpotsFolder.Name = "UnderwaterSpots"
underwaterSpotsFolder.Parent = docksFolder

local SPOT_DEFS = {
    { Pos = Vector3.new(-22, -37, -125), Color = Color3.fromRGB(40, 230, 90),   Rarity = "Commune",    Label = "🟢 Lotus Rally" },
    { Pos = Vector3.new(22, -37, -125),  Color = Color3.fromRGB(0, 220, 255),   Rarity = "Peu Commune",Label = "🔷 Cyber Truck" },
    { Pos = Vector3.new(-14, -37, -138), Color = Color3.fromRGB(30, 120, 255),  Rarity = "Rare",       Label = "🔵 Drift Supra" },
    { Pos = Vector3.new(14, -37, -138),  Color = Color3.fromRGB(175, 45, 255),  Rarity = "Épique",     Label = "🟣 Police Interceptor" },
    { Pos = Vector3.new(-18, -37, -150), Color = Color3.fromRGB(255, 130, 20),  Rarity = "Légendaire", Label = "🟠 Hyperion JetCar" },
    { Pos = Vector3.new(12, -37, -148),  Color = Color3.fromRGB(255, 215, 0),   Rarity = "Mythique",   Label = "⭐ Flash McQueen ⚡" },
}

for i, spot in ipairs(SPOT_DEFS) do
    local spotModel = Instance.new("Model")
    spotModel.Name = "UnderwaterSpot_" .. i
    spotModel.Parent = underwaterSpotsFolder

    local baseDisc = Instance.new("Part")
    baseDisc.Name = "BaseGlow"
    baseDisc.Shape = Enum.PartType.Cylinder
    baseDisc.Size = Vector3.new(0.8, 10, 10)
    baseDisc.CFrame = CFrame.new(spot.Pos) * CFrame.Angles(0, 0, math.rad(90))
    baseDisc.Material = Enum.Material.Neon
    baseDisc.Color = spot.Color
    baseDisc.Anchored = true
    baseDisc.CanCollide = false
    baseDisc.Parent = spotModel

    local beamHeight = 36
    local lightBeam = Instance.new("Part")
    lightBeam.Name = "LightColumn"
    lightBeam.Shape = Enum.PartType.Cylinder
    lightBeam.Size = Vector3.new(beamHeight, 7, 7)
    lightBeam.CFrame = CFrame.new(spot.Pos.X, spot.Pos.Y + (beamHeight / 2), spot.Pos.Z) * CFrame.Angles(0, 0, math.rad(90))
    lightBeam.Material = Enum.Material.Neon
    lightBeam.Color = spot.Color
    lightBeam.Transparency = 0.76
    lightBeam.Anchored = true
    lightBeam.CanCollide = false
    lightBeam.Parent = spotModel

    local surfaceRing = Instance.new("Part")
    surfaceRing.Name = "SurfaceRing"
    surfaceRing.Shape = Enum.PartType.Cylinder
    surfaceRing.Size = Vector3.new(0.3, 8.5, 8.5)
    surfaceRing.CFrame = CFrame.new(spot.Pos.X, 0.2, spot.Pos.Z) * CFrame.Angles(0, 0, math.rad(90))
    surfaceRing.Material = Enum.Material.Neon
    surfaceRing.Color = spot.Color
    surfaceRing.Transparency = 0.45
    surfaceRing.Anchored = true
    surfaceRing.CanCollide = false
    surfaceRing.Parent = spotModel

    local sLight = Instance.new("PointLight")
    sLight.Color = spot.Color
    sLight.Brightness = 3.0
    sLight.Range = 26
    sLight.Parent = surfaceRing
end

-- =============================================================================
-- F. PORTIQUE D'ENTRÉE DU DÉFI "STOP THE FRAME" (AU DÉBUT DU QUAI À Z = -34)
-- =============================================================================
local gateModel = Instance.new("Model")
gateModel.Name = "StopTheFrameEntryGate"
gateModel.Parent = docksFolder

local GATE_POS_Z = -34
local pillarL = createPart("GatePillar_L", Vector3.new(2.5, 18, 2.5), CFrame.new(-16, 9, GATE_POS_Z), Enum.Material.Metal, Color3.fromRGB(35, 38, 42), true, gateModel)
local pillarR = createPart("GatePillar_R", Vector3.new(2.5, 18, 2.5), CFrame.new(16, 9, GATE_POS_Z), Enum.Material.Metal, Color3.fromRGB(35, 38, 42), true, gateModel)
local crossbeam = createPart("GateCrossbeam", Vector3.new(34, 3, 2.5), CFrame.new(0, 17, GATE_POS_Z), Enum.Material.Metal, Color3.fromRGB(35, 38, 42), true, gateModel)

local neonSign = createPart("NeonSign_StopTheFrame", Vector3.new(30, 2.2, 0.5), CFrame.new(0, 17, GATE_POS_Z + 1.4), Enum.Material.Neon, Color3.fromRGB(255, 225, 0), false, gateModel)

local lightGreen  = createPart("LightGreen", Vector3.new(1.2, 1.2, 0.6), CFrame.new(-5, 14, GATE_POS_Z + 1.3), Enum.Material.Neon, Color3.fromRGB(0, 255, 60), false, gateModel)
local lightYellow = createPart("LightYellow", Vector3.new(1.2, 1.2, 0.6), CFrame.new(0, 14, GATE_POS_Z + 1.3), Enum.Material.Neon, Color3.fromRGB(255, 190, 0), false, gateModel)
local lightRed    = createPart("LightRed", Vector3.new(1.2, 1.2, 0.6), CFrame.new(5, 14, GATE_POS_Z + 1.3), Enum.Material.Neon, Color3.fromRGB(255, 30, 30), false, gateModel)

local raceTerminal = createPart("RaceTerminal", Vector3.new(3, 3.5, 2), CFrame.new(-10, 2.75, GATE_POS_Z - 3), Enum.Material.Metal, Color3.fromRGB(25, 28, 32), true, gateModel)
createPart("TerminalScreen", Vector3.new(2.2, 1.4, 0.2), raceTerminal.CFrame * CFrame.new(0, 0.6, -1.0), Enum.Material.Neon, Color3.fromRGB(255, 230, 60), false, gateModel)

local racePrompt = Instance.new("ProximityPrompt")
racePrompt.Name = "StartRacePrompt"
racePrompt.ActionText = "Lancer le Défi"
racePrompt.ObjectText = "Pente 1v1 Stop the Frame ⚡"
racePrompt.KeyboardKeyCode = Enum.KeyCode.E
racePrompt.MaxActivationDistance = 14
racePrompt.HoldDuration = 0
racePrompt.Parent = raceTerminal

print("[WorldBuilder] Jetée Maritime Tropicale, Lignes Runway Cyan, 6 Podiums Showroom et Station de Pêche initialisés avec succès !")
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="11">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="12">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">CameraController</string>
          <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - MULTI-MODE CAMERA CONTROLLER (CLIENT SCRIPT)
    Gère la caméra selon le mode de jeu actuel :
    - "Hub" (Quai / Port) : Caméra libre à la 3e personne (Custom) sur l'avatar du joueur.
    - "StopTheFrame" (Pari 1v1) : Caméra fixe Scriptable en contre-plongée vers le cadre vert.
    - "Crane" (Mode Pêche) : Caméra aérienne Scriptable surplombant la grue et le bassin aquatique.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera or Workspace:WaitForChild("Camera") :: Camera

-- Mode par défaut : Hub (Marche libre sur le quai)
if not player:GetAttribute("CurrentMode") then
    player:SetAttribute("CurrentMode", "Hub")
end

-- Paramètres géométriques de la pente San Francisco
local slopeVector = Vector3.new(0, 120, 400)
local uDir = slopeVector.Unit
local rightVec = Vector3.new(1, 0, 0)
local normalVec = uDir:Cross(rightVec)

-- Calcul de la CFrame de caméra fixe pour le mode "StopTheFrame"
local fixedSlopeCameraCFrame: CFrame? = nil

local function computeSlopeCameraCFrame(): CFrame
    local currentTarget = Workspace:FindFirstChild("TargetFrame")
    local cp = currentTarget and currentTarget:FindFirstChild("CenterPoint") :: BasePart?
    local targetPos = (cp and cp.Position) or Vector3.new(0, 66.84, 158.22)

    local roadBasePos = targetPos - (uDir * 20)
    local eyePos = roadBasePos - (normalVec * 0.4)
    local lookTarget = targetPos + (normalVec * 0.3)

    return CFrame.lookAt(eyePos, lookTarget)
end

-- CFrame de la caméra pour le Mode Pêche (vue haute derrière la grue)
local craneCameraCFrame = CFrame.lookAt(Vector3.new(0, 38, -78), Vector3.new(0, 6, -125))

-- Gestion des contrôles du joueur
local playerControls: any = nil
local function setupPlayerControls()
    local playerScripts = player:WaitForChild("PlayerScripts")
    local playerModule = playerScripts:WaitForChild("PlayerModule", 5)
    if playerModule then
        local success, controls = pcall(function()
            local module = require(playerModule) :: any
            return module:GetControls()
        end)
        if success and controls then
            playerControls = controls
        end
    end
end
task.spawn(setupPlayerControls)

local function setPlayerControlsEnabled(enabled: boolean)
    if playerControls then
        if enabled and playerControls.Enable then
            playerControls:Enable()
        elseif not enabled and playerControls.Disable then
            playerControls:Disable()
        end
    end
end

-- Mise à jour du mode de caméra
local function onModeChanged()
    local mode = tostring(player:GetAttribute("CurrentMode") or "Hub")

    if mode == "Hub" then
        camera.CameraType = Enum.CameraType.Custom
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                camera.CameraSubject = hum
            end
        end
        setPlayerControlsEnabled(true)
        print("[CameraController] Mode Hub actif (Caméra libre 3e personne).")

    elseif mode == "StopTheFrame" then
        camera.CameraType = Enum.CameraType.Scriptable
        fixedSlopeCameraCFrame = computeSlopeCameraCFrame()
        setPlayerControlsEnabled(false)
        print("[CameraController] Mode StopTheFrame actif (Caméra fixe sur la pente).")

    elseif mode == "Crane" then
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = craneCameraCFrame
        setPlayerControlsEnabled(false)
        print("[CameraController] Mode Pêche / Grue actif (Caméra aérienne bassin).")
    end
end

player:GetAttributeChangedSignal("CurrentMode"):Connect(onModeChanged)
task.spawn(onModeChanged)

-- Maintien de la caméra Scriptable pendant les modes actifs
local function onRenderStep()
    local mode = tostring(player:GetAttribute("CurrentMode") or "Hub")

    if mode == "StopTheFrame" then
        camera.CameraType = Enum.CameraType.Scriptable
        if not fixedSlopeCameraCFrame then
            fixedSlopeCameraCFrame = computeSlopeCameraCFrame()
        end
        if fixedSlopeCameraCFrame then
            local shake = camera:GetAttribute("ShakeOffset")
            if shake and typeof(shake) == "Vector3" then
                camera.CFrame = fixedSlopeCameraCFrame * CFrame.new(shake)
            else
                camera.CFrame = fixedSlopeCameraCFrame
            end
        end

    elseif mode == "Crane" then
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = craneCameraCFrame
    end
end

RunService.RenderStepped:Connect(onRenderStep)
print("[CameraController] Multi-mode Camera Controller initialisé avec succès.")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="14">
        <Properties>
          <string name="Name">CraneController</string>
          <string name="Source"><![CDATA[--!strict
--[[
    STOP AT THE FRAME - CRANE CONTROLLER (CLIENT SCRIPT)
    Design System UI "Figma Simulator" & Mode Pêche complet :
    - Déplacement libre de l'aimant au-dessus du bassin aquatique avec ZQSD / Flèches.
    - Rayon laser de visée vertical et réticule de verrouillage des 6 spots sous-marins.
    - Jauge de mini-jeu de pêche timing façon "Fisch" (presser [ESPACE] dans la zone verte).
    - Remontée du câble et attache physique du véhicule 3D à l'électro-aimant.
    - Carte pop-up "VÉHICULE REPÊCHÉ !" façon carte de collection Figma avec animations dynamiques.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
local camera = Workspace.CurrentCamera or Workspace:WaitForChild("Camera") :: Camera

local CarBuilder = require(ReplicatedStorage:WaitForChild("CarBuilder") :: ModuleScript)

-- Remotes
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10) :: Folder?
local deployCraneEvent: RemoteEvent? = nil
local craneHookedEvent: RemoteEvent? = nil
if remotesFolder then
    deployCraneEvent = remotesFolder:WaitForChild("DeployCrane", 10) :: RemoteEvent?
    craneHookedEvent = remotesFolder:WaitForChild("CraneHooked", 10) :: RemoteEvent?
end

-- Récupération de la Grue dans le Workspace
local docks = Workspace:WaitForChild("SanFranciscoDocks", 15) :: Folder?
local craneModel = (docks and docks:WaitForChild("IndustrialFishingCrane", 15)) :: Model?
local craneMagnet = (craneModel and craneModel:WaitForChild("CraneMagnet", 10)) :: BasePart?
local magnetRing = (craneModel and craneModel:FindFirstChild("MagnetNeonRing")) :: BasePart?
local winchCable = (craneModel and craneModel:WaitForChild("WinchCable", 10)) :: BasePart?

local MAGNET_REST_Y = 5.5
local MAGNET_WATER_Y = -0.5
local MAGNET_DEEP_Y = -33.0

-- Sons SFX pour la Grue
local sfxFolder = SoundService:FindFirstChild("GameSFX") or Instance.new("Folder")
sfxFolder.Name = "GameSFX"
sfxFolder.Parent = SoundService

local function createSound(name: string, id: string, vol: number): Sound
    local s = Instance.new("Sound")
    s.Name = name
    s.SoundId = id
    s.Volume = vol
    s.RollOffMaxDistance = 5000
    s.Parent = sfxFolder
    return s
end

local soundWinch = createSound("SFX_Winch", "rbxasset://sounds/action_swim.mp3", 0.8)
local soundZap   = createSound("SFX_Zap", "rbxasset://sounds/electronicpingshort.wav", 1.0)
local soundCheer = createSound("SFX_Cheer", "rbxasset://sounds/victory.wav", 0.9)
local soundHit   = createSound("SFX_Hit", "rbxasset://sounds/bell.wav", 0.85)

-- =============================================================================
-- FIGMA SIMULATOR UI DESIGN SYSTEM HELPERS
-- =============================================================================
local function styleFigmaCard(frame: Frame, topColor: Color3, bottomColor: Color3, strokeColor: Color3, cornerRadius: number)
    frame.BorderSizePixel = 0
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    frame.ZIndex = math.max(2, frame.ZIndex)

    local shadowName = frame.Name .. "_Shadow"
    local shadow = frame.Parent and frame.Parent:FindFirstChild(shadowName) :: Frame?
    if not shadow and frame.Parent then
        shadow = Instance.new("Frame")
        shadow.Name = shadowName
        shadow.AnchorPoint = frame.AnchorPoint
        shadow.Size = frame.Size
        shadow.Position = frame.Position + UDim2.new(0, 0, 0, 5)
        shadow.BackgroundColor3 = Color3.fromRGB(6, 8, 12)
        shadow.BackgroundTransparency = 0.5
        shadow.BorderSizePixel = 0
        shadow.ZIndex = 1
        shadow.Visible = frame.Visible
        shadow.Parent = frame.Parent

        local shadowCorner = Instance.new("UICorner")
        shadowCorner.CornerRadius = UDim.new(0, cornerRadius)
        shadowCorner.Parent = shadow

        frame:GetPropertyChangedSignal("Position"):Connect(function()
            if shadow then shadow.Position = frame.Position + UDim2.new(0, 0, 0, 5) end
        end)
        frame:GetPropertyChangedSignal("Size"):Connect(function()
            if shadow then shadow.Size = frame.Size end
        end)
        frame:GetPropertyChangedSignal("Visible"):Connect(function()
            if shadow then shadow.Visible = frame.Visible end
        end)
    end

    local corner = frame:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, cornerRadius)
    corner.Parent = frame

    local stroke = frame:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = strokeColor
    stroke.Thickness = 3
    stroke.Transparency = 0
    stroke.Parent = frame

    local gradient = frame:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
    gradient.Rotation = 90
    gradient.Color = ColorSequence.new(topColor, bottomColor)
    gradient.Parent = frame
end

local function animateFigmaButton(button: TextButton | ImageButton)
    local scale = button:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
    scale.Parent = button

    local tweenInfoHover = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local tweenInfoLeave = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tweenInfoPress = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    button.MouseEnter:Connect(function()
        TweenService:Create(scale, tweenInfoHover, { Scale = 1.07 }):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(scale, tweenInfoLeave, { Scale = 1.0 }):Play()
    end)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(scale, tweenInfoPress, { Scale = 0.92 }):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(scale, tweenInfoHover, { Scale = 1.07 }):Play()
    end)
end

