# ==============================================================================
# STOP AT THE FRAME - CONFIGURATION ET CLÉS D'APIS (EXEMPLE)
# Copiez ce fichier sous le nom '.env' et complétez avec vos clés réelles.
# ==============================================================================

# Clé Principale Google AI Studio
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEY_BACKUP=YOUR_BACKUP_KEY_HERE

# Groq Cloud API
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# ComfyUI Local Server (RTX 5070)
COMFYUI_URL=http://127.0.0.1:8188

# Vertex AI / GCP Service Account JSON (Chemin absolu ou contenu)
GOOGLE_APPLICATION_CREDENTIALS=vertex_service_account.json
