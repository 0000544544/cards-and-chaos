					<R>0.9</R>
					<G>0.1</G>
					<B>0.1</B>
				</Color3>
				<float name="Transparency">0</float>
				<Vector3 name="size">
					<X>6.2</X>
					<Y>1.2</Y>
					<Z>11.6</Z>
				</Vector3>
			</Properties>
			<Item class="SpecialMesh" referent="RBX_OFFICIAL_MESH">
				<Properties>
					<string name="Name">Mesh</string>
					<Content name="MeshId"><url>rbxassetid://785847639</url></Content>
					<token name="MeshType">5</token>
					<Vector3 name="Scale">
						<X>3.456</X>
						<Y>3.456</Y>
						<Z>3.456</Z>
					</Vector3>
					<Content name="TextureId"><url>rbxassetid://785848960</url></Content>
				</Properties>
			</Item>
		</Item>

