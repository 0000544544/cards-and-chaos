			<token name="ModelStreamingMode">0</token>
			<bool name="NeedsPivotMigration">false</bool>
		</Properties>

		<!-- Visual Textured 3D Mesh Part (Official Disney/Pixar Lightning McQueen) -->
		<Item class="Part" referent="RBX_BODY_VISUAL">
			<Properties>
				<string name="Name">VisualMesh</string>
				<bool name="Anchored">true</bool>
				<bool name="CanCollide">false</bool>
