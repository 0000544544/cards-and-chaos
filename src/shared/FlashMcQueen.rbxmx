					<X>0</X>
					<Y>0.15</Y>
					<Z>-0.6</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
