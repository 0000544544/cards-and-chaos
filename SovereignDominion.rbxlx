      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">NetworkEvents</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - RÉSEAU RPC & REMOTES (CLIENT / SERVEUR)
    Contrat unique des RemoteFunctions et RemoteEvents.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RemoteFunctions = {
    "GetPlayerData",
    "RequestOpenPack",
    "EquipCard",
    "GetMarketListings",
    "ListMarketItem",
    "BuyMarketItem",
    "ClaimRankReward",
    "JoinArenaQueue",
    "LeaveArenaQueue",
    "TalkToNPC",
}

local RemoteEvents = {
    "CastSpell",            -- Déclenchement d'un sort ou du dash (Slot 1-5 + TargetPos)
    "ToastNotify",          -- Notifications de feedback joueur (Succès/Erreur)
    "ServerAnnouncement",   -- Alerte mondiale (Tirage Légendaire, etc.)
    "MatchStateChanged",    -- États du duel d'arène (VS, Countdown, Fight, Victory, Defeat)
}

local NetworkEvents = {}

local function GetFolder(): Folder
    local folder = ReplicatedStorage:FindFirstChild("NetworkRemotes") :: Folder?
    if not folder then
        if RunService:IsServer() then
            folder = Instance.new("Folder")
            folder.Name = "NetworkRemotes"
            folder.Parent = ReplicatedStorage
        else
            folder = ReplicatedStorage:WaitForChild("NetworkRemotes", 10) :: Folder
        end
    end
    return folder :: Folder
end

function NetworkEvents.InitServer()
    local folder = GetFolder()
    for _, name in ipairs(RemoteFunctions) do
        if not folder:FindFirstChild(name) then
            local rf = Instance.new("RemoteFunction")
            rf.Name = name
            rf.Parent = folder
        end
    end
    for _, name in ipairs(RemoteEvents) do
        if not folder:FindFirstChild(name) then
            local re = Instance.new("RemoteEvent")
            re.Name = name
            re.Parent = folder
        end
    end
end

function NetworkEvents.GetFunction(name: string): RemoteFunction
    local folder = GetFolder()
    local rf = folder:WaitForChild(name, 10)
    assert(rf and rf:IsA("RemoteFunction"), "RemoteFunction absente : " .. name)
    return rf :: RemoteFunction
end

function NetworkEvents.GetEvent(name: string): RemoteEvent
    local folder = GetFolder()
    local re = folder:WaitForChild(name, 10)
    assert(re and re:IsA("RemoteEvent"), "RemoteEvent absent : " .. name)
    return re :: RemoteEvent
end

return NetworkEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">PackConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - CONFIGURATION DES PACKS DE GACHA
    Probabilités de tirage transparentes (Conformes aux règles Roblox de Gambling éthique).
]]

export type PackDefinition = {
    Id: string,
    Name: string,
    CostCoins: number,
    Description: string,
    Weights: { [string]: number },
    DisplayOdds: string,
    Color: Color3,
}

local Packs: { [string]: PackDefinition } = {
    ["pack_souverain"] = {
        Id = "pack_souverain",
        Name = "Pack Souverain",
        CostCoins = 250,
        Description = "Pack équilibré contenant des sorts de la Garde Souveraine.",
        Weights = {
            Common = 600,      -- 60%
            Rare = 250,        -- 25%
            Epic = 110,        -- 11%
            Legendary = 40,    -- 4%
        },
        DisplayOdds = "Commun: 60% | Rare: 25% | Épique: 11% | Légendaire: 4%",
        Color = Color3.fromRGB(79, 70, 229),
    },
    ["pack_chaos"] = {
        Id = "pack_chaos",
        Name = "Pack Chaos Mythique",
        CostCoins = 1000,
        Description = "Pack haut de gamme avec chances décuplées de sorts Épiques et Légendaires !",
        Weights = {
            Common = 200,      -- 20%
            Rare = 450,        -- 45%
            Epic = 250,        -- 25%
            Legendary = 100,   -- 10%
        },
        DisplayOdds = "Commun: 20% | Rare: 45% | Épique: 25% | Légendaire: 10%",
        Color = Color3.fromRGB(217, 70, 239),
    },
}

local PityRules = {
    MaxPacksWithoutLegendary = 50, -- 1 Légendaire garanti au 50ème tirage
}

return {
    Packs = Packs,
    Pity = PityRules,
    GetPack = function(packId: string): PackDefinition?
        return Packs[packId]
    end,
}
]]></string>
