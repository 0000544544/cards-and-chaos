  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
    SOVEREIGN: CARDS & DOMINION - SERVEUR PRINCIPAL
    Point d'entrée du serveur : initialise le réseau RPC, l'environnement 3D procédural,
    la persistance des données et l'ensemble des sous-systèmes de jeu.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Network = require(ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.DataManager)
local PlayerInventoryManager = require(script.PlayerInventoryManager)
local GachaSystem = require(script.GachaSystem)
local MapBuilder = require(script.MapBuilder)
local GachaManager = require(script.GachaManager)
local MarketManager = require(script.MarketManager)
local TradeManager = require(script.TradeManager)
local ArenaManager = require(script.ArenaManager)
local CombatService = require(script.CombatService)
local MeritManager = require(script.MeritManager)

print("========================================================")
print("  CARDS & CHAOS - SERVEUR ROBLOX (LUAU)")
print("  Initialisation de l'infrastructure...")
print("========================================================")

-- 1. Initialisation de la couche réseau
Network.InitServer()

-- 2. Construction de la carte (Hub & Arène céleste)
MapBuilder.BuildEnvironment()

-- 3. Initialisation des gestionnaires centraux
PlayerInventoryManager.Init()
GachaSystem.Init()
DataManager.Init()
GachaManager.Init()
MarketManager.Init()
TradeManager.Init()
ArenaManager.Init()
CombatService.Init()
MeritManager.Init()

-- 3.5 Initialisation des Outils Développeur / Mode Test Studio
local CardUtils = require(ReplicatedStorage.Shared.CardUtils)
local devActionRF = Network.GetFunction("DevAction")
devActionRF.OnServerInvoke = function(player: Player, actionName: any)
    local profile = DataManager.GetProfile(player)
    if not profile then return { Success = false } end

    if actionName == "AddCoins" then
        profile.Coins += 5000
        return { Success = true, Message = "+5,000 Or ajoutés !" }
    elseif actionName == "AddMerit" then
        profile.Merit += 500
        return { Success = true, Message = "+500 Mérite ajoutés !" }
    elseif actionName == "GiveDivine" then
        local divineCard = CardUtils.CreateCardInstance("primordial_severance", true)!
        table.insert(profile.Inventory, divineCard)
        return { Success = true, Message = "✨ Carte Divine 'Fracture Primordiale' ajoutée à votre inventaire !" }
    elseif actionName == "StartBot" then
        ArenaManager.StartBotMatch(player)
        return { Success = true, Message = "Duel contre le Spectre du Champion lancé !" }
    end
    return { Success = false }
end

-- 4. Écouteurs de connexion des joueurs
Players.PlayerAdded:Connect(function(player: Player)
    print("[Server] Connexion de " .. player.Name .. " (ID: " .. player.UserId .. ")")
    local legacyProfile = DataManager.LoadData(player)
    local chaosProfile = PlayerInventoryManager.LoadProfile(player)

    player.CharacterAdded:Connect(function(character: Model)
        local hum = character:WaitForChild("Humanoid") :: Humanoid
        hum.MaxHealth = 100
        hum.Health = 100

        -- Application des bonus passifs équipés (PV max, vitesse)
        for _, passUid in ipairs(legacyProfile.EquippedDeck.Passives) do
            for _, card in ipairs(legacyProfile.Inventory) do
                if card.UniqueId == passUid then
                    if card.CardId == "vitality_surge" then
                        hum.MaxHealth += 50
                        hum.Health = hum.MaxHealth
                    elseif card.CardId == "swift_reflexes" then
                        hum.WalkSpeed = 20
                    end
                end
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player: Player)
    print("[Server] Déconnexion de " .. player.Name)
    DataManager.ReleaseProfile(player)
    PlayerInventoryManager.ReleaseProfile(player)
end)

game:BindToClose(function()
    print("[Server] Arrêt du serveur : sauvegarde d'urgence de tous les profils...")
    for _, player in ipairs(Players:GetPlayers()) do
        DataManager.SaveData(player)
        PlayerInventoryManager.SaveProfile(player)
    end
end)

print("[Server] Serveur prêt ! Toutes les boucles de jeu sont actives.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">ArenaManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    ARENA MANAGER (COMPÉTITION 1V1, MATCHMAKING & CLASSEMENT ELO)
    Gestion des files d'attente compétitives, téléportation dans le Colisée Céleste,
    déroulement du duel, calcul Elo (K=32), attribution du Mérite et anti-abandon.
]]

local Players = game:GetService("Players")

local RankConfig = require(game.ReplicatedStorage.Shared.RankConfig)
local Network = require(game.ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

export type ActiveMatch = {
    Player1: Player,
    Player2: Player,
    StartTime: number,
    RoundTimeLimit: number,
    MatchThread: thread?,
    IsActive: boolean,
}

local ArenaManager = {}
local Queue: { Player } = {}
local CurrentMatches: { [string]: ActiveMatch } = {}

-- Coordonnées par défaut de l'arène (construits par MapBuilder)
local ARENA_SPAWN_1 = Vector3.new(0, 105, 45)
local ARENA_SPAWN_2 = Vector3.new(0, 105, -45)
local LOBBY_SPAWN = Vector3.new(0, 5, 0)

-- Rejoindre la file d'attente
function ArenaManager.JoinQueue(player: Player): { Success: boolean, Message: string }
    for _, p in ipairs(Queue) do
        if p == player then
            return { Success = false, Message = "Déjà dans la file d'attente." }
        end
    end

    table.insert(Queue, player)
    
    -- Si le joueur est seul sur le serveur (ex: test solo en Studio), duel automatique contre l'IA du Colisée !
    if #Players:GetPlayers() == 1 then
        table.remove(Queue, 1)
        task.delay(0.5, function()
            ArenaManager.StartBotMatch(player)
        end)
        return { Success = true, Message = "Aucun joueur en ligne : Lancement du duel contre le Spectre du Champion (IA) !" }
    end

    ArenaManager.CheckQueue()
    return { Success = true, Message = "Recherche d'un adversaire..." }
end

-- Démarrage d'un duel contre un Bot IA d'entraînement
function ArenaManager.StartBotMatch(player: Player)
    local prof = DataManager.GetProfile(player)
    if not prof then return end

    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid") :: Humanoid
    local hrp = char:WaitForChild("HumanoidRootPart") :: BasePart

    -- Création du Bot de Combat
    local botModel = Instance.new("Model")
    botModel.Name = "Spectre_du_Champion"
    botModel.Parent = workspace

    local botHrp = Instance.new("Part")
    botHrp.Name = "HumanoidRootPart"
    botHrp.Size = Vector3.new(2, 2, 1)
    botHrp.CFrame = CFrame.lookAt(ARENA_SPAWN_2, ARENA_SPAWN_1)
    botHrp.CanCollide = false
    botHrp.Parent = botModel

    local botTorso = Instance.new("Part")
    botTorso.Name = "Torso"
    botTorso.Size = Vector3.new(2, 2.5, 1)
    botTorso.Position = ARENA_SPAWN_2
    botTorso.Material = Enum.Material.Neon
    botTorso.Color = Color3.fromRGB(168, 85, 247)
    botTorso.Parent = botModel

    local botHead = Instance.new("Part")
    botHead.Name = "Head"
    botHead.Shape = Enum.PartType.Ball
    botHead.Size = Vector3.new(1.6, 1.6, 1.6)
    botHead.Position = ARENA_SPAWN_2 + Vector3.new(0, 2, 0)
    botHead.Material = Enum.Material.Neon
    botHead.Color = Color3.fromRGB(250, 204, 21)
    botHead.Parent = botModel

    local botHum = Instance.new("Humanoid")
    botHum.MaxHealth = 150
    botHum.Health = 150
    botHum.Parent = botModel
    botModel.PrimaryPart = botHrp

    -- Téléportation du joueur dans l'arène
    hrp.CFrame = CFrame.lookAt(ARENA_SPAWN_1, ARENA_SPAWN_2)
    hum.Health = hum.MaxHealth
    hum.WalkSpeed = 0

    local matchStateEv = Network.GetEvent("MatchStateChanged")
    matchStateEv:FireClient(player, { State = "VS", OpponentName = "Spectre du Champion (IA)", OpponentElo = 1250, OpponentRank = "Or" })

    task.spawn(function()
        for count = 3, 1, -1 do
            matchStateEv:FireClient(player, { State = "Countdown", Value = count })
            task.wait(1)
        end
        matchStateEv:FireClient(player, { State = "Fight" })
        hum.WalkSpeed = 16

        local isFightActive = true
        local timer = 90

        -- Boucle IA du bot
        local botLoop = task.spawn(function()
            while isFightActive and botHum.Health > 0 and hum.Health > 0 do
                task.wait(1.5)
                if hrp and botHrp then
                    botHum:MoveTo(hrp.Position)
                    local dist = (hrp.Position - botHrp.Position).Magnitude
                    if dist <= 14 then
                        hum:TakeDamage(16)
                        local combatVfx = Network.GetEvent("CombatVFX")
                        combatVfx:FireAllClients({
                            Position = hrp.Position,
                            Color = Color3.fromRGB(168, 85, 247),
                        })
                    end
                end
            end
        end)

        while timer > 0 and isFightActive do
            task.wait(1)
            timer -= 1
            matchStateEv:FireClient(player, { State = "Timer", TimeLeft = timer, MyHP = hum.Health, OpponentHP = botHum.Health })
            if hum.Health <= 0 or botHum.Health <= 0 then
                break
            end
        end

        isFightActive = false
        task.cancel(botLoop)

        local isWin = (botHum.Health <= 0) or (hum.Health > botHum.Health)
        if isWin then
            local meritGain = 35
            prof.Merit += meritGain
            prof.Coins += 200
            prof.Elo = math.max(0, prof.Elo + 25)
            prof.Rank = RankConfig.GetTierFromElo(prof.Elo).Name
            prof.Stats.Wins += 1
            prof.Stats.CurrentStreak += 1

            matchStateEv:FireClient(player, {
                State = "Victory",
                EloDelta = 25,
                NewElo = prof.Elo,
                MeritGained = meritGain,
                CoinsGained = 200,
                Streak = prof.Stats.CurrentStreak,
            })
        else
            prof.Merit += 5
            prof.Stats.CurrentStreak = 0
            matchStateEv:FireClient(player, {
                State = "Defeat",
                EloDelta = -15,
                NewElo = prof.Elo,
                MeritGained = 5,
                CoinsGained = 50,
            })
        end

        task.delay(4, function()
            botModel:Destroy()
            if char and char:FindFirstChild("HumanoidRootPart") then
                (char.HumanoidRootPart :: BasePart).CFrame = CFrame.new(LOBBY_SPAWN)
            end
        end)
    end)
end

-- Quitter la file d'attente
function ArenaManager.LeaveQueue(player: Player): { Success: boolean }
    for i, p in ipairs(Queue) do
        if p == player then
            table.remove(Queue, i)
            return { Success = true }
        end
    end
    return { Success = false }
end

-- Vérification de la file et appariement Elo
function ArenaManager.CheckQueue()
    if #Queue < 2 then return end

    -- Appariement des deux premiers joueurs disponibles
    local p1 = table.remove(Queue, 1)!
    local p2 = table.remove(Queue, 1)!

    if not p1 or not p2 or not p1.Parent or not p2.Parent then return end

    ArenaManager.StartMatch(p1, p2)
end

-- Démarrage d'un duel
function ArenaManager.StartMatch(p1: Player, p2: Player)
    local prof1 = DataManager.GetProfile(p1)
    local prof2 = DataManager.GetProfile(p2)
    if not prof1 or not prof2 then return end

    local char1 = p1.Character or p1.CharacterAdded:Wait()
    local char2 = p2.Character or p2.CharacterAdded:Wait()

    local hum1 = char1:WaitForChild("Humanoid") :: Humanoid
    local hum2 = char2:WaitForChild("Humanoid") :: Humanoid
    local hrp1 = char1:WaitForChild("HumanoidRootPart") :: BasePart
    local hrp2 = char2:WaitForChild("HumanoidRootPart") :: BasePart

    -- Téléportation dans le Colisée
    hrp1.CFrame = CFrame.lookAt(ARENA_SPAWN_1, ARENA_SPAWN_2)
    hrp2.CFrame = CFrame.lookAt(ARENA_SPAWN_2, ARENA_SPAWN_1)

    -- Soins complets
    hum1.Health = hum1.MaxHealth
    hum2.Health = hum2.MaxHealth

    -- Immobilisation pendant le compte à rebours
    hum1.WalkSpeed = 0
    hum2.WalkSpeed = 0

    local matchStateEv = Network.GetEvent("MatchStateChanged")
    matchStateEv:FireClient(p1, { State = "VS", OpponentName = p2.Name, OpponentElo = prof2.Elo, OpponentRank = prof2.Rank })
    matchStateEv:FireClient(p2, { State = "VS", OpponentName = p1.Name, OpponentElo = prof1.Elo, OpponentRank = prof1.Rank })

    local matchId = p1.UserId .. "_" .. p2.UserId
    local activeMatch: ActiveMatch = {
        Player1 = p1,
        Player2 = p2,
        StartTime = os.time(),
        RoundTimeLimit = 90,
        IsActive = true,
    }
    CurrentMatches[matchId] = activeMatch

    activeMatch.MatchThread = task.spawn(function()
        -- Compte à rebours 3, 2, 1
        for count = 3, 1, -1 do
            matchStateEv:FireClient(p1, { State = "Countdown", Value = count })
            matchStateEv:FireClient(p2, { State = "Countdown", Value = count })
            task.wait(1)
        end

        matchStateEv:FireClient(p1, { State = "Fight" })
        matchStateEv:FireClient(p2, { State = "Fight" })

        -- Déblocage de la mobilité
        hum1.WalkSpeed = 16
        hum2.WalkSpeed = 16

        -- Boucle de combat (max 90 secondes)
        local timer = 90
        while timer > 0 and activeMatch.IsActive do
            task.wait(1)
            timer -= 1
            matchStateEv:FireClient(p1, { State = "Timer", TimeLeft = timer, MyHP = hum1.Health, OpponentHP = hum2.Health })
            matchStateEv:FireClient(p2, { State = "Timer", TimeLeft = timer, MyHP = hum2.Health, OpponentHP = hum1.Health })

            if hum1.Health <= 0 or hum2.Health <= 0 then
                break
            end
        end

        if activeMatch.IsActive then
            -- Détermination du vainqueur
            local winner = (hum1.Health > hum2.Health) and p1 or p2
            local loser = (winner == p1) and p2 or p1
            ArenaManager.EndMatch(matchId, winner, loser)
        end
    end)
end

-- Clôture du match et redistribution des points
function ArenaManager.EndMatch(matchId: string, winner: Player, loser: Player)
    local match = CurrentMatches[matchId]
    if not match or not match.IsActive then return end
    match.IsActive = false
    CurrentMatches[matchId] = nil

    local profWin = DataManager.GetProfile(winner)
    local profLose = DataManager.GetProfile(loser)
    if not profWin or not profLose then return end

    -- Calcul du delta Elo
    local deltaWin, deltaLose = RankConfig.CalculateEloDelta(profWin.Elo, profLose.Elo, 1)

    profWin.Elo = math.max(0, profWin.Elo + deltaWin)
    profLose.Elo = math.max(0, profLose.Elo + deltaLose)

    profWin.Rank = RankConfig.GetTierFromElo(profWin.Elo).Name
    profLose.Rank = RankConfig.GetTierFromElo(profLose.Elo).Name

    -- Calcul des gains de Mérite (Bonus de série inclus)
    profWin.Stats.CurrentStreak += 1
    if profWin.Stats.CurrentStreak > profWin.Stats.BestStreak then
        profWin.Stats.BestStreak = profWin.Stats.CurrentStreak
    end
    profLose.Stats.CurrentStreak = 0

    local streakBonus = math.min(RankConfig.Rewards.MaxStreakBonus, (profWin.Stats.CurrentStreak - 1) * RankConfig.Rewards.StreakBonusPerWin)
    local totalWinMerit = RankConfig.Rewards.BaseWinMerit + streakBonus
    local totalLoseMerit = RankConfig.Rewards.BaseLossMerit

    profWin.Merit += totalWinMerit
    profLose.Merit += totalLoseMerit

    profWin.Coins += RankConfig.Rewards.BaseWinCoins
    profLose.Coins += RankConfig.Rewards.BaseLossCoins

    profWin.Stats.Wins += 1
    profLose.Stats.Losses += 1

    local matchStateEv = Network.GetEvent("MatchStateChanged")
    matchStateEv:FireClient(winner, {
        State = "Victory",
        EloDelta = deltaWin,
        NewElo = profWin.Elo,
        MeritGained = totalWinMerit,
        CoinsGained = RankConfig.Rewards.BaseWinCoins,
        Streak = profWin.Stats.CurrentStreak,
    })
    matchStateEv:FireClient(loser, {
        State = "Defeat",
        EloDelta = deltaLose,
        NewElo = profLose.Elo,
        MeritGained = totalLoseMerit,
        CoinsGained = RankConfig.Rewards.BaseLossCoins,
    })

    -- Téléportation retour au Hub après 5 secondes
    task.delay(5, function()
        if winner.Character and winner.Character:FindFirstChild("HumanoidRootPart") then
            (winner.Character.HumanoidRootPart :: BasePart).CFrame = CFrame.new(LOBBY_SPAWN)
        end
        if loser.Character and loser.Character:FindFirstChild("HumanoidRootPart") then
            (loser.Character.HumanoidRootPart :: BasePart).CFrame = CFrame.new(LOBBY_SPAWN)
        end
    end)
end

function ArenaManager.Init()
    local joinRF = Network.GetFunction("JoinArenaQueue")
    joinRF.OnServerInvoke = function(player: Player)
        return ArenaManager.JoinQueue(player)
    end

    local leaveRF = Network.GetFunction("LeaveArenaQueue")
    leaveRF.OnServerInvoke = function(player: Player)
        return ArenaManager.LeaveQueue(player)
    end

    Players.PlayerRemoving:Connect(function(player: Player)
        ArenaManager.LeaveQueue(player)
        for id, match in pairs(CurrentMatches) do
            if match.Player1 == player then
                ArenaManager.EndMatch(id, match.Player2, player)
            elseif match.Player2 == player then
                ArenaManager.EndMatch(id, match.Player1, player)
            end
        end
    end)
end

return ArenaManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    COMBAT SERVICE (VALIDATION SERVEUR, HITBOXES, PARRY & I-FRAMES)
    Exécution sécurisée côté serveur des cartes de compétences, calcul des hitboxes,
    système de parade (Parry timing 0.3s) récompensant le mérite, esquive (Dash I-frame) et statuts.
]]

local Players = game:GetService("Players")

local CardsData = require(game.ReplicatedStorage.Shared.CardsData)
local CardUtils = require(game.ReplicatedStorage.Shared.CardUtils)
local Network = require(game.ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

export type CombatState = {
    LastSkillCastTimes: { [string]: number },
    IsParrying: boolean,
    ParryWindowEnd: number,
    IsDashing: boolean,
    DashIFrameEnd: number,
    LastDashTime: number,
}

local CombatService = {}
local PlayerStates: { [Player]: CombatState } = {}

local function GetCombatState(player: Player): CombatState
    if not PlayerStates[player] then
        PlayerStates[player] = {
            LastSkillCastTimes = {},
            IsParrying = false,
            ParryWindowEnd = 0,
            IsDashing = false,
            DashIFrameEnd = 0,
            LastDashTime = 0,
        }
    end
    return PlayerStates[player]
end

-- Exécution d'une compétence
function CombatService.CastSkill(player: Player, slotIndex: number)
    local profile = DataManager.GetProfile(player)
    if not profile then return end

    local cardUniqueId = profile.EquippedDeck.Actives[slotIndex]
    if not cardUniqueId then return end

    -- Retrouver l'instance de la carte
    local cardInstance: CardUtils.CardInstance? = nil
    for _, c in ipairs(profile.Inventory) do
        if c.UniqueId == cardUniqueId then
            cardInstance = c
            break
        end
    end
    if not cardInstance then return end

    local def = CardsData.GetCard(cardInstance.CardId)
    if not def or def.Type ~= "Active" then return end

    local state = GetCombatState(player)
    local now = os.clock()
    local lastCast = state.LastSkillCastTimes[cardInstance.CardId] or 0

    -- Vérification anti-spam du temps de recharge
    local actualCooldown = def.Cooldown or 3
    if (now - lastCast) < (actualCooldown - 0.1) then
        return
    end
    state.LastSkillCastTimes[cardInstance.CardId] = now

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not hrp then return end

    -- Calcul des stats réelles (Prestige, Rareté, Mérite)
    local stats = CardUtils.ComputeCardStats(cardInstance, profile.Merit)!
    local baseDamage = stats.Damage
    local range = stats.Range or 20

    -- Broadcast visuel des particules / animations
    local combatVfx = Network.GetEvent("CombatVFX")
    combatVfx:FireAllClients({
        Caster = player,
        CardId = cardInstance.CardId,
        Position = hrp.Position,
        Direction = hrp.CFrame.LookVector,
        Color = def.VFXColor or Color3.fromRGB(255, 255, 255),
    })

    -- Détection de hitbox (Spatial Query)
    local center = hrp.Position + (hrp.CFrame.LookVector * (range * 0.4))
    local hitTargets = workspace:GetPartBoundsInRadius(center, range * 0.6)

    local alreadyHit: { [Model]: boolean } = {}
    for _, part in ipairs(hitTargets) do
        local targetModel = part:FindFirstAncestorOfClass("Model")
        if targetModel and targetModel ~= char and not alreadyHit[targetModel] then
            alreadyHit[targetModel] = true
            local targetHum = targetModel:FindFirstChildOfClass("Humanoid")
            local targetPlayer = Players:GetPlayerFromCharacter(targetModel)

            if targetHum and targetHum.Health > 0 then
                -- Vérification des I-frames (Dash)
                if targetPlayer then
                    local targetState = GetCombatState(targetPlayer)
                    if now < targetState.DashIFrameEnd then
                        -- L'adversaire a esquivé parfaitement !
                        continue
                    end

                    -- Vérification du PARRY (0.3s)
                    if now < targetState.ParryWindowEnd then
                        -- PARADE PARFAITE ! Le défenseur contre-attaque
                        combatVfx:FireAllClients({
                            Type = "ParrySuccess",
                            Position = part.Position,
                        })

                        -- L'attaquant subit un contrecoup / stun
                        local myHum = char:FindFirstChildOfClass("Humanoid")
                        if myHum then
                            myHum:TakeDamage(15)
                        end

                        -- Récompense de Mérite pour le timing chirurgical
                        DataManager.AddMerit(targetPlayer, 15)
                        local toast = Network.GetEvent("ToastNotify")
                        toast:FireClient(targetPlayer, "✨ PARADE PARFAITE ! (+15 Mérite)")
                        return
                    end
                end

                -- Application des dégâts
                targetHum:TakeDamage(baseDamage)

                -- Émission du chiffre de dégâts 3D
                local damageEv = Network.GetEvent("DamageIndicator")
                damageEv:FireAllClients({
                    Position = part.Position + Vector3.new(0, 2.5, 0),
                    Damage = baseDamage,
                    IsPrestige = stats.Prestige,
                    Color = stats.Prestige and Color3.fromRGB(250, 204, 21) or (def.VFXColor or Color3.fromRGB(255, 255, 255)),
                })

                -- Effet passif de Vol de Vie si équipé
                for _, passUid in ipairs(profile.EquippedDeck.Passives) do
                    for _, pc in ipairs(profile.Inventory) do
                        if pc.UniqueId == passUid and pc.CardId == "blood_tribute" then
                            local myHum = char:FindFirstChildOfClass("Humanoid")
                            if myHum then
                                myHum.Health = math.min(myHum.MaxHealth, myHum.Health + (baseDamage * 0.15))
                            end
                        end
                    end
                end
            end
        end
    end
end

-- Action spéciale : Dash (Q) ou Parade (F)
function CombatService.PerformAction(player: Player, actionType: string)
    local state = GetCombatState(player)
    local now = os.clock()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not hrp then return end

    if actionType == "Dash" then
        if (now - state.LastDashTime) < 3.0 then return end -- Cooldown dash 3s
        state.LastDashTime = now
        state.DashIFrameEnd = now + 0.35                    -- 0.35s d'invulnérabilité

        -- Propulsion physique
        local look = hrp.CFrame.LookVector
        hrp.AssemblyLinearVelocity = look * 75 + Vector3.new(0, 15, 0)

        local combatVfx = Network.GetEvent("CombatVFX")
        combatVfx:FireAllClients({
            Type = "Dash",
            Position = hrp.Position,
            Direction = look,
        })
    elseif actionType == "Parry" then
        -- Fenêtre de parade active pendant 0.35s
        state.ParryWindowEnd = now + 0.35

        local combatVfx = Network.GetEvent("CombatVFX")
        combatVfx:FireAllClients({
            Type = "ParryStance",
            Player = player,
        })
    end
end

function CombatService.Init()
    local castSkillRE = Network.GetEvent("CastSkill")
    castSkillRE.OnServerEvent:Connect(function(player: Player, slot: any)
        local s = tonumber(slot) or 1
        CombatService.CastSkill(player, s)
    end)

    local actionRE = Network.GetEvent("PerformAction")
    actionRE.OnServerEvent:Connect(function(player: Player, actionType: any)
        CombatService.PerformAction(player, tostring(actionType))
    end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    DATA MANAGER (PROFILES & DATASTORE)
    Sauvegarde persistante des profils joueurs : Cartes, Decks, Monnaie, Mérite, Élo, et Compteurs de Pity.
    Fallback mémoire automatique en local (Studio) si les API DataStore ne sont pas activées.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local CardUtils = require(game.ReplicatedStorage.Shared.CardUtils)
local RankConfig = require(game.ReplicatedStorage.Shared.RankConfig)

local DATA_VERSION = "Sovereign_V1"
local AUTOSAVE_INTERVAL = 60

export type PlayerProfile = {
    Coins: number,
    SoulGems: number,
    Merit: number,
    Elo: number,
    Rank: string,
    Inventory: { CardUtils.CardInstance },
    EquippedDeck: {
        Actives: { string },   -- UniqueIds
        Passives: { string },
    },
    PityCounters: {
        SinceLastEpic: number,
        SinceLastLegendary: number,
        SinceLastMythic: number,
    },
    Stats: {
        TotalRolls: number,
        Wins: number,
        Losses: number,
        CurrentStreak: number,
        BestStreak: number,
        CardsTraded: number,
        MarketSales: number,
    },
}

local DataManager = {}
local Profiles: { [Player]: PlayerProfile } = {}
local SessionStore: DataStore? = nil

-- Initialisation sécurisée du DataStore
local function InitDataStore()
    local success, store = pcall(function()
        return DataStoreService:GetDataStore(DATA_VERSION)
    end)
    if success and store then
        SessionStore = store
    else
        warn("[DataManager] DataStore indisponible (Mode Studio/Offline). Utilisation de la mémoire vive.")
    end
end

-- Création d'un profil par défaut pour les nouveaux joueurs (Deck de départ équilibré)
local function CreateDefaultProfile(): PlayerProfile
    local starterCards = {
        CardUtils.CreateCardInstance("iron_slash")!,
        CardUtils.CreateCardInstance("shadow_step")!,
        CardUtils.CreateCardInstance("flame_bolt")!,
        CardUtils.CreateCardInstance("ice_shard")!,
        CardUtils.CreateCardInstance("vitality_surge")!,
        CardUtils.CreateCardInstance("swift_reflexes")!,
    }

    local defaultDeck = {
        Actives = {
            starterCards[1].UniqueId,
            starterCards[2].UniqueId,
            starterCards[3].UniqueId,
            starterCards[4].UniqueId,
        },
        Passives = {
            starterCards[5].UniqueId,
            starterCards[6].UniqueId,
        },
    }

    return {
        Coins = 1000,         -- 10 rolls gratuits offerts au départ !
        SoulGems = 50,
        Merit = 100,          -- Prime de bienvenue martiale
        Elo = 1000,           -- Cote de base Argent
        Rank = "Silver",
        Inventory = starterCards,
        EquippedDeck = defaultDeck,
        PityCounters = {
            SinceLastEpic = 0,
            SinceLastLegendary = 0,
            SinceLastMythic = 0,
        },
        Stats = {
            TotalRolls = 0,
            Wins = 0,
            Losses = 0,
            CurrentStreak = 0,
            BestStreak = 0,
            CardsTraded = 0,
            MarketSales = 0,
        },
    }
end

function DataManager.GetProfile(player: Player): PlayerProfile?
    return Profiles[player]
end

function DataManager.LoadData(player: Player): PlayerProfile
    local key = "Player_" .. player.UserId
    local profile: PlayerProfile? = nil

    if SessionStore then
        local success, result = pcall(function()
            return SessionStore:GetAsync(key)
        end)
        if success and result and type(result) == "table" then
            profile = result :: PlayerProfile
        end
    end

    if not profile then
        profile = CreateDefaultProfile()
    end

    -- Mise à jour du rang en fonction de l'Elo
    profile.Rank = RankConfig.GetTierFromElo(profile.Elo).Name
    Profiles[player] = profile
    return profile
end

function DataManager.SaveData(player: Player): boolean
    local profile = Profiles[player]
    if not profile then return false end
    if not SessionStore then return true end

    local key = "Player_" .. player.UserId
    local success, err = pcall(function()
        SessionStore:SetAsync(key, profile)
    end)
    if not success then
        warn("[DataManager] Erreur de sauvegarde pour " .. player.Name .. ": " .. tostring(err))
        return false
    end
    return true
end

function DataManager.ReleaseProfile(player: Player)
    DataManager.SaveData(player)
    Profiles[player] = nil
end

function DataManager.AddCoins(player: Player, amount: number)
    local profile = Profiles[player]
    if profile then
        profile.Coins = math.max(0, profile.Coins + amount)
    end
end

function DataManager.AddMerit(player: Player, amount: number)
    local profile = Profiles[player]
    if profile then
        profile.Merit = math.max(0, profile.Merit + amount)
    end
end

-- Démarrage de la boucle d'autosauvegarde
function DataManager.Init()
    InitDataStore()

    task.spawn(function()
        while true do
            task.wait(AUTOSAVE_INTERVAL)
            for _, player in ipairs(Players:GetPlayers()) do
                DataManager.SaveData(player)
            end
        end
    end)
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">GachaManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    GACHA MANAGER (AUTEL DU DESTIN / INVOCATION)
    Système complet de tirage aléatoire pondéré (Gambling), gestion de la Pity,
    boosts de chance et annonces mondiales pour les paliers Légendaire, Mythique et Divin.
]]

local Players = game:GetService("Players")

local CardsData = require(game.ReplicatedStorage.Shared.CardsData)
local RarityConfig = require(game.ReplicatedStorage.Shared.RarityConfig)
local CardUtils = require(game.ReplicatedStorage.Shared.CardUtils)
local Network = require(game.ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

local GachaManager = {}

-- Regroupement des cartes par rareté pour un tirage immédiat
local CardsByRarity: { [string]: { string } } = {
    Common = {},
    Rare = {},
    Epic = {},
    Legendary = {},
    Mythic = {},
    Divine = {},
}

for id, def in pairs(CardsData.Cards) do
    if CardsByRarity[def.Rarity] then
        table.insert(CardsByRarity[def.Rarity], id)
    end
end

-- Tirage d'une rareté en tenant compte de la Pity
local function DetermineRarity(pity: { SinceLastEpic: number, SinceLastLegendary: number, SinceLastMythic: number }): string
    -- 1. Pity Mythique prioritaire
    if pity.SinceLastMythic >= RarityConfig.Pity.MythicGuaranteed then
        return "Mythic"
    end
    -- 2. Pity Légendaire
    if pity.SinceLastLegendary >= RarityConfig.Pity.LegendaryGuaranteed then
        return "Legendary"
    end
    -- 3. Pity Épique
    if pity.SinceLastEpic >= RarityConfig.Pity.EpicGuaranteed then
        return "Epic"
    end

    -- 4. Tirage aléatoire pondéré classique
    local totalWeight = 0
    for _, info in pairs(RarityConfig.Rarities) do
        totalWeight += info.Weight
    end

    local roll = math.random(1, totalWeight)
    local current = 0

    -- On parcourt dans l'ordre de rareté
    local orderedTiers = { "Divine", "Mythic", "Legendary", "Epic", "Rare", "Common" }
    for _, tier in ipairs(orderedTiers) do
        local weight = RarityConfig.Rarities[tier].Weight
        current += weight
        if roll <= current then
            return tier
        end
    end

    return "Common"
end

-- Tirage d'une seule carte
local function RollSingleCard(player: Player, profile: DataManager.PlayerProfile): CardUtils.CardInstance
    local pity = profile.PityCounters
    local rarity = DetermineRarity(pity)

    -- Mise à jour des compteurs de pity
    if rarity == "Divine" or rarity == "Mythic" then
        pity.SinceLastMythic = 0
        pity.SinceLastLegendary = 0
        pity.SinceLastEpic = 0
    elseif rarity == "Legendary" then
        pity.SinceLastLegendary = 0
        pity.SinceLastEpic = 0
        pity.SinceLastMythic += 1
    elseif rarity == "Epic" then
        pity.SinceLastEpic = 0
        pity.SinceLastLegendary += 1
        pity.SinceLastMythic += 1
    else
        pity.SinceLastEpic += 1
        pity.SinceLastLegendary += 1
        pity.SinceLastMythic += 1
    end

    -- Sélection d'une carte au sein de cette rareté
    local candidateList = CardsByRarity[rarity]
    local chosenCardId = candidateList[math.random(1, #candidateList)]
    local newCard = CardUtils.CreateCardInstance(chosenCardId)!

    table.insert(profile.Inventory, newCard)
    profile.Stats.TotalRolls += 1

    -- Annonce mondiale si la carte est Légendaire, Mythique ou Divine !
    local rarityInfo = RarityConfig.Rarities[rarity]
    if rarityInfo and rarityInfo.BroadcastRoll then
        local cardDef = CardsData.GetCard(chosenCardId)!
        local announcementEvent = Network.GetEvent("ServerAnnouncement")
        announcementEvent:FireAllClients({
            PlayerName = player.Name,
            CardName = cardDef.Name,
            Rarity = rarity,
            RarityColor = rarityInfo.Color,
            IsDivine = (rarity == "Divine"),
        })
    end

    return newCard
end

-- Fonction RPC appelée par le client
function GachaManager.HandleRoll(player: Player, count: number): { Success: boolean, Cards: { CardUtils.CardInstance }?, Error: string? }
    local profile = DataManager.GetProfile(player)
    if not profile then
        return { Success = false, Error = "Profil non chargé." }
    end

    local cost = 0
    if count == 1 then
        cost = RarityConfig.Cost.SingleRollCoins
    elseif count == 10 then
        cost = RarityConfig.Cost.MultiRollCoins
    else
        return { Success = false, Error = "Quantité de tirage invalide." }
    end

    if profile.Coins < cost then
        return { Success = false, Error = "Or insuffisant (" .. cost .. " requis)." }
    end

    profile.Coins -= cost

    local results = {}
    for i = 1, count do
        local card = RollSingleCard(player, profile)
        table.insert(results, card)
    end

    return {
        Success = true,
        Cards = results,
    }
end

function GachaManager.Init()
    local rollFunction = Network.GetFunction("RollGacha")
    rollFunction.OnServerInvoke = function(player: Player, count: any)
        local c = tonumber(count) or 1
        return GachaManager.HandleRoll(player, c)
    end
end

return GachaManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">GachaSystem</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - SYSTÈME DE GACHA & PACK OPENING (SERVEUR)
    Tirage aléatoire pondéré conforme aux règles Roblox (transparence des taux),
    protection de Pity anti-malchance, déduction atomique de l'or et sécurité serveur.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardsDatabase = require(ReplicatedStorage.Shared.CardsDatabase)
local PackConfig = require(ReplicatedStorage.Shared.PackConfig)
local Network = require(ReplicatedStorage.Shared.NetworkEvents)
local PlayerInventoryManager = require(script.Parent.PlayerInventoryManager)

export type PackOpenResult = {
    Success: boolean,
    Card: PlayerInventoryManager.CardInstance?,
    RemainingCoins: number?,
    DisplayOdds: string?,
    Error: string?,
}

local GachaSystem = {}

-- =============================================================================
-- LOGIQUE MATHÉMATIQUE DE SÉLECTION DE RARETÉ PONDÉRÉE
-- =============================================================================
local function RollRarity(pack: PackConfig.PackDefinition, pity: { SinceLastLegendary: number, SinceLastEpic: number }): CardsDatabase.CardRarity
    -- 1. Vérification de la Pity Légendaire
    if pity.SinceLastLegendary >= PackConfig.Pity.MaxPacksWithoutLegendary then
        return "Legendary"
    end

    -- 2. Vérification de la Pity Épique
    if pity.SinceLastEpic >= PackConfig.Pity.MaxPacksWithoutEpic and pack.Weights["Epic"] and pack.Weights["Epic"] > 0 then
        return "Epic"
    end

    -- 3. Tirage aléatoire pondéré (Weighted Random)
    local totalWeight = 0
    for _, weight in pairs(pack.Weights) do
        totalWeight += weight
    end

    local roll = math.random(1, totalWeight)
    local cumulative = 0

    local tiersPriority: { CardsDatabase.CardRarity } = { "Legendary", "Epic", "Rare", "Common" }
    for _, tier in ipairs(tiersPriority) do
        local w = pack.Weights[tier] or 0
        cumulative += w
        if roll <= cumulative and w > 0 then
            return tier
        end
    end

    return "Common"
end

-- =============================================================================
-- TRAITEMENT DU TIRAGE D'UN PACK (APPEL DEPUIS LE CLIENT)
-- =============================================================================
function GachaSystem.OpenPack(player: Player, packId: string): PackOpenResult
    local profile = PlayerInventoryManager.GetProfile(player)
    if not profile then
        return { Success = false, Error = "Profil joueur introuvable." }
    end

    local pack = PackConfig.GetPack(packId)
    if not pack then
        return { Success = false, Error = "Ce type de paquet n'existe pas." }
    end

    -- 1. Vérification atomique des fonds côté serveur
    if profile.Coins < pack.CostCoins then
        return {
            Success = false,
            Error = "Or insuffisant. Requis : " .. pack.CostCoins .. " Or (Vous avez : " .. profile.Coins .. " Or).",
        }
    end

    -- 2. Déduction de la monnaie
    local deductOk = PlayerInventoryManager.DeductCoins(player, pack.CostCoins)
    if not deductOk then
        return { Success = false, Error = "Erreur lors de la transaction financière." }
    end

    -- 3. Résolution de la rareté avec Pity
    local pity = profile.PityCounter
    local wonRarity = RollRarity(pack, pity)

    -- 4. Mise à jour des compteurs de malchance
    if wonRarity == "Legendary" then
        pity.SinceLastLegendary = 0
        pity.SinceLastEpic = 0
    elseif wonRarity == "Epic" then
        pity.SinceLastEpic = 0
        pity.SinceLastLegendary += 1
    else
        pity.SinceLastEpic += 1
        pity.SinceLastLegendary += 1
    end

    profile.Stats.PacksOpened += 1

    -- 5. Sélection d'une carte dans cette rareté
    local availableCards = CardsDatabase.CardsByRarity[wonRarity]
    assert(#availableCards > 0, "Aucune carte enregistrée pour la rareté : " .. wonRarity)
    local chosenBlueprint = availableCards[math.random(1, #availableCards)]

    -- 6. Création de l'instance unique et ajout à l'inventaire
    local newCardInstance = PlayerInventoryManager.CreateCardInstance(chosenBlueprint.CardId)!
    PlayerInventoryManager.AddCard(player, newCardInstance)

    -- 7. Alerte serveur globale si la carte est Légendaire (Aura & ElevenLabs Sound Cue)
    if wonRarity == "Legendary" then
        local announcementEvent = Network.GetEvent("ServerAnnouncement")
        announcementEvent:FireAllClients({
            PlayerName = player.Name,
            CardName = newCardInstance.Name,
            Rarity = "Legendary",
            RarityColor = Color3.fromRGB(245, 158, 11),
            IsDivine = false,
        })
    end

    return {
        Success = true,
        Card = newCardInstance,
        RemainingCoins = profile.Coins,
        DisplayOdds = pack.DisplayOdds,
    }
end

-- =============================================================================
-- INITIALISATION DES RÉSEAUX RPC
-- =============================================================================
function GachaSystem.Init()
    -- Enregistrement de la RemoteFunction officielle RequestOpenPack
    local folder = game.ReplicatedStorage:WaitForChild("NetworkRemotes", 10) :: Folder
    local openPackRF = folder:FindFirstChild("RequestOpenPack") :: RemoteFunction?
    if not openPackRF then
        openPackRF = Instance.new("RemoteFunction")
        openPackRF.Name = "RequestOpenPack"
        openPackRF.Parent = folder
    end

    openPackRF.OnServerInvoke = function(player: Player, packId: any)
        if type(packId) ~= "string" then
            return { Success = false, Error = "Paramètre de pack invalide." }
        end
        return GachaSystem.OpenPack(player, packId)
    end

    print("[GachaSystem] Système d'ouverture de paquets initialisé et prêt.")
end

return GachaSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!strict
--[[
    MAP BUILDER (GÉNÉRATION DU HUB SOUVERAIN & DU COLISÉE CÉLESTE)
    Crée automatiquement le monde 3D procédural : Place Centrale, les 4 Autels interactifs
    (Gacha, Marché, Arène, Mérite) avec ProximityPrompts, et le Colisée 1v1 dans les cieux.
]]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local MapBuilder = {}

local function CreatePart(props: { [string]: any }): Part
    local part = Instance.new("Part")
    part.Anchored = true
    for k, v in pairs(props) do
        (part :: any)[k] = v
    end
    part.Parent = Workspace
    return part
end

function MapBuilder.BuildEnvironment()
    if Workspace:FindFirstChild("SovereignHub") then return end

    local hubFolder = Instance.new("Folder")
    hubFolder.Name = "SovereignHub"
    hubFolder.Parent = Workspace

    -- =========================================================================
    -- 1. ÉCLAIRAGE DARK FANTASY & AMBIANCE CÉLESTE
    -- =========================================================================
    Lighting.Brightness = 2
    Lighting.ClockTime = 20.5 -- Nuit crépusculaire mystique
    Lighting.OutdoorAmbient = Color3.fromRGB(45, 35, 60)
    Lighting.Ambient = Color3.fromRGB(30, 25, 45)

    local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect", Lighting)
    bloom.Intensity = 1.2
    bloom.Size = 24
    bloom.Threshold = 0.8

    local colorCorr = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect", Lighting)
    colorCorr.Contrast = 0.15
    colorCorr.Saturation = 0.25

    -- =========================================================================
    -- 2. HUB CENTRAL (LE ROYAUME DU SOUVERAIN)
    -- =========================================================================
    -- Sol principal en marbre obsidienne
    local mainFloor = CreatePart({
        Name = "LobbyFloor",
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(4, 180, 180),
        CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
        Material = Enum.Material.Slate,
        Color = Color3.fromRGB(20, 22, 28),
        Parent = hubFolder,
    })

    -- Anneau d'énergie runique extérieure
    CreatePart({
        Name = "RuneRing",
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(4.2, 190, 190),
        CFrame = CFrame.new(0, -0.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
        Material = Enum.Material.Neon,
        Color = Color3.fromRGB(245, 158, 11),
        Transparency = 0.4,
        Parent = hubFolder,
    })

    -- Point d'apparition principal (Spawn)
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "MainSpawn"
    spawn.Size = Vector3.new(16, 1, 16)
    spawn.Position = Vector3.new(0, 1, 0)
    spawn.Anchored = true
    spawn.Material = Enum.Material.Neon
    spawn.Color = Color3.fromRGB(99, 102, 241)
    spawn.Duration = 0
    spawn.Parent = hubFolder

    -- =========================================================================
    -- 3. LES 4 AUTELS INTERACTIFS DU SOUVERAIN
    -- =========================================================================
    local altars = {
        {
            Name = "AutelDuDestin",
            Title = "Autel du Destin (Invocations / Gacha)",
            Action = "Tirer des Cartes",
            UIName = "Gacha",
            Position = Vector3.new(0, 3, -50),
            Color = Color3.fromRGB(168, 85, 247),
            LightColor = Color3.fromRGB(217, 70, 239),
        },
        {
            Name = "HotelDesVentes",
            Title = "Hôtel des Ventes (Marché & Trading)",
            Action = "Consulter la Bourse",
            UIName = "Market",
            Position = Vector3.new(50, 3, 0),
            Color = Color3.fromRGB(16, 185, 129),
            LightColor = Color3.fromRGB(52, 211, 153),
        },
        {
            Name = "AreneDuMerite",
            Title = "Porte de l'Arène Compétitive",
            Action = "Rejoindre la File 1v1",
            UIName = "Arena",
            Position = Vector3.new(0, 3, 50),
            Color = Color3.fromRGB(239, 68, 68),
            LightColor = Color3.fromRGB(248, 113, 113),
        },
        {
            Name = "SanctuaireDuMerite",
            Title = "Sanctuaire du Mérite (Forge Prestige)",
            Action = "Transcender une Carte",
            UIName = "Merit",
            Position = Vector3.new(-50, 3, 0),
            Color = Color3.fromRGB(245, 158, 11),
            LightColor = Color3.fromRGB(251, 191, 36),
        },
    }

    for _, altarInfo in ipairs(altars) do
        -- Base de l'autel
        local base = CreatePart({
            Name = altarInfo.Name,
            Size = Vector3.new(10, 4, 10),
            Position = altarInfo.Position,
            Material = Enum.Material.Cobblestone,
            Color = Color3.fromRGB(30, 32, 40),
            Parent = hubFolder,
        })

        -- Cristal flottant au-dessus
        local crystal = CreatePart({
            Name = "Crystal",
            Size = Vector3.new(3, 6, 3),
            Position = altarInfo.Position + Vector3.new(0, 5, 0),
            Material = Enum.Material.Neon,
            Color = altarInfo.Color,
            Parent = base,
        })

        -- Lumière dynamique
        local light = Instance.new("PointLight")
        light.Color = altarInfo.LightColor
        light.Range = 25
        light.Brightness = 3
        light.Parent = crystal

        -- ProximityPrompt pour l'ouverture UI
        local prompt = Instance.new("ProximityPrompt")
        prompt.ObjectText = altarInfo.Title
        prompt.ActionText = altarInfo.Action
        prompt.KeyboardKeyCode = Enum.KeyCode.E
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 14
        prompt.Parent = base

        -- Attribut permettant au client de savoir quel onglet ouvrir
        base:SetAttribute("TargetUI", altarInfo.UIName)
    end

    -- =========================================================================
    -- 4. MANNEQUINS D'ENTRAÎNEMENT & SPAR-BOTS
    -- =========================================================================
    local function SpawnDummy(name: string, position: Vector3, isParryTrainer: boolean)
        local dummy = Instance.new("Model")
        dummy.Name = name
        dummy.Parent = hubFolder

        local root = CreatePart({
            Name = "HumanoidRootPart",
            Size = Vector3.new(2, 2, 1),
            Position = position + Vector3.new(0, 3, 0),
            Transparency = 1,
            CanCollide = false,
            Parent = dummy,
        })

        local torso = CreatePart({
            Name = "Torso",
            Size = Vector3.new(2, 2.5, 1),
            Position = position + Vector3.new(0, 3, 0),
            Material = Enum.Material.WoodPlanks,
            Color = isParryTrainer and Color3.fromRGB(180, 50, 50) or Color3.fromRGB(160, 120, 80),
            Parent = dummy,
        })

        local head = CreatePart({
            Name = "Head",
            Shape = Enum.PartType.Ball,
            Size = Vector3.new(1.6, 1.6, 1.6),
            Position = position + Vector3.new(0, 5, 0),
            Material = Enum.Material.Neon,
            Color = isParryTrainer and Color3.fromRGB(250, 204, 21) or Color3.fromRGB(220, 220, 230),
            Parent = dummy,
        })

        local hum = Instance.new("Humanoid")
        hum.MaxHealth = 1000
        hum.Health = 1000
        hum.Parent = dummy

        dummy.PrimaryPart = root

        -- Boucle d'auto-régénération
        task.spawn(function()
            while dummy.Parent do
                task.wait(2.5)
                if hum.Health < hum.MaxHealth then
                    hum.Health = hum.MaxHealth
                end
            end
        end)

        -- Si mannequin de parade : attaque cadencée pour s'entraîner au Parry
        if isParryTrainer then
            task.spawn(function()
                while dummy.Parent do
                    task.wait(4)
                    -- Flash d'avertissement
                    head.Color = Color3.fromRGB(239, 68, 68)
                    task.wait(0.7)
                    -- Attaque
                    head.Color = Color3.fromRGB(250, 204, 21)
                    local hitRadius = 10
                    local nearby = workspace:GetPartBoundsInRadius(root.Position, hitRadius)
                    for _, p in ipairs(nearby) do
                        local m = p:FindFirstAncestorOfClass("Model")
                        if m and m ~= dummy then
                            local targetHum = m:FindFirstChildOfClass("Humanoid")
                            if targetHum and targetHum.Health > 0 then
                                -- Vérifie si le joueur pare
                                local pl = game.Players:GetPlayerFromCharacter(m)
                                local didParry = false
                                if pl then
                                    local cs = require(script.Parent.CombatService)
                                    -- Si le joueur est en fenêtre de parade
                                    -- Il contre-attaquera via CombatService
                                end
                                targetHum:TakeDamage(10)
                            end
                        end
                    end
                end
            end)
        end
    end

    SpawnDummy("Mannequin_DPS", Vector3.new(25, 2, 25), false)
    SpawnDummy("Garde_Entrainement_Parry", Vector3.new(-25, 2, 25), true)

    -- =========================================================================
    -- 5. LE COLISÉE CÉLESTE (ARÈNE DE DUEL 1V1)
    -- =========================================================================
    local arenaHeight = 100
    local arenaFloor = CreatePart({
        Name = "ArenaFloor",
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(4, 140, 140),
        CFrame = CFrame.new(0, arenaHeight, 0) * CFrame.Angles(0, 0, math.rad(90)),
        Material = Enum.Material.DiamondPlate,
        Color = Color3.fromRGB(15, 17, 23),
        Parent = hubFolder,
    })

    -- Dôme de protection / Barrière d'énergie
    local barrier = CreatePart({
        Name = "ArenaBarrier",
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(40, 142, 142),
        CFrame = CFrame.new(0, arenaHeight + 18, 0) * CFrame.Angles(0, 0, math.rad(90)),
        Material = Enum.Material.ForceField,
        Color = Color3.fromRGB(239, 68, 68),
        Transparency = 0.85,
        CanCollide = true,
        Parent = hubFolder,
    })

    -- Piliers lumineux du Colisée
    for angle = 0, 315, 45 do
        local rad = math.rad(angle)
        local px = math.cos(rad) * 65
        local pz = math.sin(rad) * 65
        CreatePart({
            Name = "Pillar_" .. angle,
            Size = Vector3.new(4, 30, 4),
            Position = Vector3.new(px, arenaHeight + 15, pz),
            Material = Enum.Material.Neon,
            Color = Color3.fromRGB(245, 158, 11),
            Parent = hubFolder,
        })
    end

    print("[MapBuilder] Hub du Souverain et Colisée Céleste générés avec succès.")
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MarketManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    MARKETPLACE & AUCTION HOUSE (HÔTEL DES VENTES & ACHAT-REVENTE)
    Système complet de Bourse des Cartes : mise en vente, achat instantané,
    taxe déflationniste de 5%, et historique des cours pour le trading/flipping.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local MarketConfig = require(game.ReplicatedStorage.Shared.MarketConfig)
local CardsData = require(game.ReplicatedStorage.Shared.CardsData)
local CardUtils = require(game.ReplicatedStorage.Shared.CardUtils)
local Network = require(game.ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

export type MarketListing = {
    ListingId: string,
    SellerUserId: number,
    SellerName: string,
    CardInstance: CardUtils.CardInstance,
    PriceCoins: number,
    ListedAt: number,
}

local MarketManager = {}
local ActiveListings: { [string]: MarketListing } = {}
local RecentSalesHistory: { [string]: { { Price: number, Timestamp: number } } } = {}

-- Récupérer la liste des ventes actives (avec filtres optionnels de rareté/prix)
function MarketManager.GetListings(rarityFilter: string?, maxPrice: number?): { MarketListing }
    local results = {}
    for _, listing in pairs(ActiveListings) do
        local def = CardsData.GetCard(listing.CardInstance.CardId)
        local matchRarity = (rarityFilter == nil or rarityFilter == "" or (def and def.Rarity == rarityFilter))
        local matchPrice = (maxPrice == nil or listing.PriceCoins <= maxPrice)

        if matchRarity and matchPrice then
            table.insert(results, listing)
        end
    end
    table.sort(results, function(a, b)
        return a.PriceCoins < b.PriceCoins
    end)
    return results
end

-- Mettre en vente une carte
function MarketManager.ListItem(player: Player, cardUniqueId: string, price: number): { Success: boolean, Error: string? }
    local profile = DataManager.GetProfile(player)
    if not profile then
        return { Success = false, Error = "Profil non chargé." }
    end

    price = math.floor(price)
    if price < MarketConfig.MinPriceCoins or price > MarketConfig.MaxPriceCoins then
        return { Success = false, Error = "Prix hors limites (" .. MarketConfig.MinPriceCoins .. " - " .. MarketConfig.MaxPriceCoins .. " Or)." }
    end

    -- Compter les ventes actives du joueur
    local count = 0
    for _, l in pairs(ActiveListings) do
        if l.SellerUserId == player.UserId then
            count += 1
        end
    end
    if count >= MarketConfig.MaxActiveListingsPerPlayer then
        return { Success = false, Error = "Limite d'annonces atteinte (" .. MarketConfig.MaxActiveListingsPerPlayer .. " max)." }
    end

    -- Trouver la carte dans l'inventaire
    local foundIndex: number? = nil
    local cardInstance: CardUtils.CardInstance? = nil

    for idx, card in ipairs(profile.Inventory) do
        if card.UniqueId == cardUniqueId then
            foundIndex = idx
            cardInstance = card
            break
        end
    end

    if not cardInstance or not foundIndex then
        return { Success = false, Error = "Carte introuvable dans votre inventaire." }
    end

    -- Empêcher la vente d'une carte équipée dans le deck
    for _, eqId in ipairs(profile.EquippedDeck.Actives) do
        if eqId == cardUniqueId then
            return { Success = false, Error = "Déséquipez d'abord cette carte de votre Deck." }
        end
    end
    for _, eqId in ipairs(profile.EquippedDeck.Passives) do
        if eqId == cardUniqueId then
            return { Success = false, Error = "Déséquipez d'abord cette carte de votre Deck." }
        end
    end

    -- Frais de mise en vente (1%)
    local listingFee = math.max(1, math.floor(price * (MarketConfig.ListingFeePercent / 100)))
    if profile.Coins < listingFee then
        return { Success = false, Error = "Or insuffisant pour régler les frais de mise en vente (" .. listingFee .. " Or)." }
    end
    profile.Coins -= listingFee

    -- Retrait de l'inventaire vers le séquestre du marché
    table.remove(profile.Inventory, foundIndex)

    local listingId = HttpService:GenerateGUID(false)
    local listing: MarketListing = {
        ListingId = listingId,
        SellerUserId = player.UserId,
        SellerName = player.Name,
        CardInstance = cardInstance,
        PriceCoins = price,
        ListedAt = os.time(),
    }

    ActiveListings[listingId] = listing
    return { Success = true }
end

-- Acheter une carte instantanément (Buyout)
function MarketManager.BuyItem(buyer: Player, listingId: string): { Success: boolean, Error: string? }
    local buyerProfile = DataManager.GetProfile(buyer)
    if not buyerProfile then
        return { Success = false, Error = "Profil non chargé." }
    end

    local listing = ActiveListings[listingId]
    if not listing then
        return { Success = false, Error = "Cette annonce a déjà été vendue ou annulée." }
    end

    if listing.SellerUserId == buyer.UserId then
        return { Success = false, Error = "Vous ne pouvez pas acheter votre propre carte." }
    end

    if buyerProfile.Coins < listing.PriceCoins then
        return { Success = false, Error = "Or insuffisant pour cet achat." }
    end

    -- Retrait de l'annonce du marché
    ActiveListings[listingId] = nil

    -- Débit de l'acheteur
    buyerProfile.Coins -= listing.PriceCoins

    -- Calcul de la taxe déflationniste (5% brûlés définitivement)
    local taxAmount = math.floor(listing.PriceCoins * (MarketConfig.TaxRatePercent / 100))
    local sellerNetGain = listing.PriceCoins - taxAmount

    -- Transfert des fonds au vendeur (en ligne ou hors ligne)
    local sellerPlayer = Players:GetPlayerByUserId(listing.SellerUserId)
    if sellerPlayer then
        local sellerProfile = DataManager.GetProfile(sellerPlayer)
        if sellerProfile then
            sellerProfile.Coins += sellerNetGain
            sellerProfile.Stats.MarketSales += 1
            local toast = Network.GetEvent("ToastNotify")
            toast:FireClient(sellerPlayer, "Votre carte a été vendue pour " .. sellerNetGain .. " Or (Taxe 5% déduite).")
        end
    end

    -- Ajout de la carte achetée à l'inventaire de l'acheteur
    table.insert(buyerProfile.Inventory, listing.CardInstance)

    -- Enregistrement dans l'historique des cours (permet aux traders de surveiller les prix moyens)
    local cardId = listing.CardInstance.CardId
    if not RecentSalesHistory[cardId] then
        RecentSalesHistory[cardId] = {}
    end
    table.insert(RecentSalesHistory[cardId], { Price = listing.PriceCoins, Timestamp = os.time() })

    return { Success = true }
end

-- Annuler sa propre vente
function MarketManager.CancelItem(player: Player, listingId: string): { Success: boolean, Error: string? }
    local profile = DataManager.GetProfile(player)
    if not profile then return { Success = false, Error = "Profil non chargé." } end

    local listing = ActiveListings[listingId]
    if not listing then return { Success = false, Error = "Annonce inexistante." } end

    if listing.SellerUserId ~= player.UserId then
        return { Success = false, Error = "Vous n'êtes pas le propriétaire de cette annonce." }
    end

    ActiveListings[listingId] = nil
    table.insert(profile.Inventory, listing.CardInstance)
    return { Success = true }
end

function MarketManager.Init()
    local getListingsRF = Network.GetFunction("GetMarketListings")
    getListingsRF.OnServerInvoke = function(player: Player, rarityFilter: any, maxPrice: any)
        return MarketManager.GetListings(rarityFilter, maxPrice)
    end

    local listRF = Network.GetFunction("ListMarketItem")
    listRF.OnServerInvoke = function(player: Player, cardUniqueId: any, price: any)
        return MarketManager.ListItem(player, tostring(cardUniqueId), tonumber(price) or 0)
    end

    local buyRF = Network.GetFunction("BuyMarketItem")
    buyRF.OnServerInvoke = function(player: Player, listingId: any)
        return MarketManager.BuyItem(player, tostring(listingId))
    end

    local cancelRF = Network.GetFunction("CancelMarketItem")
    cancelRF.OnServerInvoke = function(player: Player, listingId: any)
        return MarketManager.CancelItem(player, tostring(listingId))
    end
end

return MarketManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">MeritManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    MERIT & ASCENSION MANAGER (SANCTUAIRE DU MÉRITE & FORGE DE PRESTIGE)
    Gestion de la transcendance des cartes par le mérite (Anti-Pay-To-Win),
    recyclage des doublons en poussière astrale et gestion de l'équipement du Deck.
]]

local Players = game:GetService("Players")

local RankConfig = require(game.ReplicatedStorage.Shared.RankConfig)
local RarityConfig = require(game.ReplicatedStorage.Shared.RarityConfig)
local CardsData = require(game.ReplicatedStorage.Shared.CardsData)
local Network = require(game.ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

local MeritManager = {}

-- Transcendance d'une carte grâce au Mérite
function MeritManager.PrestigeCard(player: Player, cardUniqueId: string): { Success: boolean, Error: string? }
    local profile = DataManager.GetProfile(player)
    if not profile then
        return { Success = false, Error = "Profil non chargé." }
    end

    if profile.Merit < RankConfig.Prestige.CostPerCard then
        return { Success = false, Error = "Points de Mérite insuffisants (" .. RankConfig.Prestige.CostPerCard .. " requis). Jouez en Arène !" }
    end

    local targetCard: any = nil
    for _, card in ipairs(profile.Inventory) do
        if card.UniqueId == cardUniqueId then
            targetCard = card
            break
        end
    end

    if not targetCard then
        return { Success = false, Error = "Carte introuvable." }
    end

    if targetCard.Prestige then
        return { Success = false, Error = "Cette carte a déjà atteint le rang Souverain Prestige." }
    end

    -- Déduction du Mérite et application de la transcendance
    profile.Merit -= RankConfig.Prestige.CostPerCard
    targetCard.Prestige = true

    local toast = Network.GetEvent("ToastNotify")
    toast:FireClient(player, "🌟 CARTE TRANSCENDÉE AU RANG PRESTIGE SOUVERAIN (+20% Efficacité) !")

    return { Success = true }
end

-- Recyclage d'une carte doublon contre de l'Or et de la Poussière
function MeritManager.RecycleCard(player: Player, cardUniqueId: string): { Success: boolean, CoinsEarned: number?, Error: string? }
    local profile = DataManager.GetProfile(player)
    if not profile then
        return { Success = false, Error = "Profil non chargé." }
    end

    local foundIndex: number? = nil
    local cardInstance: any = nil
    for idx, card in ipairs(profile.Inventory) do
        if card.UniqueId == cardUniqueId then
            foundIndex = idx
            cardInstance = card
            break
        end
    end

    if not cardInstance or not foundIndex then
        return { Success = false, Error = "Carte introuvable." }
    end

    -- Vérification si équipée
    for _, id in ipairs(profile.EquippedDeck.Actives) do
        if id == cardUniqueId then
            return { Success = false, Error = "Impossible de recycler une carte équipée dans votre Deck." }
        end
    end
    for _, id in ipairs(profile.EquippedDeck.Passives) do
        if id == cardUniqueId then
            return { Success = false, Error = "Impossible de recycler une carte équipée dans votre Deck." }
        end
    end

    local def = CardsData.GetCard(cardInstance.CardId)
    local rarityInfo = def and RarityConfig.Rarities[def.Rarity]
    local payout = rarityInfo and rarityInfo.BaseSellPrice or 20

    table.remove(profile.Inventory, foundIndex)
    profile.Coins += payout

    return { Success = true, CoinsEarned = payout }
end

-- Équipement du Deck (4 Actives, 2 Passives)
function MeritManager.EquipDeck(player: Player, newDeck: { Actives: { string }, Passives: { string } }): { Success: boolean, Error: string? }
    local profile = DataManager.GetProfile(player)
    if not profile then return { Success = false, Error = "Profil non chargé." } end

    if not newDeck or not newDeck.Actives or not newDeck.Passives then
        return { Success = false, Error = "Structure de Deck invalide." }
    end

    if #newDeck.Actives > 4 or #newDeck.Passives > 2 then
        return { Success = false, Error = "Le Deck ne peut contenir que 4 Actives et 2 Passives." }
    end

    -- Vérification de possession de chaque carte
    local function OwnsCard(uid: string): boolean
        for _, c in ipairs(profile.Inventory) do
            if c.UniqueId == uid then return true end
        end
        return false
    end

    for _, uid in ipairs(newDeck.Actives) do
        if not OwnsCard(uid) then return { Success = false, Error = "Vous ne possédez pas l'une des cartes actives." } end
    end
    for _, uid in ipairs(newDeck.Passives) do
        if not OwnsCard(uid) then return { Success = false, Error = "Vous ne possédez pas l'une des cartes passives." } end
    end

    profile.EquippedDeck = newDeck
    return { Success = true }
end

function MeritManager.Init()
    local prestigeRF = Network.GetFunction("PrestigeCard")
    prestigeRF.OnServerInvoke = function(player: Player, cardUid: any)
        return MeritManager.PrestigeCard(player, tostring(cardUid))
    end

    local recycleRF = Network.GetFunction("RecycleCard")
    recycleRF.OnServerInvoke = function(player: Player, cardUid: any)
        return MeritManager.RecycleCard(player, tostring(cardUid))
    end

    local equipRF = Network.GetFunction("EquipDeck")
    equipRF.OnServerInvoke = function(player: Player, newDeck: any)
        return MeritManager.EquipDeck(player, newDeck)
    end

    local getProfileRF = Network.GetFunction("GetPlayerData")
    getProfileRF.OnServerInvoke = function(player: Player)
        return DataManager.GetProfile(player)
    end
end

return MeritManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PlayerInventoryManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - GESTIONNAIRE CENTRAL DES PROFILS & INVENTAIRES (SERVEUR)
    Stockage sécurisé 100% côté serveur : Or, Mérite (Elo), Inventaire de cartes/skills,
    deck équipé (3 à 5 cartes), DataStore persistant, et connecteur optionnel Supabase.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CardsDatabase = require(game.ReplicatedStorage.Shared.CardsDatabase)

local DATASTORE_NAME = "CardsAndChaos_V1"
local AUTOSAVE_INTERVAL_SEC = 60

-- =============================================================================
-- CONFIGURATION SUPABASE (JOURNALISATION DES TRANSACTIONS & GROS ÉCHANGES)
-- =============================================================================
local SupabaseConfig = {
    Enabled = false, -- Activez à true dès que vous renseignez vos clés Supabase
    Url = "",        -- Ex: "https://xyzcompany.supabase.co"
    ApiKey = "",     -- Clé anon / service_role
    TableLogs = "game_transactions_audit",
}

-- =============================================================================
-- STRUCTURE D'UNE CARTE DANS L'INVENTAIRE DU JOUEUR
-- =============================================================================
export type CardInstance = {
    UUID: string,                         -- Identifiant unique (HttpService:GenerateGUID)
    CardId: string,                       -- Référence vers CardsDatabase
    Name: string,
    Rarity: CardsDatabase.CardRarity,
    Type: CardsDatabase.CardType,
    Level: number,                        -- Niveau de la carte (démarrage au Niv 1)
    BasePower: number,                    -- Force réelle mise à l'échelle
    AssetId: string,                      -- Illustration Decal ComfyUI
    Cooldown: number,
    AcquiredAt: number,                   -- Timestamp de création
    IsLocked: boolean,                    -- Verrouillé pour éviter la vente/suppression accidentelle
}

-- =============================================================================
-- STRUCTURE COMPLÈTE DU PROFIL JOUEUR
-- =============================================================================
export type PlayerProfile = {
    UserId: number,
    Coins: number,                        -- Monnaie principale pour les packs et le marché
    MeritPoints: number,                  -- Points de classement compétitif (Elo)
    RankTitle: string,                    -- Bronze, Argent, Or, Légende
    Inventory: { CardInstance },          -- Liste de toutes les cartes possédées
    EquippedDeck: { string },             -- UUIDs des 3 à 5 cartes équipées en combat
    PityCounter: {
        SinceLastLegendary: number,
        SinceLastEpic: number,
    },
    Stats: {
        PacksOpened: number,
        DuelsWon: number,
        DuelsLost: number,
        WinStreak: number,
        MarketSales: number,
    },
    SessionLock: number,                  -- Prévention des courses d'écriture (Race Conditions)
}

local PlayerInventoryManager = {}
local ActiveProfiles: { [Player]: PlayerProfile } = {}
local DataStoreInstance: DataStore? = nil

-- Initialisation sécurisée du DataStore
local function InitDataStore()
    local success, store = pcall(function()
        return DataStoreService:GetDataStore(DATASTORE_NAME)
    end)
    if success and store then
        DataStoreInstance = store
        print("[PlayerInventoryManager] DataStore connecté : " .. DATASTORE_NAME)
    else
        warn("[PlayerInventoryManager] DataStore indisponible (Mode Studio/Hors-ligne). Utilisation du cache mémoire.")
    end
end

-- =============================================================================
-- USINE DE GÉNÉRATION D'UNE NOUVELLE CARTE (INSTANCE UNIQUE)
-- =============================================================================
function PlayerInventoryManager.CreateCardInstance(cardId: string, customLevel: number?): CardInstance?
    local blueprint = CardsDatabase.GetCard(cardId)
    if not blueprint then
        warn("[PlayerInventoryManager] Tentative de création d'une carte inexistante : " .. tostring(cardId))
        return nil
    end

    local lvl = customLevel or 1
    local levelMultiplier = 1 + (lvl - 1) * 0.1 -- +10% de puissance par niveau

    local instance: CardInstance = {
        UUID = HttpService:GenerateGUID(false),
        CardId = blueprint.CardId,
        Name = blueprint.Name,
        Rarity = blueprint.Rarity,
        Type = blueprint.Type,
        Level = lvl,
        BasePower = math.round(blueprint.BasePower * levelMultiplier),
        AssetId = blueprint.AssetId,
        Cooldown = blueprint.Cooldown,
        AcquiredAt = os.time(),
        IsLocked = false,
    }

    return instance
end

-- =============================================================================
-- PROFIL PAR DÉFAUT (NOUVEAU JOUEUR)
-- =============================================================================
local function CreateDefaultProfile(userId: number): PlayerProfile
    -- Offre 3 cartes de base équilibrées pour commencer immédiatement à jouer
    local starter1 = PlayerInventoryManager.CreateCardInstance("strike_of_iron")!
    local starter2 = PlayerInventoryManager.CreateCardInstance("wooden_parry")!
    local starter3 = PlayerInventoryManager.CreateCardInstance("inner_focus")!

    return {
        UserId = userId,
        Coins = 1000,              -- 10 tirages de bienvenue offerts !
        MeritPoints = 1000,        -- Classement initial Bronze / Argent
        RankTitle = "Bronze",
        Inventory = { starter1, starter2, starter3 },
        EquippedDeck = { starter1.UUID, starter2.UUID, starter3.UUID },
        PityCounter = {
            SinceLastLegendary = 0,
            SinceLastEpic = 0,
        },
        Stats = {
            PacksOpened = 0,
            DuelsWon = 0,
            DuelsLost = 0,
            WinStreak = 0,
            MarketSales = 0,
        },
        SessionLock = os.time(),
    }
end

-- =============================================================================
-- HOOK SUPABASE ASYNCHRONE (NON-BLOQUANT)
-- =============================================================================
local function PushAuditToSupabase(player: Player, eventType: string, payload: { [string]: any })
    if not SupabaseConfig.Enabled or SupabaseConfig.Url == "" then return end

    task.spawn(function()
        local url = SupabaseConfig.Url .. "/rest/v1/" .. SupabaseConfig.TableLogs
        local bodyData = {
            user_id = player.UserId,
            username = player.Name,
            event_type = eventType,
            details = payload,
            created_at = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }

        local jsonBody = HttpService:JSONEncode(bodyData)
        local success, response = pcall(function()
            return HttpService:RequestAsync({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["apikey"] = SupabaseConfig.ApiKey,
                    ["Authorization"] = "Bearer " .. SupabaseConfig.ApiKey,
                    ["Prefer"] = "return=minimal",
                },
                Body = jsonBody,
            })
        end)

        if not success then
            warn("[Supabase Hook] Échec d'envoi du log d'audit : " .. tostring(response))
        end
    end)
end

-- =============================================================================
-- CHARGEMENT & SAUVEGARDE DU PROFIL
-- =============================================================================
function PlayerInventoryManager.LoadProfile(player: Player): PlayerProfile
    local key = "PlayerProfile_" .. player.UserId
    local profile: PlayerProfile? = nil

    if DataStoreInstance then
        local attempts = 0
        local maxAttempts = 3
        while attempts < maxAttempts and not profile do
            attempts += 1
            local success, data = pcall(function()
                return DataStoreInstance:GetAsync(key)
            end)
            if success and data and type(data) == "table" then
                profile = data :: PlayerProfile
            elseif not success then
                warn("[PlayerInventoryManager] Tentative de lecture " .. attempts .. " échouée pour " .. player.Name)
                task.wait(1)
            end
        end
    end

    if not profile then
        profile = CreateDefaultProfile(player.UserId)
    end

    profile.SessionLock = os.time()
    ActiveProfiles[player] = profile
    return profile
end

function PlayerInventoryManager.SaveProfile(player: Player): boolean
    local profile = ActiveProfiles[player]
    if not profile then return false end
    if not DataStoreInstance then return true end

    local key = "PlayerProfile_" .. player.UserId
    local success, err = pcall(function()
        DataStoreInstance:SetAsync(key, profile)
    end)

    if not success then
        warn("[PlayerInventoryManager] Erreur de sauvegarde critique pour " .. player.Name .. " : " .. tostring(err))
        return false
    end
    return true
end

function PlayerInventoryManager.ReleaseProfile(player: Player)
    PlayerInventoryManager.SaveProfile(player)
    ActiveProfiles[player] = nil
end

-- =============================================================================
-- GETTERS & MÉTHODES DE SÉCURITÉ SERVEUR
-- =============================================================================
function PlayerInventoryManager.GetProfile(player: Player): PlayerProfile?
    return ActiveProfiles[player]
end

function PlayerInventoryManager.GetCoins(player: Player): number
    local prof = ActiveProfiles[player]
    return prof and prof.Coins or 0
end

function PlayerInventoryManager.GetMerit(player: Player): number
    local prof = ActiveProfiles[player]
    return prof and prof.MeritPoints or 0
end

function PlayerInventoryManager.AddCoins(player: Player, amount: number)
    local prof = ActiveProfiles[player]
    if prof and amount > 0 then
        prof.Coins += math.floor(amount)
    end
end

function PlayerInventoryManager.DeductCoins(player: Player, amount: number): boolean
    local prof = ActiveProfiles[player]
    if not prof then return false end

    amount = math.floor(amount)
    if amount < 0 or prof.Coins < amount then
        return false
    end

    prof.Coins -= amount
    return true
end

function PlayerInventoryManager.AddCard(player: Player, cardInstance: CardInstance): boolean
    local prof = ActiveProfiles[player]
    if not prof then return false end

    table.insert(prof.Inventory, cardInstance)

    -- Si la carte tirée est Légendaire, trace d'audit Supabase
    if cardInstance.Rarity == "Legendary" then
        PushAuditToSupabase(player, "LEGENDARY_OBTAINED", {
            card_uuid = cardInstance.UUID,
            card_id = cardInstance.CardId,
            card_name = cardInstance.Name,
            power = cardInstance.BasePower,
        })
    end

    return true
end

function PlayerInventoryManager.RemoveCardByUUID(player: Player, cardUUID: string): CardInstance?
    local prof = ActiveProfiles[player]
    if not prof then return nil end

    for idx, card in ipairs(prof.Inventory) do
        if card.UUID == cardUUID then
            -- Vérifie que la carte n'est pas équipée
            for _, eqUid in ipairs(prof.EquippedDeck) do
                if eqUid == cardUUID then
                    return nil -- Interdit de retirer une carte équipée
                end
            end
            return table.remove(prof.Inventory, idx)
        end
    end
    return nil
end

function PlayerInventoryManager.EquipDeck(player: Player, cardUUIDs: { string }): { Success: boolean, Error: string? }
    local prof = ActiveProfiles[player]
    if not prof then return { Success = false, Error = "Profil non chargé." } end

    if #cardUUIDs < 3 or #cardUUIDs > 5 then
        return { Success = false, Error = "Le Deck de combat doit contenir entre 3 et 5 cartes." }
    end

    -- Vérification stricte que chaque UUID appartient bien au joueur
    local function HasCard(uid: string): boolean
        for _, c in ipairs(prof.Inventory) do
            if c.UUID == uid then return true end
        end
        return false
    end

    for _, uid in ipairs(cardUUIDs) do
        if not HasCard(uid) then
            return { Success = false, Error = "Tentative d'équiper une carte que vous ne possédez pas." }
        end
    end

    prof.EquippedDeck = cardUUIDs
    return { Success = true }
end

-- =============================================================================
-- INITIALISATION DU SERVICE
-- =============================================================================
function PlayerInventoryManager.Init()
    InitDataStore()

    -- Boucle d'autosauvegarde
    task.spawn(function()
        while true do
            task.wait(AUTOSAVE_INTERVAL_SEC)
            for _, p in ipairs(Players:GetPlayers()) do
                PlayerInventoryManager.SaveProfile(p)
            end
        end
    end)
end

return PlayerInventoryManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">TradeManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    PEER-TO-PEER TRADE MANAGER (ÉCHANGES SÉCURISÉS)
    Système d'échange direct entre joueurs avec vérification en deux étapes,
    compte à rebours de 3 secondes et transaction atomique sans risque de duplication.
]]

local Players = game:GetService("Players")

local CardUtils = require(game.ReplicatedStorage.Shared.CardUtils)
local Network = require(game.ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

export type TradeParticipant = {
    Player: Player,
    OfferedCardUniqueIds: { string },
    OfferedCoins: number,
    IsLocked: boolean,
    IsConfirmed: boolean,
}

export type TradeSession = {
    SessionId: string,
    Party1: TradeParticipant,
    Party2: TradeParticipant,
    CountdownTask: thread?,
    IsFinalized: boolean,
}

local TradeManager = {}
local ActiveSessions: { [string]: TradeSession } = {}
local PlayerToSession: { [Player]: TradeSession } = {}

-- Trouver la session d'un joueur
local function GetSession(player: Player): TradeSession?
    return PlayerToSession[player]
end

-- Création d'une nouvelle session d'échange
function TradeManager.StartSession(p1: Player, p2: Player): TradeSession
    local sessionId = p1.UserId .. "_" .. p2.UserId .. "_" .. os.time()
    local session: TradeSession = {
        SessionId = sessionId,
        Party1 = {
            Player = p1,
            OfferedCardUniqueIds = {},
            OfferedCoins = 0,
            IsLocked = false,
            IsConfirmed = false,
        },
        Party2 = {
            Player = p2,
            OfferedCardUniqueIds = {},
            OfferedCoins = 0,
            IsLocked = false,
            IsConfirmed = false,
        },
        IsFinalized = false,
    }

    ActiveSessions[sessionId] = session
    PlayerToSession[p1] = session
    PlayerToSession[p2] = session

    return session
end

-- Annuler un échange
function TradeManager.AbortSession(session: TradeSession, reason: string?)
    if session.IsFinalized then return end
    session.IsFinalized = true

    if session.CountdownTask then
        task.cancel(session.CountdownTask)
    end

    ActiveSessions[session.SessionId] = nil
    PlayerToSession[session.Party1.Player] = nil
    PlayerToSession[session.Party2.Player] = nil

    local cancelEv = Network.GetEvent("CancelTrade")
    cancelEv:FireClient(session.Party1.Player, reason or "Échange annulé.")
    cancelEv:FireClient(session.Party2.Player, reason or "Échange annulé.")
end

-- Mise à jour des offres (cartes ou or)
function TradeManager.UpdateOffer(player: Player, cardUniqueIds: { string }, coins: number)
    local session = GetSession(player)
    if not session or session.IsFinalized then return end

    local party = (session.Party1.Player == player) and session.Party1 or session.Party2
    local otherParty = (session.Party1.Player == player) and session.Party2 or session.Party1

    party.OfferedCardUniqueIds = cardUniqueIds
    party.OfferedCoins = math.max(0, math.floor(coins))

    -- Toute modification annule le verrouillage des deux côtés (sécurité anti-arnaque)
    party.IsLocked = false
    party.IsConfirmed = false
    otherParty.IsLocked = false
    otherParty.IsConfirmed = false

    if session.CountdownTask then
        task.cancel(session.CountdownTask)
        session.CountdownTask = nil
    end

    local updateEv = Network.GetEvent("UpdateTradeOffer")
    updateEv:FireClient(session.Party1.Player, {
        YourOffer = session.Party1,
        TheirOffer = session.Party2,
    })
    updateEv:FireClient(session.Party2.Player, {
        YourOffer = session.Party2,
        TheirOffer = session.Party1,
    })
end

-- Verrouiller et Confirmer l'échange
function TradeManager.ConfirmTrade(player: Player): boolean
    local session = GetSession(player)
    if not session or session.IsFinalized then return false end

    local party = (session.Party1.Player == player) and session.Party1 or session.Party2
    local otherParty = (session.Party1.Player == player) and session.Party2 or session.Party1

    if not party.IsLocked then
        party.IsLocked = true
    else
        party.IsConfirmed = true
    end

    -- Si les deux ont verrouillé, on lance le compte à rebours de sécurité de 3 secondes
    if session.Party1.IsLocked and session.Party2.IsLocked and not session.CountdownTask then
        session.CountdownTask = task.spawn(function()
            task.wait(3)
            -- Si les deux confirment après le compte à rebours, transaction atomique
            if session.Party1.IsConfirmed and session.Party2.IsConfirmed and not session.IsFinalized then
                TradeManager.ExecuteSwap(session)
            end
        end)
    end

    return true
end

-- Exécution atomique de l'échange
function TradeManager.ExecuteSwap(session: TradeSession)
    session.IsFinalized = true
    local p1 = session.Party1.Player
    local p2 = session.Party2.Player

    local prof1 = DataManager.GetProfile(p1)
    local prof2 = DataManager.GetProfile(p2)

    if not prof1 or not prof2 then
        TradeManager.AbortSession(session, "Profil manquant lors de la transaction.")
        return
    end

    -- Vérification des fonds
    if prof1.Coins < session.Party1.OfferedCoins or prof2.Coins < session.Party2.OfferedCoins then
        TradeManager.AbortSession(session, "Fonds insuffisants lors de la transaction.")
        return
    end

    -- Échange d'or
    prof1.Coins = prof1.Coins - session.Party1.OfferedCoins + session.Party2.OfferedCoins
    prof2.Coins = prof2.Coins - session.Party2.OfferedCoins + session.Party1.OfferedCoins

    -- Déplacement des cartes de P1 vers P2
    local function ExtractCards(profile: DataManager.PlayerProfile, uids: { string }): { CardUtils.CardInstance }
        local extracted = {}
        for _, uid in ipairs(uids) do
            for i = #profile.Inventory, 1, -1 do
                if profile.Inventory[i].UniqueId == uid then
                    table.insert(extracted, table.remove(profile.Inventory, i))
                    break
                end
            end
        end
        return extracted
    end

    local cardsFrom1 = ExtractCards(prof1, session.Party1.OfferedCardUniqueIds)
    local cardsFrom2 = ExtractCards(prof2, session.Party2.OfferedCardUniqueIds)

    for _, c in ipairs(cardsFrom1) do
        table.insert(prof2.Inventory, c)
    end
    for _, c in ipairs(cardsFrom2) do
        table.insert(prof1.Inventory, c)
    end

    prof1.Stats.CardsTraded += #cardsFrom1
    prof2.Stats.CardsTraded += #cardsFrom2

    TradeManager.AbortSession(session, "Échange finalisé avec succès !")
end

function TradeManager.Init()
    local confirmRF = Network.GetFunction("ConfirmTrade")
    confirmRF.OnServerInvoke = function(player: Player)
        return TradeManager.ConfirmTrade(player)
    end

    local updateOfferRE = Network.GetEvent("UpdateTradeOffer")
    updateOfferRE.OnServerEvent:Connect(function(player: Player, data: any)
        if type(data) == "table" then
            TradeManager.UpdateOffer(player, data.CardUniqueIds or {}, data.Coins or 0)
        end
    end)

    Players.PlayerRemoving:Connect(function(player: Player)
        local session = GetSession(player)
        if session then
            TradeManager.AbortSession(session, player.Name .. " a quitté la partie.")
        end
    end)
end

return TradeManager
]]></string>
        </Properties>
      </Item>
    </Item>
