          <string name="Name">RarityConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
    RARITY CONFIGURATION
    Paliers de rareté, probabilités de tirage (Gacha), multiplicateurs et esthétique.
]]

export type RarityInfo = {
