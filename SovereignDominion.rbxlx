    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - INITIALISATION SERVEUR UNIQUE
    Bootstrap propre : Réseau RPC, Map 3D, Profils DataStore, Combat 3D, Gacha, Marché et Cloud Groq.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkEvents = require(ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.DataManager)
local CombatService = require(script.CombatService)
local GachaManager = require(script.GachaManager)
local MarketManager = require(script.MarketManager)
local ArenaManager = require(script.ArenaManager)
local MapBuilder = require(script.MapBuilder)
local CloudBridge = require(script.CloudBridge)

print("========================================================")
print("  CARDS & CHAOS - LANCEMENT DU SERVEUR ROBLOX (LUAU)")
print("========================================================")

-- 1. Initialisation du Réseau
NetworkEvents.InitServer()

-- 2. Construction de la carte 3D (ZÉRO cube jaune fluo, 3 mannequins d'entraînement réactifs)
MapBuilder.BuildEnvironment()

-- 3. Initialisation des Services Serveur
DataManager.Init()
CombatService.Init()
GachaManager.Init()
MarketManager.Init()
ArenaManager.Init()
CloudBridge.Init()

-- 4. Connexions des Joueurs
Players.PlayerAdded:Connect(function(player: Player)
    local prof = DataManager.LoadProfile(player)

    player.CharacterAdded:Connect(function(char: Model)
        local hum = char:WaitForChild("Humanoid") :: Humanoid
        hum.MaxHealth = 100
        hum.Health = 100
    end)
end)

Players.PlayerRemoving:Connect(function(player: Player)
    DataManager.ReleaseProfile(player)
end)

game:BindToClose(function()
    print("[Server] Arrêt du serveur : sauvegarde d'urgence de tous les profils...")
    for _, p in ipairs(Players:GetPlayers()) do
        DataManager.SaveProfile(p)
    end
end)

-- RemoteFunction pour synchroniser les données du joueur avec l'UI
local getProfRF = NetworkEvents.GetFunction("GetPlayerData")
getProfRF.OnServerInvoke = function(player: Player)
    return DataManager.GetProfile(player)
end

-- RemoteFunction pour équiper une carte dans un slot (1-4)
local equipRF = NetworkEvents.GetFunction("EquipCard")
equipRF.OnServerInvoke = function(player: Player, cardId: any, slotIdx: any)
    local slot = tonumber(slotIdx) or 1
    local success = DataManager.EquipCard(player, tostring(cardId), slot)
    return { Success = success, Profile = DataManager.GetProfile(player) }
end

print("[Server] Serveur CARDS & CHAOS prêt à 100% !")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ArenaManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - ARÈNE COMPÉTITIVE 1V1 & DUEL CONTRE BOT IA (SERVEUR)
    Téléportation dans le Colisée Céleste, duel contre un Bot Duelliste IA intelligent,
    calcul des gains compétitifs (+25 Mérite & +150 Or) et gestion des récompenses de rang.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local NetworkEvents = require(ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

local ArenaManager = {}

local ARENA_SPAWN_PLAYER = Vector3.new(0, 103, 35)
local ARENA_SPAWN_BOT = Vector3.new(0, 103, -35)
local LOBBY_SPAWN = Vector3.new(0, 3, 0)

-- Lance un duel compétitif contre le Bot Duelliste IA
function ArenaManager.StartBotDuel(player: Player)
    local prof = DataManager.GetProfile(player)
    if not prof then return { Success = false, Error = "Profil non chargé." } end

    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid") :: Humanoid
    local hrp = char:WaitForChild("HumanoidRootPart") :: BasePart

    -- Téléportation du joueur dans le Colisée
    hrp.CFrame = CFrame.lookAt(ARENA_SPAWN_PLAYER, ARENA_SPAWN_BOT)
    hum.Health = hum.MaxHealth
    hum.WalkSpeed = 0

    -- Création du Bot Duelliste IA
    local botModel = Instance.new("Model")
    botModel.Name = "Bot_Duelliste_Souverain"
    botModel.Parent = workspace

    local botHrp = Instance.new("Part")
    botHrp.Name = "HumanoidRootPart"
    botHrp.Size = Vector3.new(2, 2, 1)
    botHrp.CFrame = CFrame.lookAt(ARENA_SPAWN_BOT, ARENA_SPAWN_PLAYER)
    botHrp.CanCollide = false
    botHrp.Transparency = 1
    botHrp.Parent = botModel

    local botTorso = Instance.new("Part")
    botTorso.Name = "Torso"
    botTorso.Size = Vector3.new(2.5, 3, 1.5)
    botTorso.CFrame = botHrp.CFrame
    botTorso.Material = Enum.Material.Slate
    botTorso.Color = Color3.fromRGB(145, 40, 255)
    botTorso.Parent = botModel

    local botHead = Instance.new("Part")
    botHead.Name = "Head"
    botHead.Shape = Enum.PartType.Ball
    botHead.Size = Vector3.new(2, 2, 2)
    botHead.CFrame = botHrp.CFrame * CFrame.new(0, 2.5, 0)
    botHead.Material = Enum.Material.Neon
    botHead.Color = Color3.fromRGB(239, 68, 68)
    botHead.Parent = botModel

    local botHum = Instance.new("Humanoid")
    botHum.MaxHealth = 200
    botHum.Health = 200
    botHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Always
    botHum.Parent = botModel
    botModel.PrimaryPart = botHrp

    local matchStateEv = NetworkEvents.GetEvent("MatchStateChanged")
    matchStateEv:FireClient(player, { State = "VS", OpponentName = "Bot Duelliste Souverain (IA)" })

    task.spawn(function()
        -- Compte à rebours 3, 2, 1
        for count = 3, 1, -1 do
            matchStateEv:FireClient(player, { State = "Countdown", Value = count })
            task.wait(1)
        end
        matchStateEv:FireClient(player, { State = "Fight" })
        hum.WalkSpeed = 16

        local isMatchActive = true
        local timer = 75

        -- Comportement du Bot IA : Traque et lance des sorts toutes les 3s
        local aiThread = task.spawn(function()
            while isMatchActive and botHum.Health > 0 and hum.Health > 0 do
                task.wait(2.5)
                if hrp and botHrp then
                    botHum:MoveTo(hrp.Position)
                    local dist = (hrp.Position - botHrp.Position).Magnitude
                    if dist <= 45 then
                        -- Lancement d'un projectile de magma vers le joueur
                        local orb = Instance.new("Part")
                        orb.Shape = Enum.PartType.Ball
                        orb.Material = Enum.Material.Neon
                        orb.Color = Color3.fromRGB(255, 85, 0)
                        orb.Size = Vector3.new(2.5, 2.5, 2.5)
                        orb.Anchored = true
                        orb.CanCollide = false
                        orb.CFrame = botHrp.CFrame * CFrame.new(0, 1, -2)
                        orb.Parent = workspace

                        local endPos = hrp.Position
                        local tween = TweenService:Create(orb, TweenInfo.new(0.6), { Position = endPos })
                        tween:Play()
                        tween.Completed:Connect(function()
                            if hum and hum.Health > 0 and (hrp.Position - orb.Position).Magnitude <= 10 then
                                hum:TakeDamage(20)
                            end
                            orb:Destroy()
                        end)
                    end
                end
            end
        end)

        while timer > 0 and isMatchActive do
            task.wait(1)
            timer -= 1
            if hum.Health <= 0 or botHum.Health <= 0 then
                break
            end
        end

        isMatchActive = false
        task.cancel(aiThread)

        local isVictory = (botHum.Health <= 0) or (hum.Health > botHum.Health)
        if isVictory then
            DataManager.AddMerit(player, 25)
            DataManager.AddCoins(player, 150)
            prof.Stats.DuelsWon += 1
            prof.Stats.WinStreak += 1

            matchStateEv:FireClient(player, {
                State = "Victory",
                MeritGained = 25,
                CoinsGained = 150,
                NewMerit = prof.Merit,
                NewCoins = prof.Coins,
            })
        else
            prof.Stats.DuelsLost += 1
            prof.Stats.WinStreak = 0
            matchStateEv:FireClient(player, {
                State = "Defeat",
                MeritGained = 5,
                CoinsGained = 40,
                NewMerit = prof.Merit,
                NewCoins = prof.Coins,
            })
        end

        task.delay(4, function()
            botModel:Destroy()
            if char and char:FindFirstChild("HumanoidRootPart") then
                (char.HumanoidRootPart :: BasePart).CFrame = CFrame.new(LOBBY_SPAWN)
            end
        end)
    end)

    return { Success = true }
end

-- Réclamation de la récompense de palier Mérite (+500 Or)
function ArenaManager.ClaimReward(player: Player)
    local prof = DataManager.GetProfile(player)
    if not prof then return { Success = false, Error = "Profil non chargé." } end

    local rank = prof.Rank
    if prof.ClaimedRewards[rank] then
        return { Success = false, Error = "Récompense de rang '" .. rank .. "' déjà réclamée." }
    end

    prof.ClaimedRewards[rank] = true
    DataManager.AddCoins(player, 500)
    return { Success = true, Message = "Récompense de rang '" .. rank .. "' réclamée : +500 Or !", RemainingCoins = prof.Coins }
end

function ArenaManager.Init()
    local joinRF = NetworkEvents.GetFunction("JoinArenaQueue")
    joinRF.OnServerInvoke = function(player: Player)
        return ArenaManager.StartBotDuel(player)
    end

    local claimRF = NetworkEvents.GetFunction("ClaimRankReward")
    claimRF.OnServerInvoke = function(player: Player)
        return ArenaManager.ClaimReward(player)
    end

    print("[ArenaManager] Colisée 1v1 et Bot Duelliste prêts.")
end

return ArenaManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">CloudBridge</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - PASSERELLE CLOUD & IA (GROQ & SUPABASE)
    Connexion sécurisée via HttpService pour animer le PNJ Maître Eldrin avec Groq (Llama 3.3 70B)
    et journaliser les transactions sur Supabase. Encapsulé dans des pcall pour le mode Studio.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkEvents = require(ReplicatedStorage.Shared.NetworkEvents)

local CloudBridge = {}

-- Clés et Endpoints configurés (Roblox Secret ou Clé d'API Groq)
local GROQ_API_KEY = ""
pcall(function()
    local secret = (HttpService :: any):GetSecret("GROQ_API_KEY")
    if secret then
        GROQ_API_KEY = secret
    end
end)
local GROQ_MODEL = "llama-3.3-70b-versatile"

local SUPABASE_URL = ""
local SUPABASE_KEY = ""

-- Dialogue avec Maître Eldrin via Groq API (avec fallback immersif hors-ligne)
function CloudBridge.AskGroq(player: Player, question: string): string
    if question == "" or string.len(question) > 200 then
        return "Approche, voyageur. Pose-moi une question sur les cartes ou l'arène."
    end

    if GROQ_API_KEY == "" then
        local fallbacks = {
            "Garde tes distances et prépare ton Météore Solaire (Touche 1 ou A) dès que l'ennemi avance !",
            "Le Pas Éclair (Touche 3 ou E) te permet de traverser les attaques ennemies tout en infligeant 28 dégâts.",
            "L'Égide du Souverain (Touche 4 ou R) restaure 40 points de vie tout en érigeant une barrière protectrice.",
            "Combine la Nova du Néant (Touche 2 ou Z) au corps-à-corps après avoir dashé avec le Pas Éclair !",
            "Accumule des points de Mérite dans l'Arène 1v1 pour gravir les échelons et débloquer des récompenses de rang."
        }
        return fallbacks[math.random(1, #fallbacks)]
    end

    local systemPrompt = "Tu es Maître Eldrin, le gardien sage et mystique de la crypte du jeu CARDS & CHAOS. Réponds en français de façon immersive, concise (max 2 phrases) et donne des conseils stratégiques sur les sorts (Météore, Nova, Pas Éclair, Égide), le Gacha et l'arène 1v1."

    local success, response = pcall(function()
        local payload = {
            model = GROQ_MODEL,
            messages = {
                { role = "system", content = systemPrompt },
                { role = "user", content = question },
            },
            max_tokens = 100,
            temperature = 0.7,
        }

        local res = HttpService:RequestAsync({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. GROQ_API_KEY,
            },
            Body = HttpService:JSONEncode(payload),
        })

        if res.Success and res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            return data.choices[1].message.content
        else
            return "Les vents astraux sont perturbés... (Code: " .. tostring(res.StatusCode) .. ")"
        end
    end)

    if success and response then
        return tostring(response)
    else
        return "Bienvenue dans CARDS & CHAOS ! Entraîne-toi sur les 3 mannequins, invoque de nouveaux sorts à l'autel ou affronte le Bot dans l'Arène 1v1 !"
    end
end

function CloudBridge.Init()
    local talkRF = NetworkEvents.GetFunction("TalkToNPC")
    talkRF.OnServerInvoke = function(player: Player, msg: any)
        return CloudBridge.AskGroq(player, tostring(msg or ""))
    end
    print("[CloudBridge] Passerelle Groq & Supabase active.")
end

return CloudBridge
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - SERVICE DE COMBAT 3D & HITBOXES (SERVEUR)
    Exécution serveur-autoritaire des 4 sorts (Projectile, AoE, DashStrike, ShieldBuff)
    et du Dash (Slot 5), avec pop-up 3D BillboardGui de dégâts sur tous les Humanoids.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CardsDatabase = require(Shared:WaitForChild("CardsDatabase"))
local NetworkEvents = require(Shared:WaitForChild("NetworkEvents"))
local DataManager = require(script.Parent.DataManager)

local CombatService = {}
local cooldowns: { [number]: { [number]: number } } = {} -- [userId][slot] = os.clock()

local function showDamageBillboard(targetPart: BasePart, amount: number, color: Color3, prefix: string?)
	local bg = Instance.new("BillboardGui")
	bg.Size = UDim2.fromOffset(120, 50)
	bg.StudsOffset = Vector3.new(math.random(-2, 2), 3, math.random(-2, 2))
	bg.AlwaysOnTop = true
	bg.Parent = targetPart

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = (prefix or "-") .. tostring(math.floor(amount))
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0
	lbl.Font = Enum.Font.FredokaOne
	lbl.TextScaled = true
	lbl.Parent = bg

	TweenService:Create(bg, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		StudsOffset = bg.StudsOffset + Vector3.new(0, 4, 0)
	}):Play()
	TweenService:Create(lbl, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(bg, 0.85)
end

local function dealAreaDamage(casterChar: Model, centerPos: Vector3, radius: number, damage: number, color: Color3)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Humanoid") and obj.Health > 0 then
			local model = obj.Parent
			if model and model ~= casterChar then
				local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
				if root and root:IsA("BasePart") and (root.Position - centerPos).Magnitude <= radius then
					obj:TakeDamage(damage)
					showDamageBillboard(root, damage, color, "-")
				end
			end
		end
	end
end

function CombatService.CastSpell(player: Player, slotIndex: number, targetPosition: Vector3)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid") :: Humanoid?
	if not root or not hum or hum.Health <= 0 then return end

	-- Gestion du Dash (Slot 5)
	if slotIndex == 5 then
		cooldowns[player.UserId] = cooldowns[player.UserId] or {}
		local now = os.clock()
		if (now - (cooldowns[player.UserId][5] or 0)) < 2.0 then return end
		cooldowns[player.UserId][5] = now

		local dir = (Vector3.new(targetPosition.X, root.Position.Y, targetPosition.Z) - root.Position)
		local moveDir = dir.Magnitude > 1 and dir.Unit or root.CFrame.LookVector

		local trailPart = Instance.new("Part")
		trailPart.Shape = Enum.PartType.Ball
		trailPart.Material = Enum.Material.Neon
		trailPart.Color = Color3.fromRGB(0, 200, 255)
		trailPart.Size = Vector3.new(3, 3, 3)
		trailPart.Anchored = true
		trailPart.CanCollide = false
		trailPart.CFrame = root.CFrame
		trailPart.Parent = workspace
		TweenService:Create(trailPart, TweenInfo.new(0.35), { Size = Vector3.new(8, 8, 8), Transparency = 1 }):Play()
		Debris:AddItem(trailPart, 0.4)

		root.CFrame = root.CFrame + (moveDir * 28)
		return
	end

	-- Récupération du sort équipé dans le slot
	local prof = DataManager.GetProfile(player)
	local spellId = (prof and prof.EquippedDeck[slotIndex]) or CardsDatabase.StarterDeck[slotIndex]
	local spell = spellId and CardsDatabase.Cards[spellId]
	if not spell then return end

	cooldowns[player.UserId] = cooldowns[player.UserId] or {}
	local now = os.clock()
	if (now - (cooldowns[player.UserId][slotIndex] or 0)) < spell.Cooldown then return end
	cooldowns[player.UserId][slotIndex] = now

	local aimDir = (targetPosition - root.Position)
	aimDir = Vector3.new(aimDir.X, 0, aimDir.Z)
	local unitDir = aimDir.Magnitude > 0.5 and aimDir.Unit or root.CFrame.LookVector

	if spell.SpellType == "Projectile" then
		local orb = Instance.new("Part")
		orb.Shape = Enum.PartType.Ball
		orb.Material = Enum.Material.Neon
		orb.Color = spell.Color
		orb.Size = Vector3.new(3.5, 3.5, 3.5)
		orb.Anchored = true
		orb.CanCollide = false
		orb.CFrame = root.CFrame * CFrame.new(0, 1, -3)
		orb.Parent = workspace

		local endPos = root.Position + (unitDir * 65)
		local tween = TweenService:Create(orb, TweenInfo.new(0.55, Enum.EasingStyle.Linear), { Position = endPos })
		tween:Play()
		tween.Completed:Connect(function()
			local blast = Instance.new("Part")
			blast.Shape = Enum.PartType.Ball
			blast.Material = Enum.Material.Neon
			blast.Color = spell.Color
			blast.Size = Vector3.new(2, 2, 2)
			blast.Anchored = true
			blast.CanCollide = false
			blast.Position = orb.Position
			blast.Parent = workspace
			TweenService:Create(blast, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = Vector3.new((spell.Radius or 10) * 2, (spell.Radius or 10) * 2, (spell.Radius or 10) * 2),
				Transparency = 1
			}):Play()
			Debris:AddItem(blast, 0.4)
			dealAreaDamage(char, orb.Position, spell.Radius or 10, spell.BasePower, spell.Color)
			orb:Destroy()
		end)

	elseif spell.SpellType == "AoE" then
		local radius = spell.Radius or 16
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder
		ring.Material = Enum.Material.Neon
		ring.Color = spell.Color
		ring.Size = Vector3.new(1, 2, 2)
		ring.Anchored = true
		ring.CanCollide = false
		ring.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
		ring.Parent = workspace

		TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = Vector3.new(1.5, radius * 2, radius * 2),
			Transparency = 1
		}):Play()
		Debris:AddItem(ring, 0.5)
		dealAreaDamage(char, root.Position, radius, spell.BasePower, spell.Color)

	elseif spell.SpellType == "DashStrike" then
		local range = spell.Range or 35
		local startPos = root.Position
		local endPos = startPos + (unitDir * range)
		local beam = Instance.new("Part")
		beam.Material = Enum.Material.Neon
		beam.Color = spell.Color
		beam.Anchored = true
		beam.CanCollide = false
		beam.Size = Vector3.new(2.5, 2.5, range)
		beam.CFrame = CFrame.lookAt((startPos + endPos) / 2, endPos)
		beam.Parent = workspace

		root.CFrame = CFrame.lookAt(endPos, endPos + unitDir)
		dealAreaDamage(char, (startPos + endPos) / 2, range * 0.6, spell.BasePower, spell.Color)
		TweenService:Create(beam, TweenInfo.new(0.35), { Size = Vector3.new(0.2, 0.2, range), Transparency = 1 }):Play()
		Debris:AddItem(beam, 0.4)

	elseif spell.SpellType == "ShieldBuff" then
		hum.Health = math.min(hum.MaxHealth, hum.Health + spell.BasePower)
		showDamageBillboard(root, spell.BasePower, Color3.fromRGB(80, 255, 120), "+")
		local shield = Instance.new("Part")
		shield.Shape = Enum.PartType.Ball
		shield.Material = Enum.Material.ForceField
		shield.Color = spell.Color
		shield.Size = Vector3.new(9, 9, 9)
		shield.Anchored = true
		shield.CanCollide = false
		shield.Position = root.Position
		shield.Parent = workspace
		TweenService:Create(shield, TweenInfo.new(1.2), { Transparency = 1, Size = Vector3.new(12, 12, 12) }):Play()
		Debris:AddItem(shield, 1.25)
	end
end

function CombatService.Init()
    local castRE = NetworkEvents.GetEvent("CastSpell")
    castRE.OnServerEvent:Connect(function(player: Player, slotIndex: any, targetPos: any)
        local slot = tonumber(slotIndex) or 1
        local pos = (typeof(targetPos) == "Vector3") and targetPos or (player.Character and player.Character:GetPivot().Position + Vector3.new(0, 0, -20)) or Vector3.zero
        CombatService.CastSpell(player, slot, pos)
    end)
    print("[CombatService] Sorts 3D prêts et branchés sur le réseau.")
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - GESTIONNAIRE UNIQUE DU PROFIL & DE L'INVENTAIRE (SERVEUR)
    Persistance des données, profil starter obligatoire (2500 Or + 4 Sorts équipés),
    mérite/classement et sécurité serveur.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local CardsDatabase = require(game.ReplicatedStorage.Shared.CardsDatabase)

local DATASTORE_NAME = "CardsAndChaos_Core_V2"
local AUTOSAVE_INTERVAL_SEC = 60

export type CardItem = {
    UUID: string,
    CardId: string,
    Name: string,
    Rarity: string,
    SpellType: string,
    BasePower: number,
    Cooldown: number,
    Level: number,
    AcquiredAt: number,
}

export type PlayerProfile = {
    UserId: number,
    Coins: number,
    Merit: number,           -- Elo / Mérite (démarrage à 1000)
    Rank: string,            -- Bronze, Argent, Or, Souverain
    Inventory: { CardItem },
    EquippedDeck: { string },-- [1] = pyro_meteor, [2] = void_chain, [3] = thunder_step, [4] = sovereign_aegis
    ClaimedRewards: { [string]: boolean },
    Stats: {
        PacksOpened: number,
        DuelsWon: number,
        DuelsLost: number,
        WinStreak: number,
    },
}

local DataManager = {}
local Profiles: { [Player]: PlayerProfile } = {}
local DataStoreInstance: DataStore? = nil

-- Initialisation du DataStore avec fallback mémoire pour Studio
local function InitDataStore()
    local success, store = pcall(function()
        return DataStoreService:GetDataStore(DATASTORE_NAME)
    end)
    if success and store then
        DataStoreInstance = store
        print("[DataManager] DataStore connecté : " .. DATASTORE_NAME)
    else
        warn("[DataManager] DataStore indisponible (Mode Studio/Offline). Utilisation du cache mémoire.")
    end
end

-- Création d'une instance de carte
function DataManager.CreateCardItem(cardId: string): CardItem?
    local def = CardsDatabase.GetCard(cardId)
    if not def then return nil end

    return {
        UUID = HttpService:GenerateGUID(false),
        CardId = def.Id,
        Name = def.Name,
        Rarity = def.Rarity,
        SpellType = def.SpellType,
        BasePower = def.BasePower,
        Cooldown = def.Cooldown,
        Level = 1,
        AcquiredAt = os.time(),
    }
end

-- Calcul du rang selon le Mérite
function DataManager.GetRankFromMerit(merit: number): string
    if merit >= 2000 then
        return "Souverain"
    elseif merit >= 1500 then
        return "Or"
    elseif merit >= 1200 then
        return "Argent"
    else
        return "Bronze"
    end
end

-- Création du Starter Pack garanti (2500 Or + 4 Sorts équipés)
local function CreateStarterProfile(userId: number): PlayerProfile
    local starterCards = {
        DataManager.CreateCardItem("pyro_meteor")!,
        DataManager.CreateCardItem("void_chain")!,
        DataManager.CreateCardItem("thunder_step")!,
        DataManager.CreateCardItem("sovereign_aegis")!,
        DataManager.CreateCardItem("blade_flurry")!,
        DataManager.CreateCardItem("crimson_slash")!,
    }

    return {
        UserId = userId,
        Coins = 2500,       -- 2500 Or offerts pour tester immédiatement les tirages et le marché !
        Merit = 1000,       -- 1000 Elo de base
        Rank = "Bronze",
        Inventory = starterCards,
        EquippedDeck = { "pyro_meteor", "void_chain", "thunder_step", "sovereign_aegis" },
        ClaimedRewards = {},
        Stats = {
            PacksOpened = 0,
            DuelsWon = 0,
            DuelsLost = 0,
            WinStreak = 0,
        },
    }
end

function DataManager.LoadProfile(player: Player): PlayerProfile
    local key = "Player_" .. player.UserId
    local profile: PlayerProfile? = nil

    if DataStoreInstance then
        local success, data = pcall(function()
            return DataStoreInstance:GetAsync(key)
        end)
        if success and data and type(data) == "table" then
            profile = data :: PlayerProfile
        end
    end

    -- Si nouveau joueur OU joueur ayant un profil vide/cassé (0 Or et 0 carte), on injecte le Starter Pack !
    if not profile or (profile.Coins == 0 and #profile.Inventory == 0) or not profile.EquippedDeck or #profile.EquippedDeck == 0 then
        profile = CreateStarterProfile(player.UserId)
    end

    -- Vérification de sécurité : s'assurer que les 4 slots sont toujours équipés
    if #profile.EquippedDeck < 4 then
        profile.EquippedDeck = { "pyro_meteor", "void_chain", "thunder_step", "sovereign_aegis" }
    end
    if profile.Coins < 1000 then
        profile.Coins = 2500
    end

    profile.Rank = DataManager.GetRankFromMerit(profile.Merit)
    Profiles[player] = profile

    print("[DataManager] Profil chargé pour " .. player.Name .. " | Or: " .. profile.Coins .. " | Mérite: " .. profile.Merit)
    return profile
end

function DataManager.SaveProfile(player: Player): boolean
    local profile = Profiles[player]
    if not profile then return false end
    if not DataStoreInstance then return true end

    local key = "Player_" .. player.UserId
    local success, err = pcall(function()
        DataStoreInstance:SetAsync(key, profile)
    end)
    if not success then
        warn("[DataManager] Erreur de sauvegarde pour " .. player.Name .. " : " .. tostring(err))
        return false
    end
    return true
end

function DataManager.ReleaseProfile(player: Player)
    DataManager.SaveProfile(player)
    Profiles[player] = nil
end

function DataManager.GetProfile(player: Player): PlayerProfile?
    return Profiles[player]
end

function DataManager.AddCoins(player: Player, amount: number)
    local prof = Profiles[player]
    if prof and amount > 0 then
        prof.Coins += math.floor(amount)
    end
end

function DataManager.DeductCoins(player: Player, amount: number): boolean
    local prof = Profiles[player]
    if not prof then return false end
    amount = math.floor(amount)
    if amount < 0 or prof.Coins < amount then
        return false
    end
    prof.Coins -= amount
    return true
end

function DataManager.AddCard(player: Player, cardId: string): CardItem?
    local prof = Profiles[player]
    if not prof then return nil end

    local item = DataManager.CreateCardItem(cardId)
    if item then
        table.insert(prof.Inventory, item)
    end
    return item
end

function DataManager.EquipCard(player: Player, cardId: string, slotIndex: number): boolean
    local prof = Profiles[player]
    if not prof or slotIndex < 1 or slotIndex > 4 then return false end

    -- Vérifie la possession
    local owns = false
    for _, c in ipairs(prof.Inventory) do
        if c.CardId == cardId then
            owns = true
            break
        end
    end
    if not owns then return false end

    prof.EquippedDeck[slotIndex] = cardId
    return true
end

function DataManager.AddMerit(player: Player, amount: number)
    local prof = Profiles[player]
    if prof then
        prof.Merit = math.max(0, prof.Merit + math.floor(amount))
        prof.Rank = DataManager.GetRankFromMerit(prof.Merit)
    end
end

function DataManager.Init()
    InitDataStore()

    task.spawn(function()
        while true do
            task.wait(AUTOSAVE_INTERVAL_SEC)
            for _, p in ipairs(Players:GetPlayers()) do
                DataManager.SaveProfile(p)
            end
        end
    end)
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">GachaManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - GESTIONNAIRE UNIQUE DU GACHA (SERVEUR)
    Tirage aléatoire pondéré (60% Common, 25% Rare, 11% Epic, 4% Legendary),
    protection de Pity et alerte mondiale serveur pour les Légendaires.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardsDatabase = require(ReplicatedStorage.Shared.CardsDatabase)
local PackConfig = require(ReplicatedStorage.Shared.PackConfig)
local NetworkEvents = require(ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

local GachaManager = {}
local pityCounters: { [number]: number } = {} -- [userId] = packsWithoutLegendary

function GachaManager.OpenPack(player: Player, packId: string)
    local prof = DataManager.GetProfile(player)
    if not prof then
        return { Success = false, Error = "Profil non chargé." }
    end

    local pack = PackConfig.GetPack(packId) or PackConfig.GetPack("pack_souverain")!

    -- Vérification et déduction atomique de l'or
    if prof.Coins < pack.CostCoins then
        return {
            Success = false,
            Error = "Or insuffisant (" .. pack.CostCoins .. " requis, vous avez " .. prof.Coins .. " Or).",
        }
    end

    local deducted = DataManager.DeductCoins(player, pack.CostCoins)
    if not deducted then
        return { Success = false, Error = "Échec de la transaction financière." }
    end

    -- Pity tracking
    local userId = player.UserId
    pityCounters[userId] = (pityCounters[userId] or 0) + 1

    local wonRarity: CardsDatabase.CardRarity = "Common"

    if pityCounters[userId] >= PackConfig.Pity.MaxPacksWithoutLegendary then
        wonRarity = "Legendary"
        pityCounters[userId] = 0
    else
        -- Tirage pondéré conforme aux taux
        local totalWeight = 0
        for _, w in pairs(pack.Weights) do
            totalWeight += w
        end
        local roll = math.random(1, totalWeight)
        local current = 0

        for _, r in ipairs({ "Legendary", "Epic", "Rare", "Common" }) do
            local w = pack.Weights[r] or 0
            current += w
            if roll <= current and w > 0 then
                wonRarity = r :: CardsDatabase.CardRarity
                break
            end
        end
    end

    if wonRarity == "Legendary" then
        pityCounters[userId] = 0
    end

    -- Sélection d'une carte de la rareté obtenue
    local pool = CardsDatabase.CardsByRarity[wonRarity]
    local chosenCard = pool[math.random(1, #pool)]
    local cardItem = DataManager.AddCard(player, chosenCard.Id)
    prof.Stats.PacksOpened += 1

    -- Alerte mondiale si carte Légendaire
    if wonRarity == "Legendary" then
        local annEv = NetworkEvents.GetEvent("ServerAnnouncement")
        annEv:FireAllClients({
            PlayerName = player.Name,
            CardName = chosenCard.Name,
            Rarity = "LÉGENDAIRE",
            RarityColor = Color3.fromRGB(245, 158, 11),
        })
    end

    return {
        Success = true,
        Card = cardItem,
        Definition = chosenCard,
        RemainingCoins = prof.Coins,
    }
end

function GachaManager.Init()
    local rf = NetworkEvents.GetFunction("RequestOpenPack")
    rf.OnServerInvoke = function(player: Player, packId: any)
        return GachaManager.OpenPack(player, tostring(packId or "pack_souverain"))
    end
    print("[GachaManager] Prêt pour les tirages.")
end

return GachaManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - ARCHITECTURE DE LA MAP, AUTELS & MANNEQUINS D'ENTRAÎNEMENT (SERVEUR)
    Génération propre de la map (ZÉRO bloc jaune fluo), 3 Mannequins d'entraînement réactifs
    avec Humanoid (1000 PV et respawn) à 30 studs du spawn, et autels interactifs.
]]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local MapBuilder = {}

local function CreatePart(props: { [string]: any }): Part
    local part = Instance.new("Part")
    part.Anchored = true
    for k, v in pairs(props) do
        (part :: any)[k] = v
    end
    return part
end

function MapBuilder.BuildEnvironment()
    -- Configuration de l'ambiance et de l'éclairage Dark Fantasy
    Lighting.Brightness = 1.8
    Lighting.ClockTime = 21.0
    Lighting.OutdoorAmbient = Color3.fromRGB(35, 30, 50)
    Lighting.Ambient = Color3.fromRGB(25, 20, 35)

    -- Nettoyage de tout ancien dossier de map pour garantir un monde propre
    local oldHub = Workspace:FindFirstChild("SovereignHub")
    if oldHub then
        oldHub:Destroy()
    end

    local hubFolder = Instance.new("Folder")
    hubFolder.Name = "SovereignHub"
    hubFolder.Parent = Workspace

    -- 1. SOL DU HUB (Dalles d'ardoise sombre élégante)
    CreatePart({
        Name = "LobbyFloor",
        Size = Vector3.new(160, 2, 160),
        Position = Vector3.new(0, 0, 0),
        Material = Enum.Material.Slate,
        Color = Color3.fromRGB(22, 24, 30),
        Parent = hubFolder,
    })

    -- Bordure fine discrète (Gris anthracite / Bleu nuit, AUCUN JAUNE FLUO)
    CreatePart({
        Name = "LobbyBorder",
        Size = Vector3.new(164, 2.2, 164),
        Position = Vector3.new(0, -0.1, 0),
        Material = Enum.Material.Cobblestone,
        Color = Color3.fromRGB(35, 40, 55),
        Parent = hubFolder,
    })

    -- 2. SPAWN LOCATION DU JOUEUR
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "MainSpawn"
    spawn.Size = Vector3.new(12, 1, 12)
    spawn.Position = Vector3.new(0, 1.2, 0)
    spawn.Anchored = true
    spawn.Material = Enum.Material.Neon
    spawn.Color = Color3.fromRGB(79, 70, 229)
    spawn.Duration = 0
    spawn.Parent = hubFolder

    -- =========================================================================
    -- 3. LES 3 MANNEQUINS D'ENTRAÎNEMENT (À 30 STUDS DU SPAWN)
    -- =========================================================================
    local function CreateDummy(name: string, position: Vector3)
        local dummy = Instance.new("Model")
        dummy.Name = name
        dummy.Parent = hubFolder

        local root = CreatePart({
            Name = "HumanoidRootPart",
            Size = Vector3.new(2, 2, 1),
            Position = position + Vector3.new(0, 3, 0),
            Transparency = 1,
            CanCollide = false,
            Parent = dummy,
        })

        local torso = CreatePart({
            Name = "Torso",
            Size = Vector3.new(2.5, 3, 1.5),
            Position = position + Vector3.new(0, 3.5, 0),
            Material = Enum.Material.WoodPlanks,
            Color = Color3.fromRGB(130, 95, 65),
            Parent = dummy,
        })

        local head = CreatePart({
            Name = "Head",
            Shape = Enum.PartType.Ball,
            Size = Vector3.new(2, 2, 2),
            Position = position + Vector3.new(0, 5.8, 0),
            Material = Enum.Material.Slate,
            Color = Color3.fromRGB(200, 205, 215),
            Parent = dummy,
        })

        local hum = Instance.new("Humanoid")
        hum.MaxHealth = 1000
        hum.Health = 1000
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Always
        hum.NameDisplayDistance = 60
        hum.HealthDisplayDistance = 60
        hum.Parent = dummy

        dummy.PrimaryPart = root

        -- Boucle d'auto-régénération
        task.spawn(function()
            while dummy.Parent do
                task.wait(2.0)
                if hum.Health < hum.MaxHealth then
                    hum.Health = math.min(hum.MaxHealth, hum.Health + 100)
                end
            end
        end)
    end

    -- 3 Mannequins disposés en demi-cercle d'entraînement face au spawn
    CreateDummy("Mannequin_Alpha (DPS)", Vector3.new(-18, 0.5, -30))
    CreateDummy("Mannequin_Beta (AOE)", Vector3.new(0, 0.5, -35))
    CreateDummy("Mannequin_Gamma (Cible)", Vector3.new(18, 0.5, -30))

    -- =========================================================================
    -- 4. AUTEL D'INVOCATION & HÔTEL DES VENTES
    -- =========================================================================
    local function CreateAltar(name: string, title: string, action: string, uiTab: string, pos: Vector3, color: Color3)
        local base = CreatePart({
            Name = name,
            Size = Vector3.new(10, 3.5, 10),
            Position = pos,
            Material = Enum.Material.Cobblestone,
            Color = Color3.fromRGB(25, 28, 38),
            Parent = hubFolder,
        })
        base:SetAttribute("TargetUI", uiTab)

        local crystal = CreatePart({
            Name = "Crystal",
            Size = Vector3.new(3, 6, 3),
            Position = pos + Vector3.new(0, 5, 0),
            Material = Enum.Material.Neon,
            Color = color,
            Parent = base,
        })

        local light = Instance.new("PointLight")
        light.Color = color
        light.Range = 25
        light.Brightness = 3
        light.Parent = crystal

        local prompt = Instance.new("ProximityPrompt")
        prompt.ObjectText = title
        prompt.ActionText = action
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 15
        prompt.Parent = base
    end

    -- Autel d'Invocation (Violet néon)
    CreateAltar("AutelGacha", "Autel du Destin", "Invoquer des Sorts (E)", "Gacha", Vector3.new(-45, 1.8, 0), Color3.fromRGB(168, 85, 247))

    -- Comptoir du Marché (Émeraude)
    CreateAltar("ComptoirMarche", "Hôtel des Ventes", "Ouvrir le Marché (E)", "Market", Vector3.new(45, 1.8, 0), Color3.fromRGB(16, 185, 129))

    -- Porte de l'Arène (Rouge sang)
    CreateAltar("PorteArene", "Porte de l'Arène 1v1", "Rejoindre l'Arène (E)", "Arena", Vector3.new(0, 1.8, 45), Color3.fromRGB(239, 68, 68))

    -- =========================================================================
    -- 5. PNJ LORE : MAÎTRE DES CARTES ELDRIN (GROQ IA)
    -- =========================================================================
    local eldrin = Instance.new("Model")
    eldrin.Name = "Maitre_Eldrin"
    eldrin.Parent = hubFolder

    local eldrinRoot = CreatePart({
        Name = "HumanoidRootPart",
        Size = Vector3.new(2, 2, 1),
        Position = Vector3.new(-10, 2.5, 15),
        Transparency = 1,
        CanCollide = false,
        Parent = eldrin,
    })
    local eldrinTorso = CreatePart({
        Name = "Torso",
        Size = Vector3.new(2, 3, 1),
        Position = Vector3.new(-10, 3, 15),
        Material = Enum.Material.SmoothPlastic,
        Color = Color3.fromRGB(50, 40, 75),
        Parent = eldrin,
    })
    local eldrinHead = CreatePart({
        Name = "Head",
        Shape = Enum.PartType.Ball,
        Size = Vector3.new(1.8, 1.8, 1.8),
        Position = Vector3.new(-10, 5, 15),
        Material = Enum.Material.Neon,
        Color = Color3.fromRGB(250, 204, 21),
        Parent = eldrin,
    })

    local eldrinHum = Instance.new("Humanoid")
    eldrinHum.MaxHealth = 500
    eldrinHum.Health = 500
    eldrinHum.Parent = eldrin
    eldrin.PrimaryPart = eldrinRoot

    local eldrinPrompt = Instance.new("ProximityPrompt")
    eldrinPrompt.ObjectText = "Maître Eldrin (Guide IA)"
    eldrinPrompt.ActionText = "Parler (E)"
    eldrinPrompt.HoldDuration = 0
    eldrinPrompt.MaxActivationDistance = 14
    eldrinPrompt.Parent = eldrinRoot
    eldrinRoot:SetAttribute("TargetUI", "NPC_Eldrin")

    -- =========================================================================
    -- 6. COLISÉE CÉLESTE 1V1 (À 100 STUDS D'ALTITUDE)
    -- =========================================================================
    CreatePart({
        Name = "ColosseumFloor",
        Size = Vector3.new(120, 3, 120),
        Position = Vector3.new(0, 100, 0),
        Material = Enum.Material.DiamondPlate,
        Color = Color3.fromRGB(15, 18, 24),
        Parent = hubFolder,
    })

    CreatePart({
        Name = "ColosseumBorder",
        Size = Vector3.new(124, 3.2, 124),
        Position = Vector3.new(0, 100.1, 0),
        Material = Enum.Material.Neon,
        Color = Color3.fromRGB(239, 68, 68),
        Transparency = 0.5,
        Parent = hubFolder,
    })

    print("[MapBuilder] Hub Dark Fantasy, 3 Mannequins d'entraînement et Colisée générés avec succès.")
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MarketManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - HÔTEL DES VENTES & MARCHÉ NOIR (SERVEUR)
    4 Offres de base du Marché Noir + Ventes entre joueurs avec taxe de 5%.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardsDatabase = require(ReplicatedStorage.Shared.CardsDatabase)
local NetworkEvents = require(ReplicatedStorage.Shared.NetworkEvents)
local DataManager = require(script.Parent.DataManager)

export type MarketListing = {
    ListingId: string,
    SellerUserId: number,
    SellerName: string,
    CardId: string,
    CardName: string,
    Rarity: string,
    Price: number,
    IsNPC: boolean,
}

local MarketManager = {}
local Listings: { [string]: MarketListing } = {}

-- Initialisation des 4 offres par défaut du Marché Noir
local function InitDefaultListings()
    local defaultOffers = {
        { Id = "pyro_meteor", Seller = "Maître Eldrin", Price = 650 },
        { Id = "void_chain", Seller = "L'Ombre de la Crypte", Price = 400 },
        { Id = "thunder_step", Seller = "Recrue Stellaire", Price = 250 },
        { Id = "sovereign_aegis", Seller = "Gardien d'Obsidienne", Price = 450 },
    }

    for _, offer in ipairs(defaultOffers) do
        local def = CardsDatabase.GetCard(offer.Id)
        if def then
            local lId = "NPC_" .. offer.Id
            Listings[lId] = {
                ListingId = lId,
                SellerUserId = 0,
                SellerName = offer.Seller,
                CardId = def.Id,
                CardName = def.Name,
                Rarity = def.Rarity,
                Price = offer.Price,
                IsNPC = true,
            }
        end
    end
end

function MarketManager.GetListings()
    local list = {}
    for _, l in pairs(Listings) do
        table.insert(list, l)
    end
    table.sort(list, function(a, b)
        return a.Price < b.Price
    end)
    return list
end

function MarketManager.ListItem(player: Player, cardId: string, price: number)
    local prof = DataManager.GetProfile(player)
    if not prof then return { Success = false, Error = "Profil non chargé." } end

    price = math.floor(price)
    if price < 50 or price > 100000 then
        return { Success = false, Error = "Prix invalide (entre 50 et 100,000 Or)." }
    end

    -- Trouve et retire la carte de l'inventaire
    local foundIdx: number? = nil
    local cardName = ""
    local rarity = ""
    for idx, c in ipairs(prof.Inventory) do
        if c.CardId == cardId then
            foundIdx = idx
            cardName = c.Name
            rarity = c.Rarity
            break
        end
    end

    if not foundIdx then
        return { Success = false, Error = "Vous ne possédez pas cette carte." }
    end

    -- Empêche de vendre une carte équipée
    for _, eqId in ipairs(prof.EquippedDeck) do
        if eqId == cardId then
            return { Success = false, Error = "Déséquipez d'abord cette carte de vos 4 slots." }
        end
    end

    table.remove(prof.Inventory, foundIdx)

    local lId = HttpService:GenerateGUID(false)
    Listings[lId] = {
        ListingId = lId,
        SellerUserId = player.UserId,
        SellerName = player.Name,
        CardId = cardId,
        CardName = cardName,
        Rarity = rarity,
        Price = price,
        IsNPC = false,
    }

    return { Success = true }
end

function MarketManager.BuyItem(buyer: Player, listingId: string)
    local buyerProf = DataManager.GetProfile(buyer)
    if not buyerProf then return { Success = false, Error = "Profil non chargé." } end

    local listing = Listings[listingId]
    if not listing then return { Success = false, Error = "Offre expirée ou déjà vendue." } end

    if listing.SellerUserId == buyer.UserId then
        return { Success = false, Error = "Vous ne pouvez pas acheter votre propre offre." }
    end

    if buyerProf.Coins < listing.Price then
        return { Success = false, Error = "Or insuffisant." }
    end

    -- Déduction de l'acheteur
    DataManager.DeductCoins(buyer, listing.Price)

    -- Si offre joueur : versement au vendeur moins 5% de taxe
    if not listing.IsNPC and listing.SellerUserId > 0 then
        local tax = math.floor(listing.Price * 0.05)
        local netGain = listing.Price - tax
        local sellerPlayer = Players:GetPlayerByUserId(listing.SellerUserId)
        if sellerPlayer then
            DataManager.AddCoins(sellerPlayer, netGain)
            local toast = NetworkEvents.GetEvent("ToastNotify")
            toast:FireClient(sellerPlayer, "Votre carte '" .. listing.CardName .. "' a été vendue pour " .. netGain .. " Or !")
        end
    end

    -- Attribution de la carte à l'acheteur
    DataManager.AddCard(buyer, listing.CardId)

    -- Si offre joueur, retrait du marché. Si offre PNJ, elle reste disponible
    if not listing.IsNPC then
        Listings[listingId] = nil
    end

    return { Success = true, RemainingCoins = buyerProf.Coins }
end

function MarketManager.Init()
    InitDefaultListings()

    local getRF = NetworkEvents.GetFunction("GetMarketListings")
    getRF.OnServerInvoke = function()
        return MarketManager.GetListings()
    end

    local listRF = NetworkEvents.GetFunction("ListMarketItem")
    listRF.OnServerInvoke = function(player: Player, cardId: any, price: any)
        return MarketManager.ListItem(player, tostring(cardId), tonumber(price) or 0)
    end

    local buyRF = NetworkEvents.GetFunction("BuyMarketItem")
    buyRF.OnServerInvoke = function(player: Player, listingId: any)
        return MarketManager.BuyItem(player, tostring(listingId))
    end

    print("[MarketManager] Marché Noir et Hôtel des Ventes initialisés.")
end

return MarketManager
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="15">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
