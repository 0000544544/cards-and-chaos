      <Item class="LocalScript" referent="26">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
    SOVEREIGN: CARDS & DOMINION - CLIENT PRINCIPAL
    Point d'entrée côté joueur : initialise l'interface utilisateur (HUD, Codex, Gacha, Marché, Arène),
    le contrôleur de combat réactif (clavier/mobile) et la détection des autels interactifs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIManager = require(script.ui.UIManager)
local CombatController = require(script.CombatController)
local InteractionController = require(script.InteractionController)

print("========================================================")
print("  SOVEREIGN: CARDS & DOMINION (ROBLOX CLIENT)")
print("  Initialisation du client...")
print("========================================================")

-- Initialisation de l'interface graphique procédurale
UIManager.Init()

-- Initialisation des contrôles de combat (1-4 compétences, Q Dash, F Parry)
CombatController.Init()

-- Initialisation des interactions physiques avec les autels du Hub
InteractionController.Init(function(tabName: string)
    UIManager.OpenTab(tabName)
end)

print("[Client] Prêt au combat ! Utilisez les touches 1 à 4 pour vos cartes, Q pour esquiver et F pour parer.")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    COMBAT CONTROLLER (COMMANDES JOUEUR, COMBOS, DASH & PARADE)
    Gestion des entrées clavier (1-4 pour les compétences, A/Q pour le Dash, F pour le Parry),
    retour visuel et sonore immédiat, et synchronisation des effets de combat.
]]

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Network = require(game.ReplicatedStorage.Shared.NetworkEvents)

local player = Players.LocalPlayer
local CombatController = {}

local Cooldowns: { [number]: number } = {
    [1] = 0,
    [2] = 0,
    [3] = 0,
    [4] = 0,
    Dash = 0,
    Parry = 0,
}

-- Effet visuel local d'onde de choc / flash
local function CreateShockwave(pos: Vector3, color: Color3)
    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Cylinder
    p.Size = Vector3.new(0.5, 2, 2)
    p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
    p.Material = Enum.Material.Neon
    p.Color = color
    p.Anchored = true
    p.CanCollide = false
    p.Parent = workspace

    local tween = TweenService:Create(p, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(0.2, 35, 35),
        Transparency = 1,
    })
    tween:Play()
    Debris:AddItem(p, 0.45)
end

function CombatController.Init()
    local castSkillRE = Network.GetEvent("CastSkill")
    local performActionRE = Network.GetEvent("PerformAction")
    local combatVfxRE = Network.GetEvent("CombatVFX")

    -- Écouteur des touches clavier
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end

        local now = os.clock()

        -- Touches 1, 2, 3, 4 : Compétences actives
        if input.KeyCode == Enum.KeyCode.One then
            castSkillRE:FireServer(1)
        elseif input.KeyCode == Enum.KeyCode.Two then
            castSkillRE:FireServer(2)
        elseif input.KeyCode == Enum.KeyCode.Three then
            castSkillRE:FireServer(3)
        elseif input.KeyCode == Enum.KeyCode.Four then
            castSkillRE:FireServer(4)
        -- Touche Q ou A : Dash (I-frame)
        elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.A then
            if (now - Cooldowns.Dash) >= 3.0 then
                Cooldowns.Dash = now
                performActionRE:FireServer("Dash")
            end
        -- Touche F : Parade / Parry
        elseif input.KeyCode == Enum.KeyCode.F then
            if (now - Cooldowns.Parry) >= 2.0 then
                Cooldowns.Parry = now
                performActionRE:FireServer("Parry")
            end
        end
    end)

    -- Réception des effets visuels envoyés par le serveur
    combatVfxRE.OnClientEvent:Connect(function(data)
        if data.Type == "ParrySuccess" and data.Position then
            CreateShockwave(data.Position, Color3.fromRGB(250, 204, 21))
        elseif data.Type == "Dash" and data.Position then
            CreateShockwave(data.Position, Color3.fromRGB(56, 189, 248))
        elseif data.Position and data.Color then
            CreateShockwave(data.Position, data.Color)
        end
    end)
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">InteractionController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    INTERACTION CONTROLLER
    Détection des interactions avec les autels du Hub et ouverture automatique des interfaces correspondantes.
]]

local ProximityPromptService = game:GetService("ProximityPromptService")

local InteractionController = {}

function InteractionController.Init(openUITabCallback: (tabName: string) -> ())
    ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
        local parentPart = prompt.Parent :: Instance?
        if parentPart then
            local uiName = parentPart:GetAttribute("TargetUI")
            if uiName and type(uiName) == "string" then
                openUITabCallback(uiName)
            end
        end
    end)
end

return InteractionController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">PackOpeningController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - ANIMATION D'OUVERTURE DE PACK (CLIENT)
    Animation cinématographique de révélation de carte : carte qui flotte, tourne,
    irradie de particules d'aura, se retourne (Card Flip) et explose aux couleurs de sa rareté.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local CardsDatabase = require(game.ReplicatedStorage.Shared.CardsDatabase)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

local PackOpeningController = {}

local RarityColors: { [CardsDatabase.CardRarity]: Color3 } = {
    Common = Color3.fromRGB(180, 190, 205),
    Rare = Color3.fromRGB(56, 189, 248),
    Epic = Color3.fromRGB(168, 85, 247),
    Legendary = Color3.fromRGB(245, 158, 11),
}

-- Création de l'interface d'animation de tirage
function PackOpeningController.PlayRevealAnimation(cardInstance: any, onComplete: (() -> ())?)
    local screenGui = playerGui:FindFirstChild("PackRevealGui") :: ScreenGui?
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "PackRevealGui"
        screenGui.ResetOnSpawn = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.Parent = playerGui
    end
    screenGui:ClearAllChildren()

    local rarity = (cardInstance.Rarity or "Common") :: CardsDatabase.CardRarity
    local glowColor = RarityColors[rarity] or Color3.fromRGB(255, 255, 255)

    -- Fond assombri avec flou cinématique
    local backdrop = Instance.new("Frame")
    backdrop.Size = UDim2.new(1, 0, 1, 0)
    backdrop.BackgroundColor3 = Color3.fromRGB(5, 7, 12)
    backdrop.BackgroundTransparency = 1
    backdrop.Parent = screenGui

    local fadeBackdrop = TweenService:Create(backdrop, TweenInfo.new(0.35), { BackgroundTransparency = 0.25 })
    fadeBackdrop:Play()

    -- Conteneur central de la carte
    local cardHolder = Instance.new("Frame")
    cardHolder.Size = UDim2.new(0, 240, 0, 360)
    cardHolder.Position = UDim2.new(0.5, -120, 0.5, -180)
    cardHolder.BackgroundTransparency = 1
    cardHolder.Parent = backdrop

    -- Dos de la carte (Initialement visible)
    local cardBack = Instance.new("Frame")
    cardBack.Size = UDim2.new(1, 0, 1, 0)
    cardBack.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
    cardBack.Parent = cardHolder

    local corner1 = Instance.new("UICorner")
    corner1.CornerRadius = UDim.new(0, 12)
    corner1.Parent = cardBack

    local stroke1 = Instance.new("UIStroke")
    stroke1.Color = Color3.fromRGB(99, 102, 241)
    stroke1.Thickness = 3
    stroke1.Parent = cardBack

    local backLogo = Instance.new("TextLabel")
    backLogo.Size = UDim2.new(1, 0, 1, 0)
    backLogo.BackgroundTransparency = 1
    backLogo.Font = Enum.Font.GothamBold
    backLogo.TextSize = 24
    backLogo.TextColor3 = Color3.fromRGB(168, 85, 247)
    backLogo.Text = "CARDS\n&\nCHAOS"
    backLogo.Parent = cardBack

    -- Face avant de la carte (Révélée après le retournement)
    local cardFront = Instance.new("Frame")
    cardFront.Size = UDim2.new(1, 0, 1, 0)
    cardFront.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
    cardFront.Visible = false
    cardFront.Parent = cardHolder

    local corner2 = Instance.new("UICorner")
    corner2.CornerRadius = UDim.new(0, 12)
    corner2.Parent = cardFront

    local stroke2 = Instance.new("UIStroke")
    stroke2.Color = glowColor
    stroke2.Thickness = (rarity == "Legendary") and 4 or 2.5
    stroke2.Parent = cardFront

    -- Rendu de l'illustration (Decal ComfyUI)
    local cardImage = Instance.new("ImageLabel")
    cardImage.Size = UDim2.new(1, -20, 0, 170)
    cardImage.Position = UDim2.new(0, 10, 0, 10)
    cardImage.BackgroundColor3 = Color3.fromRGB(30, 41, 59)
    cardImage.Image = cardInstance.AssetId or "rbxassetid://13880479100"
    cardImage.ScaleType = Enum.ScaleType.Fit
    cardImage.Parent = cardFront

    local imgCorner = Instance.new("UICorner")
    imgCorner.CornerRadius = UDim.new(0, 8)
    imgCorner.Parent = cardImage

    -- Nom & Rareté
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -20, 0, 30)
    nameLabel.Position = UDim2.new(0, 10, 0, 190)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 16
    nameLabel.TextColor3 = glowColor
    nameLabel.Text = cardInstance.Name
    nameLabel.Parent = cardFront

    local typeLabel = Instance.new("TextLabel")
    typeLabel.Size = UDim2.new(1, -20, 0, 20)
    typeLabel.Position = UDim2.new(0, 10, 0, 220)
    typeLabel.BackgroundTransparency = 1
    typeLabel.Font = Enum.Font.Gotham
    typeLabel.TextSize = 12
    typeLabel.TextColor3 = Color3.fromRGB(148, 163, 184)
    typeLabel.Text = string.upper(tostring(cardInstance.Type or "Aptitude")) .. " • " .. string.upper(tostring(rarity))
    typeLabel.Parent = cardFront

    -- Statistique de Puissance (BasePower)
    local powerLabel = Instance.new("TextLabel")
    powerLabel.Size = UDim2.new(1, -20, 0, 40)
    powerLabel.Position = UDim2.new(0, 10, 0, 250)
    powerLabel.BackgroundTransparency = 1
    powerLabel.Font = Enum.Font.GothamBold
    powerLabel.TextSize = 22
    powerLabel.TextColor3 = Color3.fromRGB(248, 250, 252)
    powerLabel.Text = "⚡ PUISSANCE : " .. tostring(cardInstance.BasePower or 50)
    powerLabel.Parent = cardFront

    -- Bouton de confirmation
    local collectBtn = Instance.new("TextButton")
    collectBtn.Size = UDim2.new(1, -40, 0, 40)
    collectBtn.Position = UDim2.new(0, 20, 1, -55)
    collectBtn.BackgroundColor3 = glowColor
    collectBtn.TextColor3 = Color3.fromRGB(15, 23, 42)
    collectBtn.Font = Enum.Font.GothamBold
    collectBtn.TextSize = 14
    collectBtn.Text = "RÉCUPÉRER LA CARTE"
    collectBtn.Parent = cardFront

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = collectBtn

    -- =========================================================================
    -- SÉQUENCE CINÉMATIQUE (TWEENING)
    -- =========================================================================
    cardHolder.Position = UDim2.new(0.5, -120, 0.7, -180)
    cardHolder.Size = UDim2.new(0, 80, 0, 120)

    -- Phase 1 : Montée et flottement
    local riseTween = TweenService:Create(cardHolder, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -120, 0.5, -180),
        Size = UDim2.new(0, 240, 0, 360),
    })
    riseTween:Play()
    riseTween.Completed:Wait()

    -- Phase 2 : Retournement 3D (Simulation Flip horizontal)
    local flipHalf1 = TweenService:Create(cardHolder, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 360),
    })
    flipHalf1:Play()
    flipHalf1.Completed:Wait()

    cardBack.Visible = false
    cardFront.Visible = true

    local flipHalf2 = TweenService:Create(cardHolder, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 240, 0, 360),
    })
    flipHalf2:Play()

    -- Phase 3 : Fermeture
    collectBtn.MouseButton1Click:Connect(function()
        local closeTween = TweenService:Create(backdrop, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            screenGui:Destroy()
            if onComplete then onComplete() end
        end)
    end)
end

return PackOpeningController
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="30">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">UIManager</string>
              <string name="Source"><![CDATA[--!strict
--[[
    UI MANAGER (INTERFACE DARK FANTASY & NEON GLASSMORPHISM)
    Génération procédurale complète du HUD, barre de navigation, modales (Deck, Gacha, Marché, Échange, Arène, Mérite),
    HUD de combat 1v1 avec barres de recharge, toasts et bannières d'annonces mondiales.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Network = require(ReplicatedStorage.Shared.NetworkEvents)
local RarityConfig = require(ReplicatedStorage.Shared.RarityConfig)
local CardsData = require(ReplicatedStorage.Shared.CardsData)
local RankConfig = require(ReplicatedStorage.Shared.RankConfig)
local PackOpeningController = require(script.Parent.Parent.PackOpeningController)

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui

local UIManager = {}

-- Variables d'état local
local CachedData: any = nil
local CurrentTab: string? = nil

-- Références UI
local ScreenGui: ScreenGui
local TopBar: Frame
local ModalContainer: Frame
local ModalTitle: TextLabel
local ModalContent: Frame
local ArenaHUD: Frame
local BannerFrame: Frame
local ToastContainer: Frame

-- Fonction utilitaire de création d'éléments UI avec style uniforme
local function CreateUI(className: string, properties: { [string]: any }): any
    local inst = Instance.new(className)
    for k, v in pairs(properties) do
        (inst :: any)[k] = v
    end
    return inst
end

local function ApplyCorner(instance: Instance, radius: number?)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = instance
end

local function ApplyStroke(instance: Instance, color: Color3, thickness: number?)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness or 1.5
    stroke.Parent = instance
end

-- =============================================================================
-- SYSTÈME DE TOAST & BANNIÈRE MONDIALE
-- =============================================================================
function UIManager.ShowToast(message: string, isError: boolean?)
    local toast = CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = isError and Color3.fromRGB(185, 28, 28) or Color3.fromRGB(30, 41, 59),
        TextColor3 = Color3.fromRGB(248, 250, 252),
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        Text = message,
        TextTransparency = 1,
        Parent = ToastContainer,
    })
    ApplyCorner(toast, 6)
    ApplyStroke(toast, isError and Color3.fromRGB(239, 68, 68) or Color3.fromRGB(71, 85, 105), 1)

    local tweenIn = TweenService:Create(toast, TweenInfo.new(0.25), { TextTransparency = 0 })
    tweenIn:Play()

    task.delay(3.5, function()
        local tweenOut = TweenService:Create(toast, TweenInfo.new(0.3), { TextTransparency = 1 })
        tweenOut:Play()
        tweenOut.Completed:Connect(function()
            toast:Destroy()
        end)
    end)
end

function UIManager.ShowServerAnnouncement(data: any)
    local text = "✨ [ANNONCE MONDIALE] " .. data.PlayerName .. " a tiré " .. data.CardName .. " (" .. data.Rarity .. ") !"
    local banner = CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(15, 23, 42),
        BackgroundTransparency = 0.1,
        TextColor3 = data.IsDivine and Color3.fromRGB(250, 204, 21) or Color3.fromRGB(248, 113, 113),
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        Text = text,
        Parent = BannerFrame,
    })
    ApplyCorner(banner, 8)
    ApplyStroke(banner, data.RarityColor or Color3.fromRGB(250, 204, 21), 2)

    BannerFrame.Position = UDim2.new(0.5, -300, 0, -60)
    BannerFrame.Visible = true

    local tweenDown = TweenService:Create(BannerFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -300, 0, 70),
    })
    tweenDown:Play()

    task.delay(5, function()
        local tweenUp = TweenService:Create(BannerFrame, TweenInfo.new(0.4), {
            Position = UDim2.new(0.5, -300, 0, -60),
        })
        tweenUp:Play()
        tweenUp.Completed:Connect(function()
            banner:Destroy()
            BannerFrame.Visible = false
        end)
    end)
end

-- Chiffres de dégâts 3D flottants au-dessus de la cible
function UIManager.ShowDamageNumber(pos: Vector3, damage: number, isPrestige: boolean, color: Color3)
    local part = Instance.new("Part")
    part.Size = Vector3.new(1, 1, 1)
    part.Position = pos + Vector3.new(math.random(-10, 10) * 0.08, 0, math.random(-10, 10) * 0.08)
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.Parent = workspace

    local bg = Instance.new("BillboardGui")
    bg.Size = UDim2.new(0, 150, 0, 40)
    bg.AlwaysOnTop = true
    bg.Adornee = part
    bg.Parent = part

    local label = CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = (isPrestige and "💥 -" or "-") .. tostring(damage) .. (isPrestige and " [PRESTIGE]" or ""),
        TextColor3 = color,
        Font = Enum.Font.GothamBold,
        TextSize = isPrestige and 24 or 18,
        Parent = bg,
    })
    ApplyStroke(label, Color3.fromRGB(0, 0, 0), 2)

    local tween = TweenService:Create(part, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = part.Position + Vector3.new(0, 4.5, 0),
    })
    local fade = TweenService:Create(label, TweenInfo.new(0.85), {
        TextTransparency = 1,
    })
    tween:Play()
    fade:Play()

    task.delay(0.9, function()
        part:Destroy()
    end)
end

-- =============================================================================
-- RAFRAÎCHISSEMENT DU HUD SUPÉRIEUR (MONNAIE, ÉLO, MÉRITE)
-- =============================================================================
function UIManager.RefreshTopBar()
    if not CachedData then return end

    local coinsLabel = TopBar:FindFirstChild("CoinsLabel") :: TextLabel?
    if coinsLabel then
        coinsLabel.Text = "🪙 " .. string.format("%d", CachedData.Coins) .. " Or"
    end

    local meritLabel = TopBar:FindFirstChild("MeritLabel") :: TextLabel?
    if meritLabel then
        meritLabel.Text = "⚡ " .. string.format("%d", CachedData.Merit) .. " Mérite"
    end

    local eloLabel = TopBar:FindFirstChild("EloLabel") :: TextLabel?
    if eloLabel then
        local tier = RankConfig.GetTierFromElo(CachedData.Elo)
        eloLabel.Text = "🏆 " .. tier.Name .. " (" .. CachedData.Elo .. " Elo)"
        eloLabel.TextColor3 = tier.Color
    end

    local streakLabel = TopBar:FindFirstChild("StreakLabel") :: TextLabel?
    if streakLabel then
        local streak = (CachedData.Stats and CachedData.Stats.CurrentStreak) or 0
        streakLabel.Text = "🔥 Série : " .. streak
    end
end

-- =============================================================================
-- CONTENUS DES ONGLETS
-- =============================================================================

-- 1. ONGLET DECK (INVENTAIRE, ÉQUIPEMENT & SYNERGIES)
local function RenderDeckTab()
    ModalContent:ClearAllChildren()

    local activeDeckFrame = CreateUI("Frame", {
        Size = UDim2.new(1, 0, 0, 110),
        BackgroundColor3 = Color3.fromRGB(15, 23, 42),
        BackgroundTransparency = 0.5,
        Parent = ModalContent,
    })
    ApplyCorner(activeDeckFrame, 8)
    ApplyStroke(activeDeckFrame, Color3.fromRGB(51, 65, 85))

    local title = CreateUI("TextLabel", {
        Size = UDim2.new(1, -20, 0, 24),
        Position = UDim2.new(0, 10, 0, 5),
        BackgroundTransparency = 1,
        Text = "DECK ACTIF (4 Compétences + 2 Passives) :",
        TextColor3 = Color3.fromRGB(203, 213, 225),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = activeDeckFrame,
    })

    -- Affichage des 4 slots actifs
    for slot = 1, 4 do
        local uid = CachedData.EquippedDeck.Actives[slot]
        local cardName = "[Vide]"
        local cardColor = Color3.fromRGB(100, 116, 139)
        if uid then
            for _, c in ipairs(CachedData.Inventory) do
                if c.UniqueId == uid then
                    local def = CardsData.GetCard(c.CardId)
                    if def then
                        cardName = def.Name
                        local rInfo = RarityConfig.Rarities[def.Rarity]
                        if rInfo then cardColor = rInfo.Color end
                    end
                    break
                end
            end
        end

        local slotBtn = CreateUI("TextButton", {
            Size = UDim2.new(0.15, -6, 0, 60),
            Position = UDim2.new((slot - 1) * 0.16 + 0.01, 0, 0, 35),
            BackgroundColor3 = Color3.fromRGB(30, 41, 59),
            TextColor3 = cardColor,
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            TextWrapped = true,
            Text = tostring(slot) .. "\n" .. cardName,
            Parent = activeDeckFrame,
        })
        ApplyCorner(slotBtn, 6)
        ApplyStroke(slotBtn, cardColor, 1.5)
    end

    -- Grille de toutes les cartes possédées
    local scroll = CreateUI("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -125),
        Position = UDim2.new(0, 0, 0, 120),
        BackgroundTransparency = 1,
        ScrollBarThickness = 6,
        CanvasSize = UDim2.new(0, 0, 0, math.ceil(#CachedData.Inventory / 4) * 90),
        Parent = ModalContent,
    })

    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0.23, 0, 0, 80)
    grid.CellPadding = UDim2.new(0.02, 0, 0, 8)
    grid.Parent = scroll

    for _, c in ipairs(CachedData.Inventory) do
        local def = CardsData.GetCard(c.CardId)
        if def then
            local rInfo = RarityConfig.Rarities[def.Rarity]
            local cardFrame = CreateUI("TextButton", {
                BackgroundColor3 = Color3.fromRGB(30, 41, 59),
                TextColor3 = rInfo.Color,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextWrapped = true,
                Text = def.Name .. "\n(" .. rInfo.Name .. ")" .. (c.Prestige and " [PRESTIGE]" or ""),
                Parent = scroll,
            })
            ApplyCorner(cardFrame, 6)
            ApplyStroke(cardFrame, rInfo.Color, c.Prestige and 2.5 or 1)

            -- Clic pour équiper
            cardFrame.MouseButton1Click:Connect(function()
                if def.Type == "Active" then
                    -- Équipe dans le premier slot disponible
                    table.remove(CachedData.EquippedDeck.Actives, 1)
                    table.insert(CachedData.EquippedDeck.Actives, c.UniqueId)
                else
                    table.remove(CachedData.EquippedDeck.Passives, 1)
                    table.insert(CachedData.EquippedDeck.Passives, c.UniqueId)
                end
                local equipRF = Network.GetFunction("EquipDeck")
                equipRF:InvokeServer(CachedData.EquippedDeck)
                UIManager.ShowToast("Deck mis à jour : " .. def.Name .. " équipé !")
                RenderDeckTab()
            end)
        end
    end
end

-- 2. ONGLET GACHA (BOUTIQUE DE PACKS & TRANSPARENCE ROBLOX)
local function RenderGachaTab()
    ModalContent:ClearAllChildren()

    local altarCard = CreateUI("Frame", {
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundColor3 = Color3.fromRGB(24, 24, 38),
        Parent = ModalContent,
    })
    ApplyCorner(altarCard, 10)
    ApplyStroke(altarCard, Color3.fromRGB(168, 85, 247), 1.5)

    CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundTransparency = 1,
        Text = "⚡ OUVERTURE DE PACKS - PROBABILITÉS TRANSPARENTES ⚡",
        TextColor3 = Color3.fromRGB(245, 158, 11),
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        Parent = altarCard,
    })

    CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 0, 25),
        Position = UDim2.new(0, 0, 0, 38),
        BackgroundTransparency = 1,
        Text = "Protection Pity active : 1 Légendaire garantie au 50ème paquet | Taux certifiés conformes",
        TextColor3 = Color3.fromRGB(148, 163, 184),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        Parent = altarCard,
    })

    -- Liste des 3 Packs
    local packContainer = CreateUI("Frame", {
        Size = UDim2.new(1, 0, 1, -85),
        Position = UDim2.new(0, 0, 0, 80),
        BackgroundTransparency = 1,
        Parent = ModalContent,
    })

    local packList = {
        {
            Id = "starter_pack",
            Name = "Pack Débutant",
            Cost = 100,
            Odds = "Commun: 60% | Rare: 25% | Épique: 11% | Légendaire: 4%",
            Color = Color3.fromRGB(79, 70, 229),
        },
        {
            Id = "chaos_pack",
            Name = "Pack Chaos",
            Cost = 500,
            Odds = "Commun: 30% | Rare: 42% | Épique: 20% | Légendaire: 8%",
            Color = Color3.fromRGB(217, 70, 239),
        },
        {
            Id = "sovereign_pack",
            Name = "Pack du Souverain",
            Cost = 1500,
            Odds = "0% Commun | Rare: 35% | Épique: 45% | Légendaire: 20%",
            Color = Color3.fromRGB(245, 158, 11),
        },
    }

    local function TriggerOpenPack(packId: string)
        local openPackRF = Network.GetFunction("RequestOpenPack")
        local res = openPackRF:InvokeServer(packId)
        if res.Success and res.Card then
            UIManager.CloseModal()
            PackOpeningController.PlayRevealAnimation(res.Card, function()
                UIManager.FetchData()
                UIManager.ShowToast("✨ " .. res.Card.Name .. " (" .. res.Card.Rarity .. ") ajouté à votre inventaire !")
            end)
        else
            UIManager.ShowToast(res.Error or "Échec de l'ouverture du pack", true)
        end
    end

    for pIdx, pInfo in ipairs(packList) do
        local packCard = CreateUI("Frame", {
            Size = UDim2.new(0.31, 0, 0, 220),
            Position = UDim2.new((pIdx - 1) * 0.34 + 0.01, 0, 0, 10),
            BackgroundColor3 = Color3.fromRGB(30, 41, 59),
            Parent = packContainer,
        })
        ApplyCorner(packCard, 10)
        ApplyStroke(packCard, pInfo.Color, 2)

        CreateUI("TextLabel", {
            Size = UDim2.new(1, -10, 0, 36),
            Position = UDim2.new(0, 5, 0, 10),
            BackgroundTransparency = 1,
            Text = pInfo.Name,
            TextColor3 = pInfo.Color,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            Parent = packCard,
        })

        CreateUI("TextLabel", {
            Size = UDim2.new(1, -16, 0, 70),
            Position = UDim2.new(0, 8, 0, 50),
            BackgroundTransparency = 1,
            Text = "Taux garantis :\n" .. pInfo.Odds,
            TextColor3 = Color3.fromRGB(203, 213, 225),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextWrapped = true,
            Parent = packCard,
        })

        local openBtn = CreateUI("TextButton", {
            Size = UDim2.new(1, -20, 0, 44),
            Position = UDim2.new(0, 10, 1, -55),
            BackgroundColor3 = pInfo.Color,
            TextColor3 = Color3.fromRGB(15, 23, 42),
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            Text = "OUVRIR (" .. pInfo.Cost .. " Or)",
            Parent = packCard,
        })
        ApplyCorner(openBtn, 8)

        openBtn.MouseButton1Click:Connect(function()
            TriggerOpenPack(pInfo.Id)
        end)
    end
end

-- 3. ONGLET MARCHÉ (HÔTEL DES VENTES & ACHAT-REVENTE)
local function RenderMarketTab()
    ModalContent:ClearAllChildren()

    local header = CreateUI("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Color3.fromRGB(15, 23, 42),
        Parent = ModalContent,
    })
    ApplyCorner(header, 6)

    CreateUI("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = "BOURSE DES CARTES (Taxe 5% - Anti-Inflation)",
        TextColor3 = Color3.fromRGB(52, 211, 153),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })

    -- Bouton de mise en vente
    local sellBtn = CreateUI("TextButton", {
        Size = UDim2.new(0.35, -10, 0, 36),
        Position = UDim2.new(0.65, 0, 0, 7),
        BackgroundColor3 = Color3.fromRGB(16, 185, 129),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Text = "+ Mettre en Vente",
        Parent = header,
    })
    ApplyCorner(sellBtn, 6)

    local listingsScroll = CreateUI("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -65),
        Position = UDim2.new(0, 0, 0, 60),
        BackgroundTransparency = 1,
        ScrollBarThickness = 6,
        CanvasSize = UDim2.new(0, 0, 0, 400),
        Parent = ModalContent,
    })

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 6)
    listLayout.Parent = listingsScroll

    local getListingsRF = Network.GetFunction("GetMarketListings")
    local listings = getListingsRF:InvokeServer() or {}

    if #listings == 0 then
        CreateUI("TextLabel", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundTransparency = 1,
            Text = "Aucune carte en vente pour le moment. Soyez le premier à commercer !",
            TextColor3 = Color3.fromRGB(148, 163, 184),
            Font = Enum.Font.Gotham,
            TextSize = 13,
            Parent = listingsScroll,
        })
    end

    for _, l in ipairs(listings) do
        local def = CardsData.GetCard(l.CardInstance.CardId)
        if def then
            local rInfo = RarityConfig.Rarities[def.Rarity]
            local row = CreateUI("Frame", {
                Size = UDim2.new(1, -10, 0, 48),
                BackgroundColor3 = Color3.fromRGB(30, 41, 59),
                Parent = listingsScroll,
            })
            ApplyCorner(row, 6)
            ApplyStroke(row, rInfo.Color, 1)

            CreateUI("TextLabel", {
                Size = UDim2.new(0.4, 0, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                TextColor3 = rInfo.Color,
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = def.Name .. " (" .. rInfo.Name .. ")",
                Parent = row,
            })

            CreateUI("TextLabel", {
                Size = UDim2.new(0.25, 0, 1, 0),
                Position = UDim2.new(0.4, 0, 0, 0),
                BackgroundTransparency = 1,
                TextColor3 = Color3.fromRGB(148, 163, 184),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                Text = "Par : " .. l.SellerName,
                Parent = row,
            })

            local buyBtn = CreateUI("TextButton", {
                Size = UDim2.new(0.25, 0, 0, 32),
                Position = UDim2.new(0.72, 0, 0, 8),
                BackgroundColor3 = Color3.fromRGB(5, 150, 105),
                TextColor3 = Color3.fromRGB(255, 255, 255),
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                Text = "Acheter (" .. l.PriceCoins .. " Or)",
                Parent = row,
            })
            ApplyCorner(buyBtn, 6)

            buyBtn.MouseButton1Click:Connect(function()
                local buyRF = Network.GetFunction("BuyMarketItem")
                local res = buyRF:InvokeServer(l.ListingId)
                if res.Success then
                    UIManager.ShowToast("Achat réussi !")
                    UIManager.FetchData()
                    RenderMarketTab()
                else
                    UIManager.ShowToast(res.Error or "Échec de l'achat", true)
                end
            end)
        end
    end

    sellBtn.MouseButton1Click:Connect(function()
        -- Mise en vente de la première carte disponible non équipée
        if #CachedData.Inventory > 0 then
            local cardToSell = CachedData.Inventory[1]
            local listRF = Network.GetFunction("ListMarketItem")
            local res = listRF:InvokeServer(cardToSell.UniqueId, 250)
            if res.Success then
                UIManager.ShowToast("Carte mise en vente pour 250 Or !")
                UIManager.FetchData()
                RenderMarketTab()
            else
                UIManager.ShowToast(res.Error or "Erreur de mise en vente", true)
            end
        else
            UIManager.ShowToast("Aucune carte à vendre.", true)
        end
    end)
end

