      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">NetworkEvents</string>
          <string name="Source"><![CDATA[--!strict
--[[
    NETWORK REMOTES & RPC CONTRACT
    Définition et initialisation des RemoteEvents et RemoteFunctions pour la réplication réseau client/serveur.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RemoteFunctions = {
    "GetPlayerData",
    "RollGacha",
    "EquipDeck",
    "GetMarketListings",
    "ListMarketItem",
    "BuyMarketItem",
    "CancelMarketItem",
    "SendTradeRequest",
    "RespondTradeRequest",
    "ConfirmTrade",
    "JoinArenaQueue",
    "LeaveArenaQueue",
    "PrestigeCard",
    "RecycleCard",
    "DevAction",
    "RequestOpenPack",
}

local RemoteEvents = {
    "CastSkill",
    "PerformAction",        -- Dash (Q) / Parry (F)
    "UpdateTradeOffer",
    "CancelTrade",
    "ServerAnnouncement",   -- Broadcast mondial pour les cartes mythiques/divines
    "MatchStateChanged",    -- Info match (Countdown, VS, Round, Victory/Defeat)
    "CombatVFX",            -- Sync visuels d'impact, trails, explosions
    "ToastNotify",          -- Messages de succès/erreur au joueur
    "DamageIndicator",      -- Chiffres de dégâts 3D au-dessus de la cible
}

local Network = {}

local function GetFolder(): Folder
    local folder = ReplicatedStorage:FindFirstChild("NetworkRemotes") :: Folder?
    if not folder then
        if RunService:IsServer() then
            folder = Instance.new("Folder")
            folder.Name = "NetworkRemotes"
            folder.Parent = ReplicatedStorage
        else
            folder = ReplicatedStorage:WaitForChild("NetworkRemotes", 10) :: Folder
        end
    end
    return folder :: Folder
end

-- Initialisation côté Serveur
function Network.InitServer()
    local folder = GetFolder()
    for _, name in ipairs(RemoteFunctions) do
        if not folder:FindFirstChild(name) then
            local rf = Instance.new("RemoteFunction")
            rf.Name = name
            rf.Parent = folder
        end
    end
    for _, name in ipairs(RemoteEvents) do
        if not folder:FindFirstChild(name) then
            local re = Instance.new("RemoteEvent")
            re.Name = name
            re.Parent = folder
        end
    end
end

-- Récupération d'une RemoteFunction
function Network.GetFunction(name: string): RemoteFunction
    local folder = GetFolder()
    local rf = folder:WaitForChild(name, 10)
    assert(rf and rf:IsA("RemoteFunction"), "RemoteFunction absente: " .. name)
    return rf :: RemoteFunction
end

-- Récupération d'un RemoteEvent
function Network.GetEvent(name: string): RemoteEvent
    local folder = GetFolder()
    local re = folder:WaitForChild(name, 10)
    assert(re and re:IsA("RemoteEvent"), "RemoteEvent absent: " .. name)
    return re :: RemoteEvent
end

return Network
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">PackConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - CONFIGURATION DES PACKS DE GACHA
    Probabilités de tirage transparentes (Conformes aux règles Roblox de Gambling éthique),
    coûts en Or et protection contre la malchance (Pity System).
]]

local CardsDatabase = require(script.Parent.CardsDatabase)

export type PackDefinition = {
    Id: string,
    Name: string,
    CostCoins: number,
    Description: string,
    Weights: { [CardsDatabase.CardRarity]: number },
    DisplayOdds: string, -- Texte affiché au joueur pour la conformité Roblox
    GuaranteedRarity: CardsDatabase.CardRarity?,
}

local Packs: { [string]: PackDefinition } = {
    starter_pack = {
        Id = "starter_pack",
        Name = "Pack Débutant",
        CostCoins = 100,
        Description = "Pack idéal pour débuter votre collection d'aptitudes martiales.",
        Weights = {
            Common = 600,      -- 60.0%
            Rare = 250,        -- 25.0%
            Epic = 110,        -- 11.0%
            Legendary = 40,    -- 4.0%
        },
        DisplayOdds = "Commun: 60% | Rare: 25% | Épique: 11% | Légendaire: 4%",
    },
    chaos_pack = {
        Id = "chaos_pack",
        Name = "Pack Chaos",
        CostCoins = 500,
        Description = "Contient des compétences imprégnées de pure énergie de discorde.",
        Weights = {
            Common = 300,      -- 30.0%
            Rare = 420,        -- 42.0%
            Epic = 200,        -- 20.0%
            Legendary = 80,    -- 8.0%
        },
        DisplayOdds = "Commun: 30% | Rare: 42% | Épique: 20% | Légendaire: 8%",
    },
    sovereign_pack = {
        Id = "sovereign_pack",
        Name = "Pack du Souverain",
        CostCoins = 1500,
        Description = "Pack d'élite sans aucune carte commune. 1 Légendaire toutes les 5 ouvertures !",
        Weights = {
            Common = 0,        -- 0.0%
            Rare = 350,        -- 35.0%
            Epic = 450,        -- 45.0%
            Legendary = 200,   -- 20.0%
        },
        DisplayOdds = "Rare: 35% | Épique: 45% | Légendaire: 20% (0% Commun)",
    },
}

local PityRules = {
    MaxPacksWithoutLegendary = 50, -- 1 Légendaire garanti au 50ème tirage
    MaxPacksWithoutEpic = 10,      -- 1 Épique garanti tous les 10 tirages
}

return {
    Packs = Packs,
    Pity = PityRules,
    GetPack = function(packId: string): PackDefinition?
        return Packs[packId]
    end,
}
]]></string>
        </Properties>
