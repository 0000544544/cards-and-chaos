  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="18">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - INITIALISATION CLIENT
    Point d'entrée côté joueur : initialise le contrôleur de sorts (touches QWERTY/AZERTY & clic souris),
    l'interface graphique complète et les autels interactifs (touche E).
]]

local Players = game:GetService("Players")

local UIManager = require(script.ui.UIManager)
local CombatController = require(script.CombatController)
local InteractionController = require(script.InteractionController)

print("========================================================")
print("  CARDS & CHAOS - LANCEMENT DU CLIENT")
print("========================================================")

-- 1. Initialisation des contrôles de combat (Sorts 1-5, visée souris, AZERTY A/Z/E/R/F)
CombatController.Init()

-- 2. Initialisation de l'interface graphique (Hotbar, TopBar, et 5 fenêtres interactives)
UIManager.Init()

-- 3. Initialisation des interactions physiques avec les autels (touche E)
InteractionController.Init(function(tabName: string)
    UIManager.OpenTab(tabName)
end)

print("[Client] Prêt ! Lancez vos sorts avec 1-4 ou A/Z/E/R (ou clic souris sur la Hotbar).")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - CONTRÔLEUR DE COMBAT & ENTRÉES SORTS (CLIENT)
    Visée à la souris, support clavier universel (QWERTY + AZERTY A/Z/E/R/F + Pavé Numérique),
    et support clic direct sur les boutons de la barre de sorts (Hotbar).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkEvents = require(ReplicatedStorage.Shared.NetworkEvents)

local player = Players.LocalPlayer
local mouse = player:GetMouse()

local CombatController = {}

function CombatController.TriggerSpell(slotIndex: number)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return end

    local targetPos = mouse.Hit and mouse.Hit.Position or (root.Position + root.CFrame.LookVector * 30)
    local castRE = NetworkEvents.GetEvent("CastSpell")
    castRE:FireServer(slotIndex, targetPos)
end

function CombatController.Init()
    -- Écouteur des entrées clavier
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end

        local kc = input.KeyCode

        -- SLOT 1 : Météore Solaire
        if kc == Enum.KeyCode.One or kc == Enum.KeyCode.KeypadOne or kc == Enum.KeyCode.A then
            CombatController.TriggerSpell(1)

        -- SLOT 2 : Nova du Néant
        elseif kc == Enum.KeyCode.Two or kc == Enum.KeyCode.KeypadTwo or kc == Enum.KeyCode.Z or kc == Enum.KeyCode.W then
            CombatController.TriggerSpell(2)

        -- SLOT 3 : Pas Éclair
        elseif kc == Enum.KeyCode.Three or kc == Enum.KeyCode.KeypadThree or kc == Enum.KeyCode.E then
            CombatController.TriggerSpell(3)

        -- SLOT 4 : Égide du Souverain
        elseif kc == Enum.KeyCode.Four or kc == Enum.KeyCode.KeypadFour or kc == Enum.KeyCode.R then
            CombatController.TriggerSpell(4)

        -- SLOT 5 : Dash Éclair (I-Frame)
        elseif kc == Enum.KeyCode.Five or kc == Enum.KeyCode.KeypadFive or kc == Enum.KeyCode.Q or kc == Enum.KeyCode.F or kc == Enum.KeyCode.Space then
            CombatController.TriggerSpell(5)
        end
    end)

    print("[CombatController] Contrôles QWERTY / AZERTY / Clic Souris activés.")
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">InteractionController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - DÉTECTION DES INTERACTIONS PHYSIQUES (PROXIMITY PROMPT)
    Ouvre automatiquement le bon onglet (Gacha, Market, Arena, Merit, NPC_Eldrin)
    quand le joueur s'approche d'un autel ou du PNJ et appuie sur E.
]]

local ProximityPromptService = game:GetService("ProximityPromptService")

local InteractionController = {}

function InteractionController.Init(openTabCallback: (tabName: string) -> ())
    ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
        local parent = prompt.Parent
        if parent then
            local targetUI = parent:GetAttribute("TargetUI")
            if not targetUI and parent.Parent then
                targetUI = parent.Parent:GetAttribute("TargetUI")
            end
            if targetUI and type(targetUI) == "string" then
                openTabCallback(targetUI)
            end
        end
    end)
    print("[InteractionController] Autels et PNJ interactifs (E) branchés.")
end

return InteractionController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">PackOpeningController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - ANIMATION D'OUVERTURE DE PACK (CLIENT)
    Animation cinématographique de révélation de carte : carte qui flotte, tourne,
    irradie de particules d'aura, se retourne (Card Flip) et explose aux couleurs de sa rareté.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local CardsDatabase = require(game.ReplicatedStorage.Shared.CardsDatabase)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

local PackOpeningController = {}

local RarityColors: { [CardsDatabase.CardRarity]: Color3 } = {
    Common = Color3.fromRGB(180, 190, 205),
    Rare = Color3.fromRGB(56, 189, 248),
    Epic = Color3.fromRGB(168, 85, 247),
    Legendary = Color3.fromRGB(245, 158, 11),
}

-- Création de l'interface d'animation de tirage
function PackOpeningController.PlayRevealAnimation(cardInstance: any, onComplete: (() -> ())?)
    local screenGui = playerGui:FindFirstChild("PackRevealGui") :: ScreenGui?
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "PackRevealGui"
        screenGui.ResetOnSpawn = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.Parent = playerGui
    end
    screenGui:ClearAllChildren()

    local rarity = (cardInstance.Rarity or "Common") :: CardsDatabase.CardRarity
    local glowColor = RarityColors[rarity] or Color3.fromRGB(255, 255, 255)

    -- Fond assombri avec flou cinématique
    local backdrop = Instance.new("Frame")
    backdrop.Size = UDim2.new(1, 0, 1, 0)
    backdrop.BackgroundColor3 = Color3.fromRGB(5, 7, 12)
    backdrop.BackgroundTransparency = 1
    backdrop.Parent = screenGui

    local fadeBackdrop = TweenService:Create(backdrop, TweenInfo.new(0.35), { BackgroundTransparency = 0.25 })
    fadeBackdrop:Play()

    -- Conteneur central de la carte
    local cardHolder = Instance.new("Frame")
    cardHolder.Size = UDim2.new(0, 240, 0, 360)
    cardHolder.Position = UDim2.new(0.5, -120, 0.5, -180)
    cardHolder.BackgroundTransparency = 1
    cardHolder.Parent = backdrop

    -- Dos de la carte (Initialement visible)
    local cardBack = Instance.new("Frame")
    cardBack.Size = UDim2.new(1, 0, 1, 0)
    cardBack.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
    cardBack.Parent = cardHolder

    local corner1 = Instance.new("UICorner")
    corner1.CornerRadius = UDim.new(0, 12)
    corner1.Parent = cardBack

    local stroke1 = Instance.new("UIStroke")
    stroke1.Color = Color3.fromRGB(99, 102, 241)
    stroke1.Thickness = 3
    stroke1.Parent = cardBack

    local backLogo = Instance.new("TextLabel")
    backLogo.Size = UDim2.new(1, 0, 1, 0)
    backLogo.BackgroundTransparency = 1
    backLogo.Font = Enum.Font.GothamBold
    backLogo.TextSize = 24
    backLogo.TextColor3 = Color3.fromRGB(168, 85, 247)
    backLogo.Text = "CARDS\n&\nCHAOS"
    backLogo.Parent = cardBack

    -- Face avant de la carte (Révélée après le retournement)
    local cardFront = Instance.new("Frame")
    cardFront.Size = UDim2.new(1, 0, 1, 0)
    cardFront.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
    cardFront.Visible = false
    cardFront.Parent = cardHolder

    local corner2 = Instance.new("UICorner")
    corner2.CornerRadius = UDim.new(0, 12)
    corner2.Parent = cardFront

    local stroke2 = Instance.new("UIStroke")
    stroke2.Color = glowColor
    stroke2.Thickness = (rarity == "Legendary") and 4 or 2.5
    stroke2.Parent = cardFront

    -- Rendu de l'illustration (Decal ComfyUI)
    local cardImage = Instance.new("ImageLabel")
    cardImage.Size = UDim2.new(1, -20, 0, 170)
    cardImage.Position = UDim2.new(0, 10, 0, 10)
    cardImage.BackgroundColor3 = Color3.fromRGB(30, 41, 59)
    cardImage.Image = cardInstance.AssetId or "rbxassetid://13880479100"
    cardImage.ScaleType = Enum.ScaleType.Fit
    cardImage.Parent = cardFront

    local imgCorner = Instance.new("UICorner")
    imgCorner.CornerRadius = UDim.new(0, 8)
    imgCorner.Parent = cardImage

    -- Nom & Rareté
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -20, 0, 30)
    nameLabel.Position = UDim2.new(0, 10, 0, 190)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 16
    nameLabel.TextColor3 = glowColor
    nameLabel.Text = cardInstance.Name
    nameLabel.Parent = cardFront

    local typeLabel = Instance.new("TextLabel")
    typeLabel.Size = UDim2.new(1, -20, 0, 20)
    typeLabel.Position = UDim2.new(0, 10, 0, 220)
    typeLabel.BackgroundTransparency = 1
    typeLabel.Font = Enum.Font.Gotham
    typeLabel.TextSize = 12
    typeLabel.TextColor3 = Color3.fromRGB(148, 163, 184)
    typeLabel.Text = string.upper(tostring(cardInstance.Type or "Aptitude")) .. " • " .. string.upper(tostring(rarity))
    typeLabel.Parent = cardFront

    -- Statistique de Puissance (BasePower)
    local powerLabel = Instance.new("TextLabel")
    powerLabel.Size = UDim2.new(1, -20, 0, 40)
    powerLabel.Position = UDim2.new(0, 10, 0, 250)
    powerLabel.BackgroundTransparency = 1
    powerLabel.Font = Enum.Font.GothamBold
    powerLabel.TextSize = 22
    powerLabel.TextColor3 = Color3.fromRGB(248, 250, 252)
    powerLabel.Text = "⚡ PUISSANCE : " .. tostring(cardInstance.BasePower or 50)
    powerLabel.Parent = cardFront

    -- Bouton de confirmation
    local collectBtn = Instance.new("TextButton")
    collectBtn.Size = UDim2.new(1, -40, 0, 40)
    collectBtn.Position = UDim2.new(0, 20, 1, -55)
    collectBtn.BackgroundColor3 = glowColor
    collectBtn.TextColor3 = Color3.fromRGB(15, 23, 42)
    collectBtn.Font = Enum.Font.GothamBold
    collectBtn.TextSize = 14
    collectBtn.Text = "RÉCUPÉRER LA CARTE"
    collectBtn.Parent = cardFront

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = collectBtn

    -- =========================================================================
    -- SÉQUENCE CINÉMATIQUE (TWEENING)
    -- =========================================================================
    cardHolder.Position = UDim2.new(0.5, -120, 0.7, -180)
    cardHolder.Size = UDim2.new(0, 80, 0, 120)

    -- Phase 1 : Montée et flottement
    local riseTween = TweenService:Create(cardHolder, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -120, 0.5, -180),
        Size = UDim2.new(0, 240, 0, 360),
    })
    riseTween:Play()
    riseTween.Completed:Wait()

    -- Phase 2 : Retournement 3D (Simulation Flip horizontal)
    local flipHalf1 = TweenService:Create(cardHolder, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 360),
    })
    flipHalf1:Play()
    flipHalf1.Completed:Wait()

    cardBack.Visible = false
    cardFront.Visible = true

    local flipHalf2 = TweenService:Create(cardHolder, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 240, 0, 360),
    })
    flipHalf2:Play()

    -- Phase 3 : Fermeture
    collectBtn.MouseButton1Click:Connect(function()
        local closeTween = TweenService:Create(backdrop, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            screenGui:Destroy()
            if onComplete then onComplete() end
        end)
    end)
end

return PackOpeningController
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="22">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">UIManager</string>
              <string name="Source"><![CDATA[--!strict
--[[
    CARDS & CHAOS - INTERFACE UTILISATEUR COMPLÈTE (CLIENT)
    Mappage strict des 5 onglets (CODEX, INVOCATION, MARCHÉ, ARÈNE, MÉRITE),
    Hotbar des sorts 1-5 cliquables à la souris et tous les menus interactifs remplis.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardsDatabase = require(ReplicatedStorage.Shared.CardsDatabase)
local NetworkEvents = require(ReplicatedStorage.Shared.NetworkEvents)
local PackOpeningController = require(script.Parent.Parent.PackOpeningController)
local CombatController = require(script.Parent.Parent.CombatController)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

local UIManager = {}

local CachedProfile: any = nil
local CurrentTab: string? = nil

-- Éléments UI principaux
local ScreenGui: ScreenGui
local TopBar: Frame
local NavBar: Frame
local ModalContainer: Frame
local ModalTitle: TextLabel
local ModalBody: Frame
local HotbarFrame: Frame
local ToastContainer: Frame

local function CreateUI(className: string, props: { [string]: any }): any
    local inst = Instance.new(className)
    for k, v in pairs(props) do
        (inst :: any)[k] = v
    end
    return inst
end

local function ApplyCorner(instance: Instance, radius: number?)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = instance
end

local function ApplyStroke(instance: Instance, color: Color3, thickness: number?)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness or 1.5
    s.Parent = instance
end

-- =============================================================================
-- TOAST NOTIFICATIONS & ALERTES
-- =============================================================================
function UIManager.ShowToast(message: string, isError: boolean?)
    local toast = CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = isError and Color3.fromRGB(185, 28, 28) or Color3.fromRGB(30, 41, 59),
        TextColor3 = Color3.fromRGB(248, 250, 252),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        Text = message,
        TextTransparency = 1,
        Parent = ToastContainer,
    })
    ApplyCorner(toast, 6)
    ApplyStroke(toast, isError and Color3.fromRGB(239, 68, 68) or Color3.fromRGB(71, 85, 105), 1)

    TweenService:Create(toast, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
    task.delay(3.5, function()
        local out = TweenService:Create(toast, TweenInfo.new(0.3), { TextTransparency = 1 })
        out:Play()
        out.Completed:Connect(function() toast:Destroy() end)
    end)
end

-- =============================================================================
-- RAFRAÎCHISSEMENT DU HUD & DE LA BARRE DE SORTS (HOTBAR)
-- =============================================================================
function UIManager.RefreshHUD()
    if not CachedProfile then return end

    local coinsLabel = TopBar:FindFirstChild("CoinsLabel") :: TextLabel?
    if coinsLabel then
        coinsLabel.Text = "🪙 " .. tostring(CachedProfile.Coins) .. " Or"
    end

    local meritLabel = TopBar:FindFirstChild("MeritLabel") :: TextLabel?
    if meritLabel then
        meritLabel.Text = "⚡ " .. tostring(CachedProfile.Merit) .. " Mérite (" .. tostring(CachedProfile.Rank) .. ")"
    end

    -- Mise à jour de la Hotbar (Slots 1 à 4 + Slot 5 Dash)
    local slotHotkeys = { "1 [A]", "2 [Z]", "3 [E]", "4 [R]", "5 [Dash]" }
    for i = 1, 4 do
        local cardId = CachedProfile.EquippedDeck[i] or CardsDatabase.StarterDeck[i]
        local cardDef = CardsDatabase.GetCard(cardId)
        local slotBtn = HotbarFrame:FindFirstChild("Slot_" .. i) :: TextButton?
        if slotBtn and cardDef then
            slotBtn.Text = slotHotkeys[i] .. "\n" .. cardDef.Name
            slotBtn.TextColor3 = cardDef.Color
            local stroke = slotBtn:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = cardDef.Color end
        end
    end
end

function UIManager.FetchData()
    local getProfRF = NetworkEvents.GetFunction("GetPlayerData")
    CachedProfile = getProfRF:InvokeServer()
    UIManager.RefreshHUD()
end

-- =============================================================================
-- LES 5 ONGLETS COMPLETS (PLUS AUCUN MENU VIDE !)
-- =============================================================================

-- 1. FENÊTRE CODEX & DECK (Affiche les cartes possédées et permet d'équiper)
local function RenderCodexTab()
    ModalBody:ClearAllChildren()

    local desc = CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Text = "Cliquez sur 'Équiper' pour assigner une carte à l'un de vos 4 slots de combat :",
        TextColor3 = Color3.fromRGB(203, 213, 225),
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = ModalBody,
    })

    local scroll = CreateUI("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -40),
        Position = UDim2.new(0, 0, 0, 35),
        BackgroundTransparency = 1,
        ScrollBarThickness = 6,
        CanvasSize = UDim2.new(0, 0, 0, math.ceil(#CachedProfile.Inventory / 3) * 110),
        Parent = ModalBody,
    })

    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0.31, 0, 0, 100)
    grid.CellPadding = UDim2.new(0.02, 0, 0, 10)
    grid.Parent = scroll

    for _, c in ipairs(CachedProfile.Inventory) do
        local def = CardsDatabase.GetCard(c.CardId)
        if def then
            local cardCard = CreateUI("Frame", {
                BackgroundColor3 = Color3.fromRGB(30, 41, 59),
                Parent = scroll,
            })
            ApplyCorner(cardCard, 8)
            ApplyStroke(cardCard, def.Color, 2)

            CreateUI("TextLabel", {
                Size = UDim2.new(1, -10, 0, 24),
                Position = UDim2.new(0, 5, 0, 5),
                BackgroundTransparency = 1,
                Text = def.Name,
                TextColor3 = def.Color,
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                Parent = cardCard,
            })

            CreateUI("TextLabel", {
                Size = UDim2.new(1, -10, 0, 35),
                Position = UDim2.new(0, 5, 0, 28),
                BackgroundTransparency = 1,
                Text = def.SpellType .. " | Pwr: " .. def.BasePower .. " | CD: " .. def.Cooldown .. "s",
                TextColor3 = Color3.fromRGB(148, 163, 184),
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextWrapped = true,
                Parent = cardCard,
            })

            local equipBtn = CreateUI("TextButton", {
                Size = UDim2.new(1, -16, 0, 28),
                Position = UDim2.new(0, 8, 1, -34),
                BackgroundColor3 = Color3.fromRGB(79, 70, 229),
                TextColor3 = Color3.fromRGB(255, 255, 255),
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                Text = "Équiper (Slot 1)",
                Parent = cardCard,
            })
            ApplyCorner(equipBtn, 6)

            equipBtn.MouseButton1Click:Connect(function()
                local equipRF = NetworkEvents.GetFunction("EquipCard")
                local res = equipRF:InvokeServer(def.Id, 1)
                if res.Success then
                    CachedProfile = res.Profile
                    UIManager.RefreshHUD()
                    UIManager.ShowToast("✨ " .. def.Name .. " équipé en Slot 1 !")
                end
            end)
        end
    end
end

-- 2. FENÊTRE INVOCATION / GACHA (Packs Souverain et Chaos avec taux transparents)
local function RenderGachaTab()
    ModalBody:ClearAllChildren()

    local infoBanner = CreateUI("Frame", {
        Size = UDim2.new(1, 0, 0, 55),
        BackgroundColor3 = Color3.fromRGB(24, 24, 38),
        Parent = ModalBody,
    })
    ApplyCorner(infoBanner, 8)
    ApplyStroke(infoBanner, Color3.fromRGB(168, 85, 247), 1.5)

    CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 0, 26),
        Position = UDim2.new(0, 0, 0, 4),
        BackgroundTransparency = 1,
        Text = "⚡ AUTEL DU DESTIN : INVOCATIONS DE SORTS ⚡",
        TextColor3 = Color3.fromRGB(250, 204, 21),
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        Parent = infoBanner,
    })

    CreateUI("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0, 28),
        BackgroundTransparency = 1,
        Text = "Taux garantis Roblox : Commun: 60% | Rare: 25% | Épique: 11% | Légendaire: 4%",
        TextColor3 = Color3.fromRGB(203, 213, 225),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        Parent = infoBanner,
    })

    local packs = {
        {
            Id = "pack_souverain",
            Name = "Pack Souverain",
            Cost = 250,
            Desc = "Pack standard de l'Ordre Souverain.\nProbabilités équilibrées pour agrandir votre grimoire.",
            Color = Color3.fromRGB(79, 70, 229),
        },
        {
            Id = "pack_chaos",
            Name = "Pack Chaos Mythique",
            Cost = 1000,
            Desc = "Pack d'élite imprégné de flammes primordiales.\nChances accrues d'Épique (25%) et de Légendaire (10%) !",
            Color = Color3.fromRGB(217, 70, 239),
        },
    }

    local function TriggerPackOpen(packId: string)
        local rf = NetworkEvents.GetFunction("RequestOpenPack")
        local res = rf:InvokeServer(packId)
        if res.Success and res.Card then
            UIManager.CloseModal()
            PackOpeningController.PlayRevealAnimation(res.Card, function()
                UIManager.FetchData()
                UIManager.ShowToast("🌟 Vous avez obtenu : " .. res.Card.Name .. " (" .. res.Card.Rarity .. ") !")
            end)
        else
            UIManager.ShowToast(res.Error or "Or insuffisant pour ouvrir ce pack.", true)
        end
    end

    for pIdx, p in ipairs(packs) do
        local pFrame = CreateUI("Frame", {
            Size = UDim2.new(0.48, 0, 0, 220),
            Position = UDim2.new((pIdx - 1) * 0.52, 0, 0, 75),
            BackgroundColor3 = Color3.fromRGB(30, 41, 59),
            Parent = ModalBody,
        })
        ApplyCorner(pFrame, 10)
        ApplyStroke(pFrame, p.Color, 2)

        CreateUI("TextLabel", {
            Size = UDim2.new(1, -20, 0, 32),
            Position = UDim2.new(0, 10, 0, 10),
            BackgroundTransparency = 1,
            Text = p.Name,
            TextColor3 = p.Color,
            Font = Enum.Font.GothamBold,
            TextSize = 16,
            Parent = pFrame,
        })

        CreateUI("TextLabel", {
            Size = UDim2.new(1, -20, 0, 75),
            Position = UDim2.new(0, 10, 0, 45),
            BackgroundTransparency = 1,
            Text = p.Desc,
            TextColor3 = Color3.fromRGB(203, 213, 225),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextWrapped = true,
            Parent = pFrame,
        })

        local openBtn = CreateUI("TextButton", {
            Size = UDim2.new(1, -30, 0, 44),
            Position = UDim2.new(0, 15, 1, -55),
            BackgroundColor3 = p.Color,
            TextColor3 = Color3.fromRGB(15, 23, 42),
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            Text = "INVOQUER x1 (" .. p.Cost .. " Or)",
            Parent = pFrame,
        })
        ApplyCorner(openBtn, 8)
        openBtn.MouseButton1Click:Connect(function()
            TriggerPackOpen(p.Id)
        end)
    end
end

-- 3. FENÊTRE MARCHÉ / HÔTEL DES VENTES (Offres du Marché Noir + Vente de cartes)
local function RenderMarketTab()
    ModalBody:ClearAllChildren()

    local header = CreateUI("Frame", {
        Size = UDim2.new(1, 0, 0, 45),
        BackgroundColor3 = Color3.fromRGB(24, 24, 38),
        Parent = ModalBody,
    })
    ApplyCorner(header, 8)

    CreateUI("TextLabel", {
        Size = UDim2.new(0.65, 0, 1, 0),
        Position = UDim2.new(0, 15, 0, 0),
        BackgroundTransparency = 1,
        Text = "HÔTEL DES VENTES & MARCHÉ NOIR (Taxe 5%)",
        TextColor3 = Color3.fromRGB(16, 185, 129),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })

    local sellBtn = CreateUI("TextButton", {
        Size = UDim2.new(0.3, 0, 0, 32),
        Position = UDim2.new(0.68, 0, 0, 6),
        BackgroundColor3 = Color3.fromRGB(16, 185, 129),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Text = "+ Vendre ma 1ère Carte (300 Or)",
        Parent = header,
    })
    ApplyCorner(sellBtn, 6)

    sellBtn.MouseButton1Click:Connect(function()
        if CachedProfile and #CachedProfile.Inventory > 0 then
            local card = CachedProfile.Inventory[#CachedProfile.Inventory]
            local listRF = NetworkEvents.GetFunction("ListMarketItem")
            local res = listRF:InvokeServer(card.CardId, 300)
            if res.Success then
                UIManager.ShowToast("Carte mise en vente pour 300 Or !")
                UIManager.FetchData()
                RenderMarketTab()
            else
                UIManager.ShowToast(res.Error or "Erreur de mise en vente", true)
            end
        else
            UIManager.ShowToast("Aucune carte disponible à vendre.", true)
        end
    end)

    local scroll = CreateUI("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -55),
        Position = UDim2.new(0, 0, 0, 52),
        BackgroundTransparency = 1,
        ScrollBarThickness = 6,
        CanvasSize = UDim2.new(0, 0, 0, 250),
        Parent = ModalBody,
    })

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = scroll

    local getListingsRF = NetworkEvents.GetFunction("GetMarketListings")
    local listings = getListingsRF:InvokeServer() or {}

    for _, l in ipairs(listings) do
        local def = CardsDatabase.GetCard(l.CardId)
        local row = CreateUI("Frame", {
            Size = UDim2.new(1, -10, 0, 48),
            BackgroundColor3 = Color3.fromRGB(30, 41, 59),
            Parent = scroll,
        })
        ApplyCorner(row, 6)
        ApplyStroke(row, def and def.Color or Color3.fromRGB(71, 85, 105), 1)

        CreateUI("TextLabel", {
            Size = UDim2.new(0.4, 0, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Text = l.CardName .. " (" .. l.Rarity .. ")",
            TextColor3 = def and def.Color or Color3.fromRGB(248, 250, 252),
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = row,
        })

        CreateUI("TextLabel", {
            Size = UDim2.new(0.3, 0, 1, 0),
            Position = UDim2.new(0.42, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = "Vendeur : " .. l.SellerName,
            TextColor3 = Color3.fromRGB(148, 163, 184),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            Parent = row,
        })

        local buyBtn = CreateUI("TextButton", {
            Size = UDim2.new(0.24, 0, 0, 32),
            Position = UDim2.new(0.74, 0, 0, 8),
            BackgroundColor3 = Color3.fromRGB(5, 150, 105),
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            Text = "ACHETER (" .. l.Price .. " Or)",
            Parent = row,
        })
        ApplyCorner(buyBtn, 6)

        buyBtn.MouseButton1Click:Connect(function()
            local buyRF = NetworkEvents.GetFunction("BuyMarketItem")
            local res = buyRF:InvokeServer(l.ListingId)
            if res.Success then
                UIManager.ShowToast("Achat réussi de " .. l.CardName .. " !")
                UIManager.FetchData()
                RenderMarketTab()
            else
                UIManager.ShowToast(res.Error or "Échec de l'achat", true)
            end
        end)
    end
end

-- 4. FENÊTRE ARÈNE COMPÉTITIVE 1V1 (Duel contre Bot Duelliste ou Joueur)
local function RenderArenaTab()
    ModalBody:ClearAllChildren()

    local arenaCard = CreateUI("Frame", {
        Size = UDim2.new(1, 0, 0, 240),
        BackgroundColor3 = Color3.fromRGB(24, 24, 38),
