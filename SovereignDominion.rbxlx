}

-- Ordre hiérarchique pour le tri
local RarityOrder: { [string]: number } = {
    Common = 1,
    Rare = 2,
    Epic = 3,
    Legendary = 4,
    Mythic = 5,
    Divine = 6,
}

-- Pity Rules (Protection contre la malchance)
local PityRules = {
