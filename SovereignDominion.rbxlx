        BaseSellPrice = 200,
        RecycleDust = 60,
        BroadcastRoll = false,
        GlowIntensity = 0.6,
    },
    Legendary = {
        Id = "Legendary",
        Name = "LÉGENDAIRE",
        Weight = 400,
        DropRatePercent = 4.0,
        Color = Color3.fromRGB(245, 158, 11),
        SecondaryColor = Color3.fromRGB(180, 83, 9),
        StatMultiplier = 2.6,
        BaseSellPrice = 600,
        RecycleDust = 200,
        BroadcastRoll = true,
        GlowIntensity = 0.9,
    },
    Mythic = {
        Id = "Mythic",
        Name = "MYTHIQUE",
        Weight = 90,
        DropRatePercent = 0.9,
        Color = Color3.fromRGB(239, 68, 68),
        SecondaryColor = Color3.fromRGB(153, 27, 27),
        StatMultiplier = 3.8,
